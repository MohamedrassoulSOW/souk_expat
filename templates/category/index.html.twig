{% extends 'admin/base_admin.html.twig' %}

{% block title %}Catégories | SoukExpat{% endblock %}
{% block admin_mobile_title %}Catégories{% endblock %}

{% block admin_main %}
    {% set actions %}
        <a href="{{ path('app_category_new') }}" class="btn btn-admin-primary rounded-pill px-3">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouvelle catégorie
        </a>
    {% endset %}

    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Référentiels',
        title: 'Catégories',
        lead: 'Types de produits et services affichés sur la plateforme.',
        actions: actions
    }) }}

    <div class="admin-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-3 border-bottom">
            <div class="admin-table-search flex-grow-1" style="max-width: 22rem;">
                <label class="visually-hidden" for="admin-cat-search">Rechercher une catégorie</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted" aria-hidden="true"></i></span>
                    <input id="admin-cat-search"
                           type="search"
                           class="form-control border-start-0 js-admin-table-search"
                           placeholder="Rechercher une catégorie…"
                           data-table-target="#admin-categories-table"
                           data-empty-target="#admin-categories-empty"
                           data-count-target="#admin-categories-count"
                           autocomplete="off">
                </div>
            </div>
            <span class="admin-badge"><span id="admin-categories-count">{{ categories|length|cap999 }}</span> catégorie{{ categories|length > 1 ? 's' : '' }}</span>
        </div>
        <div class="table-responsive">
            <table id="admin-categories-table" class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3 border-0">ID</th>
                        <th class="py-3 border-0">Image</th>
                        <th class="py-3 border-0 d-none d-md-table-cell">Icône</th>
                        <th class="py-3 border-0">Nom</th>
                        <th class="py-3 border-0 d-none d-lg-table-cell">Slug</th>
                        <th class="pe-3 py-3 border-0 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr data-search="{{ (category.name ~ ' ' ~ category.slug ~ ' ' ~ category.id)|lower }}">
                            <td class="ps-3"><span class="text-muted font-monospace small">#{{ category.id }}</span></td>
                            <td>
                                {% if category.imageName %}
                                    <img src="{{ asset('uploads/categories/' ~ category.imageName) }}" alt="" width="44" height="44" class="rounded-3 border bg-white" style="object-fit: cover;">
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>
                            <td class="d-none d-md-table-cell">
                                {% if category.icon %}
                                    <i class="bi {{ category.icon }} fs-5" style="color: var(--cyan-main);" aria-hidden="true"></i>
                                {% else %}
                                    <span class="text-muted small">—</span>
                                {% endif %}
                            </td>
                            <td class="fw-semibold">{{ category.name }}</td>
                            <td class="d-none d-lg-table-cell">
                                <code class="small bg-light border px-2 py-1 rounded">{{ category.slug }}</code>
                            </td>
                            <td class="pe-3 text-end">
                                <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                    <a href="{{ path('app_category_update', {id: category.id}) }}" class="btn btn-sm btn-light border btn-icon-action" title="Modifier" aria-label="Modifier">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_category_delete', {id: category.id}) }}" class="d-inline"
                                          onsubmit="return confirm('Supprimer cette catégorie ? Les annonces liées peuvent être affectées.');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger btn-icon-action" title="Supprimer" aria-label="Supprimer">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">Aucune catégorie configurée.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div id="admin-categories-empty" class="text-center text-muted py-4 d-none">Aucune catégorie ne correspond à la recherche.</div>
        </div>
    </div>
{% endblock %}
