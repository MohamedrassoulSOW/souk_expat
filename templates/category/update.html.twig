{% extends 'base.html.twig' %}

{% block title %}Modifier la catégorie | Expat Souk{% endblock %}

{% block body %}
<div class="container-fluid p-0">
    <div class="row g-0">

        <main class="col-12 col-md-9 col-lg-10 p-4 bg-light min-vh-100">
            
            {# Header avec fil d'ariane #}
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1">
                            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item"><a href="{{ path('app_category') }}" class="text-decoration-none">Catégories</a></li>
                            <li class="breadcrumb-item active">Modifier</li>
                        </ol>
                    </nav>
                    <h3 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-pencil-square me-2" style="color: #42B1CE;"></i>Modifier : {{ category.name }}
                    </h3>
                </div>
                <a href="{{ path('app_category') }}" class="btn btn-outline-secondary rounded-pill px-3 bg-white shadow-sm">
                    <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                </a>
            </div>

            <div class="row justify-content-center">
                <div class="col-12 col-xl-7">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom p-4">
                            <h5 class="fw-bold mb-0">Édition des détails</h5>
                        </div>
                        
                        <div class="card-body p-4">
                            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                                <div class="mb-4">
                                    {{ form_label(form.name, 'Nom de la catégorie', {'label_attr': {'class': 'form-label fw-bold text-dark small text-uppercase'}}) }}
                                    {{ form_widget(form.name, {
                                        'attr': {
                                            'class': 'form-control form-control-lg custom-input',
                                        }
                                    }) }}
                                    <div class="text-danger small mt-2">
                                        {{ form_errors(form.name) }}
                                    </div>
                                </div>

                                {% if category.imageName %}
                                    <div class="mb-3 p-3 bg-light rounded-4 border d-flex align-items-center gap-3">
                                        <img src="{{ asset('uploads/categories/' ~ category.imageName) }}" alt="" width="72" height="72" class="rounded-3 object-fit-cover flex-shrink-0 border bg-white" style="object-fit: cover;">
                                        <span class="text-muted small">Image actuelle. Choisissez un nouveau fichier pour la remplacer.</span>
                                    </div>
                                {% endif %}

                                <div class="mb-4">
                                    {{ form_label(form.imageFile, category.imageName ? 'Nouvelle image' : 'Image (reconnaissance visuelle)', {'label_attr': {'class': 'form-label fw-bold text-dark small text-uppercase'}}) }}
                                    {{ form_widget(form.imageFile) }}
                                    <div class="form-text small">{{ form_help(form.imageFile) }}</div>
                                    <div class="text-danger small mt-2">{{ form_errors(form.imageFile) }}</div>
                                </div>

                                <div class="d-grid mt-4">
                                    <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold shadow-sm" style="background-color: #42B1CE; border: none;">
                                        <i class="bi bi-arrow-repeat me-2"></i>Mettre à jour la catégorie
                                    </button>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>

                    {# Note informative sur les conséquences #}
                    <div class="mt-4 p-3 bg-white border rounded-4 shadow-sm">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-info-circle-fill text-info me-3 mt-1"></i>
                            <p class="text-muted small mb-0">
                                <strong>Note :</strong> Modifier le nom d'une catégorie peut changer son <strong>URL (slug)</strong>. 
                                Assurez-vous que les annonces existantes restent accessibles ou prévoyez des redirections si nécessaire.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
    .breadcrumb-item a { color: #42B1CE; }
    
    .custom-input {
        border: 2px solid #f0f2f5 !important;
        border-radius: 12px !important;
        transition: all 0.3s ease !important;
    }

    .custom-input:focus {
        border-color: #42B1CE !important;
        background-color: #fff !important;
        box-shadow: 0 0 0 4px rgba(66, 177, 206, 0.1) !important;
    }

    .btn-primary:hover {
        background-color: #369db7 !important;
        transform: translateY(-2px);
    }
</style>
{% endblock %}