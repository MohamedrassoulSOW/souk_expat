{% extends 'base.html.twig' %}

{% block title %}Nouvelle Catégorie | Expat Souk{% endblock %}

{% block body %}
<div class="container-fluid p-0">
    <div class="row g-0">

        <main class="col-12 col-md-9 col-lg-10 p-4 bg-light min-vh-100">
            
            {# Header avec Fil d'Ariane #}
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-1">
                            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}" class="text-decoration-none">Dashboard</a></li>
                            <li class="breadcrumb-item"><a href="{{ path('app_category') }}" class="text-decoration-none">Catégories</a></li>
                            <li class="breadcrumb-item active">Nouvelle</li>
                        </ol>
                    </nav>
                    <h3 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-folder-plus me-2" style="color: #42B1CE;"></i>Créer une catégorie
                    </h3>
                </div>
                <a href="{{ path('app_category') }}" class="btn btn-outline-secondary rounded-pill px-3 bg-white shadow-sm">
                    <i class="bi bi-arrow-left me-2"></i>Retour à la liste
                </a>
            </div>

            <div class="row justify-content-center">
                <div class="col-12 col-xl-7">
                    {{ include('layouts/flush_message.html.twig') }}

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom p-4">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle p-3 me-3" style="background-color: #42B1CE15;">
                                    <i class="bi bi-tags fs-4" style="color: #42B1CE;"></i>
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0">Informations essentielles</h5>
                                    <p class="text-muted small mb-0">Définissez le nom de la catégorie qui apparaîtra sur le site.</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card-body p-4">
                            {{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
                                <div class="mb-4">
                                    {{ form_label(form.name, 'Nom de la catégorie', {'label_attr': {'class': 'form-label fw-bold text-dark small text-uppercase'}}) }}
                                    {{ form_widget(form.name, {
                                        'attr': {
                                            'class': 'form-control form-control-lg custom-input',
                                            'placeholder': 'Ex: Immobilier, Emploi, Services...'
                                        }
                                    }) }}
                                    <div class="text-danger small mt-2">
                                        {{ form_errors(form.name) }}
                                    </div>
                                    <div class="form-text mt-2 small">
                                        <i class="bi bi-info-circle me-1"></i> Le slug sera généré automatiquement à partir du nom.
                                    </div>
                                </div>

                                <div class="d-grid mt-5">
                                    <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold shadow-sm" style="background-color: #42B1CE; border: none;">
                                        <i class="bi bi-check2-circle me-2"></i>Confirmer la création
                                    </button>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<style>
    .breadcrumb-item a { color: #42B1CE; }
    
    .custom-input {
        border: 2px solid #f0f2f5 !important;
        border-radius: 12px !important;
        transition: all 0.3s ease !important;
    }

    .custom-input:focus {
        border-color: #42B1CE !important;
        background-color: #fff !important;
        box-shadow: 0 0 0 4px rgba(66, 177, 206, 0.1) !important;
    }

    .btn-primary:hover {
        background-color: #369db7 !important;
        transform: translateY(-2px);
    }
</style>
{% endblock %}