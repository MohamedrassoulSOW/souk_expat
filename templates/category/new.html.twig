{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvelle catégorie | SoukExpat{% endblock %}
{% block admin_mobile_title %}Nouvelle catégorie{% endblock %}

{% block admin_main %}
    {% set actions %}
        <a href="{{ path('app_category') }}" class="btn btn-light border rounded-pill px-3 bg-white">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour
        </a>
    {% endset %}

    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Catégories',
        title: 'Créer une catégorie',
        lead: 'Le slug est généré automatiquement à partir du nom.',
        actions: actions
    }) }}

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="admin-panel p-4">
                {{ form_start(form, { attr: { class: 'needs-validation', enctype: 'multipart/form-data' } }) }}
                    <div class="mb-4">
                        {{ form_label(form.name, 'Nom de la catégorie', { label_attr: { class: 'form-label fw-bold small text-uppercase text-muted' } }) }}
                        {{ form_widget(form.name, {
                            attr: {
                                class: 'form-control form-control-lg rounded-3',
                                placeholder: 'Ex. Immobilier, Emploi, Services…'
                            }
                        }) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.name) }}</div>
                    </div>
                    <div class="mb-4">
                        {{ form_label(form.imageFile, 'Image', { label_attr: { class: 'form-label fw-bold small text-uppercase text-muted' } }) }}
                        {{ form_widget(form.imageFile) }}
                        <div class="form-text small">{{ form_help(form.imageFile) }}</div>
                        <div class="text-danger small mt-1">{{ form_errors(form.imageFile) }}</div>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-admin-primary btn-lg rounded-pill py-3 fw-semibold">
                            <i class="bi bi-check2 me-2" aria-hidden="true"></i>Créer la catégorie
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
