{# Bouton WhatsApp flottant — visible mobile / tablette / desktop #}
{% set wa_phone = site ? site.contactPhone : null %}
{% set wa_href = wa_phone ? (wa_phone|whatsapp_url('Bonjour SoukExpat, j’ai une question.')) : '#' %}
{% if wa_phone and wa_href != '#' %}
<a href="{{ wa_href }}"
   class="whatsapp-fab"
   target="_blank"
   rel="noopener noreferrer"
   aria-label="Contacter SoukExpat sur WhatsApp"
   title="WhatsApp">
    <i class="bi bi-whatsapp" aria-hidden="true"></i>
    <span class="whatsapp-fab__label">WhatsApp</span>
</a>
{% endif %}
