<footer class="footer-modern bg-dark text-white pt-5 mt-5" data-animate="fade-up">
    <div class="container">
        <div class="row g-4 mb-5">
            {# Colonne 1 : À propos #}
            <div class="col-12 col-lg-4 col-md-6 mb-4 mb-md-0">
                <a class="footer-brand mb-3 d-inline-flex flex-column align-items-center align-items-md-start text-decoration-none" href="{{ path('app_home') }}" title="{{ site ? site.siteName : 'SoukExpat' }} — Accueil">
                    <img class="footer-brand-logo" src="{{ asset('logo-souk-expat.png') }}" alt="{{ site ? site.siteName ~ ' — ' ~ site.tagline : 'SoukExpat' }}" width="200" height="110" loading="lazy" decoding="async">
                </a>
                <p class="text-secondary small pe-lg-5 text-center text-md-start">
                    {{ site ? site.footerText : 'Le Marché Mondial des Expatriés. Achetez, vendez et échangez en toute confiance au sein de votre communauté au Maroc.' }}
                </p>
                <div class="social-links d-flex gap-3 mt-4 justify-content-center justify-content-md-start flex-wrap">
                    {% if site and site.facebookUrl %}
                        <a href="{{ site.facebookUrl }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                    {% endif %}
                    {% if site and site.instagramUrl %}
                        <a href="{{ site.instagramUrl }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    {% endif %}
                    {% if site and site.linkedinUrl %}
                        <a href="{{ site.linkedinUrl }}" class="social-icon" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                    {% endif %}
                    {% set wa_phone = site ? site.contactPhone : null %}
                    {% set wa_href = wa_phone ? (wa_phone|whatsapp_url('Bonjour SoukExpat, j’ai une question.')) : '#' %}
                    {% if wa_phone and wa_href != '#' %}
                        <a href="{{ wa_href }}" class="social-icon social-icon--whatsapp" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                    {% endif %}
                </div>
            </div>

            {# Colonne 2 : Liens rapides #}
            <div class="col-6 col-lg-2 col-md-6 mb-4 mb-md-0">
                <h5 class="fw-bold mb-4 text-center text-md-start">Navigation</h5>
                <ul class="list-unstyled footer-links">
                    <li><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li><a href="{{ path('app_annonce_index') }}">Toutes les annonces</a></li>
                    <li><a href="{{ path('app_how_it_works') }}#videos">Vidéo-Tuto</a></li>
                    <li><a href="{{ path('app_blog') }}">Blog & Conseils</a></li>
                </ul>
            </div>

            {# Colonne 3 : Support #}
            <div class="col-6 col-lg-2 col-md-6 mb-4 mb-md-0">
                <h5 class="fw-bold mb-4 text-center text-md-start">Aide & Support</h5>
                <ul class="list-unstyled footer-links">
                    <li><a href="{{ path('app_contact') }}">Contactez-nous</a></li>
                    <li><a href="{{ path('app_about') }}">À propos de nous</a></li>
                    <li><a href="{{ path('app_faq') }}">FAQ</a></li>
                    <li><a href="{{ path('app_legal') }}">Mentions légales</a></li>
                </ul>
            </div>

            {# Colonne 4 : Contact / info #}
            <div class="col-12 col-lg-4 col-md-6">
                <h5 class="fw-bold mb-4 text-center text-md-start">Restez informé</h5>
                <p class="text-secondary small text-center text-md-start">{{ site ? site.newsletterText : 'Recevez les meilleures pépites du Souk chaque semaine.' }}</p>
                <div class="mt-3 text-center text-md-start d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
                    <a href="{{ path('app_contact') }}" class="btn btn-custom-cyan rounded-pill px-4">
                        <i class="bi bi-envelope me-1" aria-hidden="true"></i>Nous contacter
                    </a>
                    {% set wa_phone = site ? site.contactPhone : null %}
                    {% set wa_href = wa_phone ? (wa_phone|whatsapp_url('Bonjour SoukExpat, j’ai une question.')) : '#' %}
                    {% if wa_phone and wa_href != '#' %}
                        <a href="{{ wa_href }}" class="btn btn-success rounded-pill px-4" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-whatsapp me-1" aria-hidden="true"></i>WhatsApp
                        </a>
                    {% endif %}
                    {% if contact_email %}
                        <p class="small mt-2 mb-0 w-100">
                            <a href="mailto:{{ contact_email }}" class="footer-credit-link">{{ contact_email }}</a>
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Bas du footer #}
        <div class="footer-bottom py-4 border-top border-secondary border-opacity-25 text-center text-md-between d-md-flex align-items-center justify-content-between gap-3">
            <p class="text-secondary small mb-md-0">
                &copy; {{ "now"|date("Y") }} <strong>{{ site ? site.siteName : 'SoukExpat' }}</strong>. Tous droits réservés.
            </p>
            <p class="small mb-0 text-secondary">
                Réalisé par
                <a href="http://sowcoder.com" class="footer-credit-link" target="_blank" rel="noopener noreferrer">SowCoder</a>
            </p>
            <p class="small mb-0">
                {% if contact_email %}
                    <a href="mailto:{{ contact_email }}" style="text-decoration: none; color: #4B79A1; font-weight: 600;">{{ contact_email }}</a>
                {% endif %}
            </p>
        </div>
    </div>
</footer>

<style>
    .footer-modern {
        background-color: #1a1d20 !important;
        font-family: var(--font-sans, "Plus Jakarta Sans", system-ui, sans-serif);
    }

    .footer-brand-logo {
        display: block;
        width: auto;
        height: 88px;
        max-width: min(200px, 80vw);
        object-fit: contain;
        background: transparent;
        filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.35));
    }

    /* Bouton personnalisé */
    .btn-custom-cyan {
        background-color: #4B79A1;
        border-color: #4B79A1;
        color: white;
    }
    .btn-custom-cyan:hover {
        background-color: #1B2E4B;
        border-color: #369ab3;
        color: white;
    }

    /* Style des liens */
    .footer-links li { margin-bottom: 12px; }
    .footer-links a {
        color: #adb5bd;
        text-decoration: none;
        transition: all 0.3s ease;
        font-size: 0.95rem;
    }
    .footer-links a:hover {
        color: #4B79A1;
        padding-left: 5px;
    }

    /* Icônes Sociales */
    .social-icon {
        width: 38px; height: 38px;
        background: rgba(255,255,255,0.05);
        color: white;
        display: flex; align-items: center; justify-content: center;
        border-radius: 10px; text-decoration: none;
        transition: all 0.3s ease;
    }
    .social-icon:hover {
        background: #4B79A1;
        color: white;
        transform: translateY(-3px);
    }
    .social-icon--whatsapp:hover {
        background: #25D366;
    }

    /* Focus Newsletter */
    .footer-modern .form-control:focus {
        border-color: #4B79A1;
        box-shadow: none;
    }

    .footer-credit-link {
        color: #4B79A1;
        font-weight: 700;
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .footer-credit-link:hover {
        color: #93c5e4;
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .footer-modern { text-align: center; }
        .social-links { justify-content: center; }
        .footer-links { 
            text-align: center;
        }
        .footer-links a:hover { padding-left: 0; }
        .footer-bottom { 
            flex-direction: column; 
            gap: 15px; 
            text-align: center;
        }
        .footer-links li {
            margin-bottom: 8px;
        }
    }
    
    @media (max-width: 576px) {
        .footer-modern {
            padding-top: 3rem !important;
        }
    }
</style>