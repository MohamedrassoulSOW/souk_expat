<nav class="navbar navbar-expand-lg fixed-top modern-nav">
    <div class="container">
        {# 1. LOGO & BRAND #}
        <a class="navbar-brand brand-logo-link d-flex align-items-center text-decoration-none" href="{{ path('app_home') }}" title="SoukExpat — Accueil">
            <img class="brand-logo-img" src="{{ asset('logo-souk-expat-nav.png') }}" alt="SoukExpat — Le Marché Mondial des Expatriés" width="170" height="52" decoding="async" fetchpriority="high">
        </a>

        {# BOUTON MOBILE #}
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            {# 2. LIENS CENTRAUX #}
            <ul class="navbar-nav mx-auto nav-links-container">
                {% set route = app.request.attributes.get('_route') %}
                <li class="nav-item">
                    <a class="nav-link {{ route == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}">Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ route == 'app_annonce_index' or route == 'app_annonce_category' ? 'active' : '' }}" href="{{ path('app_annonce_index') }}">Annonces</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ route == 'app_about' ? 'active' : '' }}" href="{{ path('app_about') }}">À propos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ route == 'app_contact' ? 'active' : '' }}" href="{{ path('app_contact') }}">Contact</a>
                </li>
            </ul>

            {# 3. ACTIONS UTILISATEUR #}
            <div class="d-flex align-items-center gap-2 gap-lg-3 actions-container">
                {{ include('layouts/_theme_toggle.html.twig') }}

                {% if app.user %}
                    
                    {# --- DROPDOWN NOTIFICATIONS --- #}
                    {% set unreadNotifsCount = unread_notifications_count() %}
                    {% set latestNotifs = latest_notifications(8) %}
                    <div class="dropdown">
                        <a href="#" class="nav-icon-link position-relative d-flex align-items-center justify-content-center" 
                           id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-bell fs-5"></i>
                            {% if unreadNotifsCount > 0 %}
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm" style="font-size: 0.6rem; transform: translate(-45%, 15%) !important;">
                                    {{ unreadNotifsCount }}
                                </span>
                            {% endif %}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-3 p-2 rounded-4 animate slideIn" style="width: 320px;">
                            <li class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 fw-bold">Notifications</h6>
                                {% if latestNotifs|length > 0 %}
                                    <a href="{{ path('app_notification_delete_all') }}" class="text-danger small text-decoration-none" title="Tout supprimer">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                {% endif %}
                            </li>
                            
                            <div class="notif-scroll" style="max-height: 350px; overflow-y: auto;">
                                {% for notification in latestNotifs %}
                                    <li class="px-2">
                                        <a href="{{ path('app_notification_read', {id: notification.id}) }}" 
                                           class="dropdown-item rounded-3 py-3 mb-1 {{ not notification.isRead ? 'bg-light border-start border-info border-3' : 'opacity-75' }}" 
                                           style="white-space: normal;">
                                            <div class="d-flex gap-2">
                                                <div class="flex-grow-1">
                                                    <div class="small text-dark mb-1 fw-medium">
                                                        {{ notification.message|default('Nouvelle notification') }}
                                                    </div>
                                                    <div class="text-muted d-flex align-items-center" style="font-size: 0.7rem;">
                                                        <i class="bi bi-clock me-1"></i>
                                                        {{ notification.createdAt|date('d/m à H:i') }}
                                                    </div>
                                                </div>
                                                {% if not notification.isRead %}
                                                    <div class="bg-info rounded-circle" style="width: 8px; height: 8px; flex-shrink: 0; margin-top: 5px;"></div>
                                                {% endif %}
                                            </div>
                                        </a>
                                    </li>
                                {% else %}
                                    <li class="text-center py-5 text-muted">
                                        <i class="bi bi-bell-slash fs-2 d-block mb-2 opacity-25"></i>
                                        <span class="small">Aucune notification</span>
                                    </li>
                                {% endfor %}
                            </div>

                            {% if unreadNotifsCount > 0 %}
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-center small text-cyan fw-bold py-2" href="{{ path('app_notification_read_all') }}">
                                        Tout marquer comme lu
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>

                    {# --- MESSAGES --- #}
                    <a href="{{ path('app_messages_list') }}" class="nav-icon-link position-relative d-flex align-items-center justify-content-center" title="Mes messages">
                        <i class="bi bi-chat-dots fs-5"></i>
                        {% set msgCount = unread_messages_count() %}
                        {% if msgCount > 0 %}
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill shadow-sm" style="font-size: 0.6rem; background-color: var(--cyan-main) !important; transform: translate(-45%, 15%) !important;">
                                {{ msgCount }}
                            </span>
                        {% endif %}
                    </a>

                    {# --- BOUTON VENDRE --- #}
                    <a href="{{ path('app_annonce_new') }}" class="btn btn-custom-cyan rounded-pill px-3 px-lg-4 d-flex align-items-center gap-2 shadow-sm hover-up">
                        <i class="bi bi-plus-lg"></i> <span class="d-none d-lg-inline">Vendre</span>
                    </a>

                    {# --- PROFIL --- #}
                    <div class="dropdown">
                        <a class="user-pill d-flex align-items-center text-decoration-none dropdown-toggle" href="#" id="userDropdown" data-bs-toggle="dropdown">
                            <div class="avatar-container">
                                {% if app.user.avatar %}
                                    <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="Avatar">
                                {% else %}
                                    <div class="avatar-placeholder"><i class="bi bi-person"></i></div>
                                {% endif %}
                            </div>
                            <span class="ms-2 d-none d-xl-inline fw-semibold text-dark small">{{ app.user.firstName }}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-3 p-2 rounded-4 animate slideIn">
                            <li><a class="dropdown-item rounded-3 py-2" href="{{ path('app_mes_annonces') }}"><i class="bi bi-stack me-2 opacity-50"></i>Mes annonces</a></li>
                            <li><a class="dropdown-item rounded-3 py-2" href="{{ path('app_profile') }}"><i class="bi bi-person-gear me-2 opacity-50"></i>Paramètres</a></li>
                            {% if is_granted('ROLE_EDITOR') %}
                                <li><hr class="dropdown-divider opacity-50"></li>
                                <li><a class="dropdown-item rounded-3 py-2 fw-medium text-cyan" href="{{ path('app_dashboard') }}"><i class="bi bi-speedometer2 me-2"></i>Tableau de bord</a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider opacity-50"></li>
                            <li><a class="dropdown-item rounded-3 py-2 text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                        </ul>
                    </div>

                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-link text-dark text-decoration-none fw-semibold">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-custom-cyan rounded-pill px-4 shadow-sm hover-up">Inscription</a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

<style>
    :root {
        --cyan-main: #4B79A1;
        --cyan-hover: #1B2E4B;
        /* Hauteur réservée sous la navbar fixe (logo + padding — évite chevauchement du slider / héros) */
        --main-nav-height: 5.25rem;
    }
    body {
        padding-top: var(--main-nav-height);
    }
    html {
        scroll-padding-top: calc(var(--main-nav-height) + 0.5rem);
    }
    @media (max-width: 991.98px) {
        :root { --main-nav-height: 4.75rem; }
    }
    .modern-nav {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        padding: 0.55rem 0;
        z-index: 1030;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.04);
    }
    .modern-nav > .container {
        max-width: 100%;
    }
    .modern-nav .navbar-brand {
        min-width: 0;
        margin-right: 0.75rem;
    }
    .modern-nav .navbar-collapse {
        flex-grow: 1;
        min-width: 0;
    }
    .modern-nav .actions-container {
        flex-shrink: 0;
    }
    .brand-logo-link {
        line-height: 0;
        padding: 0.1rem 0;
    }
    .brand-logo-img {
        display: block;
        height: 52px;
        width: auto;
        max-width: min(170px, 42vw);
        object-fit: contain;
        object-position: left center;
    }
    @media (max-width: 991.98px) {
        .brand-logo-img {
            height: 44px;
            max-width: min(148px, 48vw);
        }
    }
    .text-cyan-nav { color: var(--cyan-main); }
    .nav-links-container .nav-link {
        color: #636e72;
        font-weight: 600;
        margin: 0 8px;
        padding: 0.45rem 0.35rem;
        transition: color 0.2s ease;
        position: relative;
    }
    .nav-links-container .nav-link::after {
        content: '';
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 0;
        height: 2px;
        background: var(--cyan-main);
        border-radius: 2px;
        transform: translateX(-50%);
        transition: width 0.2s ease;
    }
    .nav-links-container .nav-link:hover,
    .nav-links-container .nav-link.active {
        color: var(--cyan-main);
    }
    .nav-links-container .nav-link:hover::after,
    .nav-links-container .nav-link.active::after {
        width: 70%;
    }
    .nav-icon-link { color: #636e72; width: 42px; height: 42px; text-decoration: none; border-radius: 50%; transition: 0.2s; }
    .nav-icon-link:hover { color: var(--cyan-main); background: #f8f9fa; }
    .btn-custom-cyan { background-color: var(--cyan-main); color: white !important; border: none; transition: 0.3s; }
    .btn-custom-cyan:hover { background-color: var(--cyan-hover); transform: translateY(-2px); }
    .user-pill { background: #f8f9fa; padding: 4px 12px 4px 4px; border-radius: 50px; }
    .avatar-container img, .avatar-placeholder { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: white; border: 1px solid #eee; }
    .notif-scroll::-webkit-scrollbar { width: 4px; }
    .notif-scroll::-webkit-scrollbar-thumb { background: #ccc; border-radius: 10px; }
    .animate { animation-duration: 0.3s; animation-fill-mode: both; }
    @keyframes slideIn { 0% { transform: translateY(10px); opacity: 0; } 100% { transform: translateY(0); opacity: 1; } }
    .slideIn { animation-name: slideIn; }
    .text-cyan { color: var(--cyan-main) !important; }
    .hover-up:hover { transform: translateY(-2px); }
</style>