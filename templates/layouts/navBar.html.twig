<nav class="navbar navbar-expand-lg sticky-top modern-nav">
    <div class="container">
        {# 1. LOGO #}
        <a class="navbar-brand fw-bold d-flex align-items-center" href="{{ path('app_home') }}">
            <div class="logo-icon me-2">
                <i class="bi bi-shop-window text-white"></i>
            </div>
            <span class="brand-text">Expat<span style="color: #42B1CE;">Souk</span></span>
        </a>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            {# 2. LIENS CENTRAUX #}
            <ul class="navbar-nav mx-auto nav-links-container">
                {% set route = app.request.attributes.get('_route') %}
                <li class="nav-item">
                    <a class="nav-link {{ route == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}">Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ route == 'app_annonce_index' ? 'active' : '' }}" href="{{ path('app_annonce_index') }}">Annonces</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ route == 'app_about' ? 'active' : '' }}" href="{{ path('app_about') }}">À propos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ route == 'app_contact' ? 'active' : '' }}" href="{{ path('app_contact') }}">Contact</a>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-2 gap-lg-3 actions-container">
                {% if app.user %}
                    
                    {# 3. DROPDOWN NOTIFICATIONS #}
                    <div class="dropdown">
                        <a href="#" class="nav-icon-link position-relative d-flex align-items-center justify-content-center" 
                           id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="width: 40px; height: 40px;">
                            <i class="bi bi-bell fs-5"></i>
                            
                            {# Calcul du badge rouge #}
                            {% set unreadNotifsCount = app.user.notifications|filter(n => not n.isRead)|length %}
                            {% if unreadNotifsCount > 0 %}
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem; margin-left: -8px; margin-top: 8px;">
                                    {{ unreadNotifsCount }}
                                </span>
                            {% endif %}
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-3 p-0 rounded-4 animate slideIn overflow-hidden" style="width: 320px;">
                            <div class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                                <h6 class="mb-0 fw-bold small text-uppercase" style="letter-spacing: 1px;">Notifications</h6>
                                
                                {# LOGIQUE BOUTON : TOUT LIRE OU VIDER #}
                                {% if app.user.notifications|length > 0 %}
                                    {% if unreadNotifsCount > 0 %}
                                        <a href="{{ path('app_notification_read_all') }}" class="text-decoration-none small fw-bold text-cyan">
                                            <i class="bi bi-check2-all"></i> Tout lire
                                        </a>
                                    {% else %}
                                        <a href="{{ path('app_notification_delete_all') }}" class="text-decoration-none small fw-bold text-danger">
                                            <i class="bi bi-trash3"></i> Vider
                                        </a>
                                    {% endif %}
                                {% endif %}
                            </div>

                            <div class="overflow-y-auto" style="max-height: 350px;">
                                {% for notification in app.user.notifications|sort((a, b) => b.createdAt <=> a.createdAt)|slice(0, 10) %}
                                    <li>
                                        <a href="{{ path('app_notification_read', {'id': notification.id}) }}" 
                                           class="dropdown-item p-3 border-bottom text-wrap {{ not notification.isRead ? 'bg-light border-start border-4 border-info' : 'opacity-75' }}">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="fw-bold small {{ not notification.isRead ? 'text-dark' : 'text-muted' }}">{{ notification.title }}</span>
                                                <small class="text-muted" style="font-size: 0.7rem;">{{ notification.createdAt|date('d/m H:i') }}</small>
                                            </div>
                                            <p class="mb-0 small text-muted lh-sm">{{ notification.message }}</p>
                                        </a>
                                    </li>
                                {% else %}
                                    <li class="p-4 text-center text-muted small">Aucune notification</li>
                                {% endfor %}
                            </div>
                        </ul>
                    </div>

                    {# 4. MESSAGES (CHAT) #}
                    <a href="{{ path('app_messages_list') }}" class="nav-icon-link position-relative d-flex align-items-center justify-content-center" title="Mes messages" style="width: 40px; height: 40px;">
                        <i class="bi bi-chat-dots fs-5"></i>
                        {% set count = unread_messages_count() %}
                        {% if count > 0 %}
                            <span class="badge-dot pulse"></span>
                        {% endif %}
                    </a>

                    {# 5. BOUTON VENDRE #}
                    <a href="{{ path('app_annonce_new') }}" class="btn btn-custom-cyan rounded-pill px-4 d-none d-lg-flex align-items-center gap-2 shadow-sm hover-up">
                        <i class="bi bi-plus-lg"></i> <span>Vendre</span>
                    </a>

                    {# 6. MENU PROFIL #}
                    <div class="dropdown">
                        <a class="user-pill d-flex align-items-center text-decoration-none dropdown-toggle" href="#" id="userDropdown" data-bs-toggle="dropdown">
                            <div class="avatar-container">
                                {% if app.user.avatar %}
                                    <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="Avatar" class="rounded-circle">
                                {% else %}
                                    <div class="avatar-placeholder">
                                        <i class="bi bi-person" style="color: #42B1CE;"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <span class="ms-2 d-none d-xl-inline fw-semibold text-dark small">{{ app.user.firstName }}</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-3 p-2 rounded-4 animate slideIn">
                            <li><a class="dropdown-item rounded-3 py-2" href="{{ path('app_mes_annonces') }}"><i class="bi bi-stack me-2 opacity-50"></i>Mes annonces</a></li>
                            <li><a class="dropdown-item rounded-3 py-2" href="{{ path('app_profile') }}"><i class="bi bi-person-gear me-2 opacity-50"></i>Paramètres</a></li>
                            
                            {% if is_granted('ROLE_ADMIN') %}
                                <li><hr class="dropdown-divider opacity-50"></li>
                                <li>
                                    <a class="dropdown-item rounded-3 py-2 fw-medium text-cyan" href="{{ path('app_dashboard') }}">
                                        <i class="bi bi-shield-check me-2"></i>Administration
                                    </a>
                                </li>
                            {% endif %}
                            
                            <li><hr class="dropdown-divider opacity-50"></li>
                            <li><a class="dropdown-item rounded-3 py-2 text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
                        </ul>
                    </div>

                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-link text-dark text-decoration-none fw-semibold">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-custom-cyan rounded-pill px-4 shadow-sm hover-up">Inscription</a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

<style>
    :root {
        --cyan-main: #42B1CE;
        --cyan-hover: #369ab3;
    }

    .text-cyan { color: var(--cyan-main) !important; }
    .border-info { border-color: var(--cyan-main) !important; }

    /* Base Navbar */
    .modern-nav {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        padding: 0.6rem 0;
    }

    .logo-icon {
        background: var(--cyan-main);
        width: 38px; height: 38px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(66, 177, 206, 0.3);
    }

    /* Icons & Badges */
    .nav-icon-link { color: #636e72; transition: all 0.2s; text-decoration: none; border-radius: 50%; }
    .nav-icon-link:hover { color: var(--cyan-main); background: rgba(66, 177, 206, 0.1); }
    
    .badge-dot {
        position: absolute; top: 4px; right: 4px;
        width: 8px; height: 8px;
        background: #ff4757; border-radius: 50%;
        border: 2px solid white;
    }

    /* Bouton Vendre */
    .btn-custom-cyan {
        background-color: var(--cyan-main);
        border-color: var(--cyan-main);
        color: white;
        transition: all 0.3s ease;
    }
    .btn-custom-cyan:hover {
        background-color: var(--cyan-hover);
        color: white;
        transform: translateY(-2px);
    }

    /* Links & States */
    .nav-links-container .nav-link {
        color: #636e72;
        font-weight: 500;
        margin: 0 10px;
        position: relative;
    }
    .nav-links-container .nav-link.active, .nav-links-container .nav-link:hover {
        color: var(--cyan-main) !important;
    }

    .nav-links-container .nav-link.active::after {
        content: '';
        position: absolute;
        bottom: -2px; left: 50%;
        transform: translateX(-50%);
        width: 12px; height: 3px;
        background: var(--cyan-main);
        border-radius: 10px;
    }

    /* Avatar & Profile */
    .user-pill {
        background: #f8f9fa;
        padding: 4px 12px 4px 4px;
        border-radius: 50px;
        border: 1px solid #eee;
        transition: 0.2s;
    }
    .user-pill:hover { background: #f1f2f3; }
    .avatar-container img, .avatar-placeholder { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; }
    .avatar-placeholder { background: #e9ecef; display: flex; align-items: center; justify-content: center; }

    /* Animations Dropdown */
    .animate.slideIn { animation: slideIn 0.25s ease-out; }
    @keyframes slideIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .pulse {
        animation: pulse-animation 2s infinite;
    }
    @keyframes pulse-animation {
        0% { box-shadow: 0 0 0 0px rgba(255, 71, 87, 0.4); }
        100% { box-shadow: 0 0 0 10px rgba(255, 71, 87, 0); }
    }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
