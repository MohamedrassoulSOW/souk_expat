        .nav-account-card { width: 100%; }
        .nav-account-trigger {
            width: 100%;
            padding: 0.65rem 0.85rem 0.65rem 0.65rem;
            border-radius: 1rem;
            background: var(--surface, #fff);
            box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
