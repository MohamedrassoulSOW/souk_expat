    .nav-account-trigger {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.3rem 0.7rem 0.3rem 0.3rem;
        border-radius: 999px;
        background: var(--cyan-soft, rgba(75, 121, 161, 0.08));
        border: 1px solid var(--border-soft, rgba(75, 121, 161, 0.14));
        color: var(--text-strong, #1e293b);
        transition: background 0.18s ease, transform 0.18s ease;
    }
    .nav-account-trigger:hover {
        background: rgba(75, 121, 161, 0.14);
        transform: translateY(-1px);
    }
    .nav-account-meta {
        display: none;
        flex-direction: column;
        line-height: 1.15;
        text-align: left;
    }
    .nav-account-name { font-size: 0.88rem; font-weight: 700; color: inherit; }
    .nav-account-hint { font-size: 0.68rem; color: var(--text-muted-custom, #64748b); font-weight: 500; }
    .nav-account-chevron { font-size: 0.75rem; opacity: 0.55; }
    .nav-account-trigger.dropdown-toggle::after { display: none; }

    .nav-auth-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .nav-auth-login {
        color: var(--text-strong, #1e293b);
        font-weight: 650;
        text-decoration: none;
        padding: 0.45rem 0.8rem;
    }

