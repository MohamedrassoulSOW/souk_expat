<nav class="navbar navbar-expand-lg fixed-top modern-nav">
    <div class="container">
        <a class="navbar-brand brand-logo-link d-flex align-items-center text-decoration-none" href="{{ path('app_home') }}" title="SoukExpat — Accueil">
            <img class="brand-logo-img" src="{{ asset('logo-souk-expat-nav.png') }}" alt="SoukExpat — Le Marché Mondial des Expatriés" width="170" height="52" decoding="async" fetchpriority="high">
        </a>

        {% set route = app.request.attributes.get('_route') %}

        <div class="nav-quick-actions d-flex align-items-center gap-1">
            {{ include('layouts/_theme_toggle.html.twig') }}

            {% if app.user %}
                {% set unreadNotifsCount = unread_notifications_count() %}
                {% set latestNotifs = latest_notifications(8) %}
                <div class="dropdown nav-notif-dropdown">
                    <a href="#"
                       class="nav-icon-link position-relative d-flex align-items-center justify-content-center"
                       id="notifDropdown"
                       data-bs-toggle="dropdown"
                       data-bs-display="static"
                       aria-expanded="false"
                       aria-label="Notifications">
                        <i class="bi bi-bell fs-5"></i>
                        {% if unreadNotifsCount > 0 %}
                            <span class="nav-icon-badge">{{ unreadNotifsCount > 9 ? '9+' : unreadNotifsCount }}</span>
                        {% endif %}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2 p-2 rounded-4 animate slideIn nav-notif-menu">
                        <li class="px-3 py-2 border-bottom d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 fw-bold">Notifications</h6>
                            {% if latestNotifs|length > 0 %}
                                <form method="post" action="{{ path('app_notification_delete_all') }}" class="m-0" onsubmit="return confirm('Supprimer toutes les notifications ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('notif_delete_all') }}">
                                    <button type="submit" class="btn btn-link text-danger small text-decoration-none p-0" title="Tout supprimer">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            {% endif %}
                        </li>
                        <div class="notif-scroll">
                            {% for notification in latestNotifs %}
                                <li class="px-2">
                                    <form method="post" action="{{ path('app_notification_read', {id: notification.id}) }}" class="m-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('notif_read' ~ notification.id) }}">
                                        <button type="submit"
                                                class="dropdown-item rounded-3 py-3 mb-1 text-start w-100 border-0 {{ not notification.isRead ? 'bg-body-tertiary border-start border-info border-3' : 'opacity-75' }}"
                                                style="white-space: normal;">
                                            <div class="d-flex gap-2">
                                                <div class="flex-grow-1">
                                                    <div class="small text-body mb-1 fw-medium">{{ notification.message|default('Nouvelle notification') }}</div>
                                                    <div class="text-muted d-flex align-items-center" style="font-size: 0.7rem;">
                                                        <i class="bi bi-clock me-1"></i>{{ notification.createdAt|date('d/m à H:i') }}
                                                    </div>
                                                </div>
                                                {% if not notification.isRead %}
                                                    <div class="bg-info rounded-circle" style="width: 8px; height: 8px; flex-shrink: 0; margin-top: 5px;"></div>
                                                {% endif %}
                                            </div>
                                        </button>
                                    </form>
                                </li>
                            {% else %}
                                <li class="text-center py-5 text-muted">
                                    <i class="bi bi-bell-slash fs-2 d-block mb-2 opacity-25"></i>
                                    <span class="small">Aucune notification</span>
                                </li>
                            {% endfor %}
                        </div>
                        {% if unreadNotifsCount > 0 %}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="{{ path('app_notification_read_all') }}" class="m-0">
                                    <input type="hidden" name="_token" value="{{ csrf_token('notif_read_all') }}">
                                    <button type="submit" class="dropdown-item text-center small text-cyan fw-bold py-2 border-0 w-100 bg-transparent">Tout marquer comme lu</button>
                                </form>
                            </li>
                        {% endif %}
                    </ul>
                </div>

                <a href="{{ path('app_messages_list') }}"
                   class="nav-icon-link position-relative d-flex align-items-center justify-content-center"
                   title="Mes messages"
                   aria-label="Mes messages">
                    <i class="bi bi-chat-dots fs-5"></i>
                    {% set msgCount = unread_messages_count() %}
                    {% if msgCount > 0 %}
                        <span class="nav-icon-badge nav-icon-badge--cyan">{{ msgCount > 9 ? '9+' : msgCount }}</span>
                    {% endif %}
                </a>
            {% endif %}

            <a href="{{ path('app_annonce_index') }}"
               class="nav-quick-annonces d-lg-none {{ route in ['app_annonce_index', 'app_annonce_category'] ? 'is-active' : '' }}"
               title="Voir les annonces"
               aria-label="Annonces">
                <i class="bi bi-grid-3x3-gap-fill" aria-hidden="true"></i>
            </a>

            <button class="navbar-toggler nav-menu-toggler border-0 shadow-none ms-1"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav"
                    aria-controls="navbarNav"
                    aria-expanded="false"
                    aria-label="Ouvrir le menu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>

        <div class="collapse navbar-collapse" id="navbarNav">
            <div class="nav-mobile-panel w-100">
                <ul class="navbar-nav mx-auto nav-links-container">
                    <li class="nav-item">
                        <a class="nav-link {{ route == 'app_home' ? 'active' : '' }}" href="{{ path('app_home') }}">
                            <i class="bi bi-house-door nav-link-ic" aria-hidden="true"></i><span>Accueil</span>
                        </a>
                    </li>
                    <li class="nav-item d-none d-lg-block">
                        <a class="nav-link {{ route in ['app_annonce_index', 'app_annonce_category'] ? 'active' : '' }}" href="{{ path('app_annonce_index') }}">
                            <i class="bi bi-grid-3x3-gap nav-link-ic" aria-hidden="true"></i><span>Annonces</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ route == 'app_about' ? 'active' : '' }}" href="{{ path('app_about') }}">
                            <i class="bi bi-info-circle nav-link-ic" aria-hidden="true"></i><span>À propos</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ route == 'app_contact' ? 'active' : '' }}" href="{{ path('app_contact') }}">
                            <i class="bi bi-envelope nav-link-ic" aria-hidden="true"></i><span>Contact</span>
                        </a>
                    </li>
                </ul>

                <div class="actions-container">
                    {% if app.user %}
                        <div class="nav-account-card dropdown">
                            <a class="nav-account-trigger dropdown-toggle text-decoration-none"
                               href="#"
                               id="userDropdown"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <div class="avatar-container">
                                    {% if app.user.avatar %}
                                        <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="">
                                    {% else %}
                                        <div class="avatar-placeholder"><i class="bi bi-person"></i></div>
                                    {% endif %}
                                </div>
                                <span class="nav-account-meta">
                                    <span class="nav-account-name">{{ app.user.firstName }}</span>
                                    <span class="nav-account-hint">Mon compte</span>
                                </span>
                                <i class="bi bi-chevron-down nav-account-chevron" aria-hidden="true"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg mt-2 p-2 rounded-4 animate slideIn">
                                <li><a class="dropdown-item rounded-3 py-2" href="{{ path('app_annonce_new') }}"><i class="bi bi-plus-lg me-2 opacity-50"></i>Vendre</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" href="{{ path('app_mes_annonces') }}"><i class="bi bi-stack me-2 opacity-50"></i>Mes annonces</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" href="{{ path('app_profile') }}"><i class="bi bi-person-gear me-2 opacity-50"></i>Paramètres</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" href="{{ path('app_how_it_works') }}#videos"><i class="bi bi-play-btn me-2 opacity-50"></i>Vidéo-Tuto</a></li>
                                {% if is_granted('ROLE_EDITOR') %}
                                    <li><hr class="dropdown-divider opacity-50"></li>
                                    <li><a class="dropdown-item rounded-3 py-2 fw-medium text-cyan" href="{{ path('app_dashboard') }}"><i class="bi bi-speedometer2 me-2"></i>Tableau de bord</a></li>
                                {% endif %}
                                <li><hr class="dropdown-divider opacity-50"></li>
                                <li>
                                    {{ include('security/_logout_button.html.twig', {
                                        variant: 'dropdown',
                                        form_class: 'd-block m-0'
                                    }) }}
                                </li>
                            </ul>
                        </div>
                    {% else %}
                        <div class="nav-auth-actions">
                            <a href="{{ path('app_login') }}" class="btn nav-auth-login">Connexion</a>
                            <a href="{{ path('app_register') }}" class="btn btn-custom-cyan rounded-pill px-4 shadow-sm">Inscription</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</nav>

<style>
    :root {
        --cyan-main: #4B79A1;
        --cyan-hover: #1B2E4B;
        --main-nav-height: 5.25rem;
    }
    body { padding-top: var(--main-nav-height); }
    html { scroll-padding-top: calc(var(--main-nav-height) + 0.5rem); }
    @media (max-width: 991.98px) {
        :root { --main-nav-height: 4.75rem; }
    }

    .modern-nav {
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(27, 46, 75, 0.08);
        padding: 0.55rem 0;
        z-index: 1030;
        box-shadow: 0 8px 28px rgba(15, 23, 42, 0.06);
    }
    .modern-nav > .container,
    .modern-nav > .container-fluid {
        max-width: 100%;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-start;
        column-gap: 0.35rem;
        row-gap: 0;
    }
    .modern-nav .navbar-brand {
        min-width: 0;
        margin-right: auto;
        order: 0;
        flex: 0 1 auto;
        padding-top: 0.15rem;
        padding-bottom: 0.15rem;
    }
    .nav-quick-actions {
        order: 1;
        margin-left: 0;
        flex: 0 0 auto;
        flex-shrink: 0;
        position: relative;
        z-index: 2;
    }
    .modern-nav .navbar-collapse {
        order: 2;
        flex-grow: 1;
        flex-basis: 100%;
        min-width: 0;
    }
    .nav-menu-toggler {
        width: 42px;
        height: 42px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--cyan-soft, rgba(75, 121, 161, 0.08));
    }
    .nav-menu-toggler .navbar-toggler-icon {
        width: 1.15rem;
        height: 1.15rem;
    }

    .brand-logo-link { line-height: 0; padding: 0.1rem 0; }
    .brand-logo-img {
        display: block;
        height: 52px;
        width: auto;
        max-width: min(170px, 42vw);
        object-fit: contain;
        object-position: left center;
    }

    .nav-icon-link {
        color: var(--text-muted-custom, #475569);
        width: 40px;
        height: 40px;
        text-decoration: none;
        border-radius: 50%;
        transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease;
        background: var(--cyan-soft, rgba(75, 121, 161, 0.08));
        border: none;
    }
    .nav-icon-link:hover {
        color: var(--cyan-main);
        background: rgba(75, 121, 161, 0.16);
        transform: translateY(-1px);
    }
    .nav-icon-badge {
        position: absolute;
        top: 2px;
        right: 2px;
        min-width: 1rem;
        height: 1rem;
        padding: 0 0.25rem;
        border-radius: 999px;
        background: #dc3545;
        color: #fff;
        font-size: 0.62rem;
        font-weight: 700;
        line-height: 1rem;
        text-align: center;
        box-shadow: 0 0 0 2px var(--surface, #fff);
    }
    .nav-icon-badge--cyan { background: var(--cyan-main); }

    .nav-quick-annonces {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        font-size: 1.05rem;
        text-decoration: none;
        color: #fff;
        background: linear-gradient(135deg, #4B79A1, #1B2E4B);
        box-shadow: 0 6px 14px rgba(27, 46, 75, 0.22);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .nav-quick-annonces:hover,
    .nav-quick-annonces.is-active {
        color: #fff;
        transform: translateY(-1px) scale(1.04);
        box-shadow: 0 8px 18px rgba(27, 46, 75, 0.28);
    }

    .nav-notif-menu {
        width: min(320px, calc(100vw - 1.5rem));
        max-width: calc(100vw - 1.5rem);
    }
    .notif-scroll { max-height: 350px; overflow-y: auto; }

    .nav-links-container .nav-link {
        color: var(--text-muted-custom, #475569);
        font-weight: 650;
        margin: 0 8px;
        padding: 0.45rem 0.35rem;
        transition: color 0.2s ease;
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
    }
    .nav-link-ic {
        display: none;
        font-size: 1.05rem;
        opacity: 0.85;
    }
    .nav-links-container .nav-link::after {
        content: '';
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 0;
        height: 2px;
        background: var(--cyan-main);
        border-radius: 2px;
        transform: translateX(-50%);
        transition: width 0.2s ease;
    }
    .nav-links-container .nav-link:hover,
    .nav-links-container .nav-link.active { color: var(--cyan-main); }
    .nav-links-container .nav-link:hover::after,
    .nav-links-container .nav-link.active::after { width: 70%; }

    .btn-custom-cyan { background-color: var(--cyan-main); color: white !important; border: none; transition: 0.3s; }
    .btn-custom-cyan:hover { background-color: var(--cyan-hover); transform: translateY(-2px); }

    .avatar-container img, .avatar-placeholder {
        width: 36px; height: 36px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: var(--surface, #fff);
        border: 1px solid var(--border-soft, #eee);
        color: var(--cyan-main);
        object-fit: cover;
    }

