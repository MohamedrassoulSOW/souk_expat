            flex-basis: 100%;
            order: 2;
        }
        .nav-quick-actions {
            order: 1;
        }
        .nav-mobile-panel {
            margin-top: 0.75rem;
            padding: 0.85rem;
            border-radius: 1.15rem;
            background: linear-gradient(180deg, var(--surface-2, rgba(244, 247, 251, 0.95)) 0%, var(--surface, rgba(255, 255, 255, 0.98)) 100%);
            border: 1px solid var(--border-soft, rgba(75, 121, 161, 0.12));
            box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
            animation: navPanelIn 0.28s ease;
        }
        .nav-links-container {
            gap: 0.4rem;
            margin-bottom: 0.85rem !important;
        }
        .nav-links-container .nav-item { width: 100%; }
        .nav-links-container .nav-link {
            width: 100%;
            margin: 0;
            padding: 0.85rem 0.95rem;
            border-radius: 0.9rem;
            background: var(--surface, #fff);
            border: 1px solid var(--border-soft, rgba(75, 121, 161, 0.1));
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
            justify-content: flex-start;
        }
        .nav-links-container .nav-link::after { display: none; }
        .nav-link-ic { display: inline-flex; color: var(--cyan-main); }
        .nav-links-container .nav-link.active,
        .nav-links-container .nav-link:hover {
            background: linear-gradient(135deg, rgba(75, 121, 161, 0.12), rgba(27, 46, 75, 0.06));
            border-color: rgba(75, 121, 161, 0.22);
            color: var(--cyan-hover);
            transform: translateX(2px);
        }
        .modern-nav .actions-container {
            width: 100%;
            justify-content: stretch;
            margin: 0;
            padding-top: 0.75rem;
            border-top: 1px solid rgba(15, 23, 42, 0.06);
