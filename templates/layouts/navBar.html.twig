        .nav-auth-actions .btn { width: 100%; border-radius: 999px; padding: 0.7rem 1rem; }
        .nav-quick-actions .nav-notif-dropdown { position: static; }
        .nav-quick-actions .nav-notif-menu {
            --bs-dropdown-min-width: 0;
            position: fixed !important;
            top: calc(var(--main-nav-height, 4.75rem) + 0.35rem) !important;
            left: 50% !important;
            right: auto !important;
            bottom: auto !important;
            transform: translate3d(-50%, 0, 0) !important;
            width: min(20rem, calc(100vw - 1.5rem)) !important;
            max-width: calc(100vw - 1.5rem) !important;
            margin: 0 !important;
            z-index: 1055;
            animation: none !important;
        }
        .nav-quick-actions .nav-notif-menu.show {
            transform: translate3d(-50%, 0, 0) !important;
