        .nav-quick-actions {
            order: 2;
            margin-left: 0.75rem;
        }
        .nav-quick-actions .navbar-toggler { display: none !important; }
        .nav-mobile-panel {
            display: flex;
            align-items: center;
            width: 100%;
            gap: 0.75rem;
        }
        .nav-links-container { margin-bottom: 0 !important; }
        .actions-container { margin-left: auto; }
        .nav-account-meta { display: none; }
    }

    @media (min-width: 1200px) {
