{# Bouton / formulaire de déconnexion (POST + CSRF, compatible Turbo) #}
{% set _variant = variant|default('link') %}
{% set _label = label|default('Déconnexion') %}
{% set _class = btn_class|default('') %}

<form action="{{ path('app_logout') }}" method="post" class="{{ form_class|default('d-inline') }}" data-turbo="false">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
    {% if _variant == 'nav' %}
        <button type="submit" class="nav-link text-danger hover-light small border-0 bg-transparent w-100 text-start {{ _class }}">
            <i class="bi bi-box-arrow-left me-2" aria-hidden="true"></i>{{ _label }}
        </button>
    {% elseif _variant == 'dropdown' %}
        <button type="submit" class="dropdown-item rounded-3 py-2 text-danger {{ _class }}">
            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>{{ _label }}
        </button>
    {% elseif _variant == 'sidebar-footer' %}
        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill w-100 {{ _class }}">
            <i class="bi bi-box-arrow-left me-1" aria-hidden="true"></i>{{ _label }}
        </button>
    {% else %}
        <button type="submit" class="btn btn-link text-danger text-decoration-none p-0 {{ _class }}">
            {{ _label }}
        </button>
    {% endif %}
</form>
