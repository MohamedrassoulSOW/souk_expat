{% extends 'base.html.twig' %}

{% block title %}Connexion | Expat Souk{% endblock %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}

<main class="container py-5">
    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
            
            {# Message si déjà connecté #}
            {% if app.user %}
                <div class="alert alert-info border-0 shadow-sm rounded-4 mb-4 text-center">
                    <i class="bi bi-info-circle me-2"></i>
                    Vous êtes connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>. 
                    <br>
                    <a href="{{ logout_path() }}" class="alert-link">Se déconnecter</a>
                </div>
            {% endif %}

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                {# Header de connexion #}
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #42B1CE 0%, #2a8da7 100%);">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2 overflow-hidden border border-2 border-white border-opacity-50 shadow-sm bg-white" style="width: 64px; height: 64px;">
                        <img src="{{ asset('logo-souk-expat.png') }}" alt="Expat Souk" width="64" height="64" class="w-100 h-100" style="object-fit: cover;">
                    </div>
                    <h4 class="fw-bold mb-0">Bon retour !</h4>
                    <p class="small mb-0 opacity-75">Connectez-vous à Expat Souk</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    {# Gestion des erreurs #}
                    {% if error %}
                        <div class="alert alert-danger border-0 small shadow-sm mb-4 py-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <form method="post">
                        {# Email #}
                        <div class="mb-3">
                            <label for="username" class="form-label small fw-bold text-muted text-uppercase">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input type="email" value="{{ last_username }}" name="_username" id="username" 
                                       class="form-control form-control-lg bg-light border-0 shadow-none ps-0" 
                                       placeholder="nom@exemple.com" autocomplete="email" required autofocus>
                            </div>
                        </div>

                        {# Password #}
                        <div class="mb-3">
                            <label for="password" class="form-label small fw-bold text-muted text-uppercase">Mot de passe</label>
                            <div class="input-group border-0 rounded-3 overflow-hidden">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-shield-lock text-muted"></i></span>
                                <input type="password" name="_password" id="password" 
                                       class="form-control form-control-lg bg-light border-0 shadow-none ps-0" 
                                       placeholder="••••••••" autocomplete="current-password" required>
                            </div>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        {# Options supplémentaires #}
                        <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
                            <div class="form-check custom-checkbox">
                                <input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me">
                                <label class="form-check-label small text-muted" for="_remember_me">
                                    Se souvenir de moi
                                </label>
                            </div>
                            <a href="{{ path('app_forgot_password_request') }}" class="small text-decoration-none fw-semibold" style="color: #42B1CE;">Oublié ?</a>
                        </div>

                        {# Bouton de connexion #}
                        <button type="submit" class="btn btn-login-custom btn-lg w-100 py-3 rounded-pill fw-bold shadow-sm">
                            Se connecter
                        </button>

                        {# Lien d'inscription #}
                        <div class="text-center mt-4 pt-3 border-top">
                            <p class="text-muted small mb-0">
                                Pas encore de compte ? 
                                <a href="{{ path('app_register') }}" class="fw-bold text-decoration-none ms-1" style="color: #42B1CE;">
                                    Créer un compte
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
            
            <p class="text-center text-muted small mt-4 opacity-50">
                Accès sécurisé Expat Souk
            </p>
        </div>
    </div>
</main>

<style>
    /* --- Personnalisation Login --- */
    .btn-login-custom {
        background-color: #42B1CE;
        border: none;
        color: white;
        transition: all 0.3s ease;
    }
    .btn-login-custom:hover {
        background-color: #369ab3;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(66, 177, 206, 0.2) !important;
    }

    .form-control:focus {
        background-color: #fff !important;
        border: 1px solid #42B1CE !important;
        box-shadow: 0 0 0 0.25rem rgba(66, 177, 206, 0.1) !important;
    }

    .input-group-text {
        border-right: none !important;
    }

    .form-check-input:checked {
        background-color: #42B1CE;
        border-color: #42B1CE;
    }

    /* Animation d'entrée */
    .card {
        animation: fadeIn 0.5s ease-out;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}