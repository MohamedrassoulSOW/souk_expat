{% extends 'base.html.twig' %}

{% block title %}Accueil | SoukExpat — Le Marché Mondial des Expatriés{% endblock %}

{% block body %}
    {{ include('layouts/navBar.html.twig') }}
    {% set sf = search_filters %}
    {% set has_filters = sf.q or sf.categoryId or sf.cityId %}

    {# ——— HERO ——— #}
    <section class="home-hero{% if sliders is empty %} home-hero--fallback{% endif %}" data-animate="fade-up">
        {% if sliders is not empty %}
            <div id="homeCarousel" class="carousel slide home-hero-carousel" data-bs-ride="carousel" data-bs-interval="5500">
                <div class="carousel-indicators home-hero-indicators">
                    {% for slider in sliders %}
                        <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' : '' }}" aria-label="Slide {{ loop.index }}" {% if loop.first %}aria-current="true"{% endif %}></button>
                    {% endfor %}
                </div>
                <div class="carousel-inner">
                    {% for slider in sliders %}
                        <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                            <img src="{{ asset('uploads/sliders/' ~ slider.imageName) }}" class="home-hero-slide-img" alt="{{ slider.title }}">
                        </div>
                    {% endfor %}
                </div>
                <button class="carousel-control-prev home-hero-control" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Précédent</span>
                </button>
                <button class="carousel-control-next home-hero-control" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Suivant</span>
                </button>
            </div>
        {% endif %}

        <div class="home-hero-overlay">
            <div class="container home-hero-overlay-inner">
                <div class="home-hero-copy text-center text-white mx-auto">
                    <img class="home-hero-brand-logo" src="{{ asset('logo-souk-expat.png') }}" alt="SoukExpat — Le Marché Mondial des Expatriés" width="220" height="120" decoding="async" fetchpriority="high">
                    <h1 class="home-hero-title">Trouvez tout, partout.</h1>
                    <p class="home-hero-sub">Achetez et vendez entre expatriés au Maroc</p>
                </div>

                <form action="{{ path('app_home') }}" method="get" id="home-search-form" class="home-search" aria-label="Rechercher une annonce">
                    <div class="home-search__row">
                        <div class="home-search__field home-search__field--q">
                            <label class="visually-hidden" for="home-q">Recherche</label>
                            <i class="bi bi-search home-search__icon" aria-hidden="true"></i>
                            <input id="home-q" type="search" name="q" class="home-search__input" placeholder="Que cherchez-vous ?" value="{{ sf.q|default('') }}" autocomplete="off">
                        </div>
                        <div class="home-search__field home-search__field--select d-none d-md-flex">
                            <label class="visually-hidden" for="home-cat">Catégorie</label>
                            <select id="home-cat" name="category" class="home-search__select">
                                <option value="">Toutes catégories</option>
                                {% for cat in search_categories %}
                                    <option value="{{ cat.id }}" {{ sf.categoryId == cat.id ? 'selected' }}>{{ cat.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="home-search__field home-search__field--select d-none d-md-flex">
                            <label class="visually-hidden" for="home-city">Ville</label>
                            <select id="home-city" name="city" class="home-search__select">
                                <option value="">Toutes villes</option>
                                {% for city in cities %}
                                    <option value="{{ city.id }}" {{ sf.cityId == city.id ? 'selected' }}>{{ city.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="home-search__actions">
                            <button type="button" class="home-search__filters-btn d-md-none" data-bs-toggle="collapse" data-bs-target="#homeMobileFilters" aria-expanded="{{ has_filters ? 'true' : 'false' }}" aria-controls="homeMobileFilters" title="Filtres">
                                <i class="bi bi-sliders" aria-hidden="true"></i>
                            </button>
                            <button type="submit" class="btn btn-custom-cyan home-search__submit rounded-pill fw-bold">
                                Rechercher
                            </button>
                        </div>
                    </div>
                    <div class="collapse {{ has_filters ? 'show' : '' }} d-md-none" id="homeMobileFilters">
                        <div class="home-search__mobile-filters">
                            <select id="home-cat-m" class="form-select form-select-sm rounded-3">
                                <option value="">Catégorie</option>
                                {% for cat in search_categories %}
                                    <option value="{{ cat.id }}" {{ sf.categoryId == cat.id ? 'selected' }}>{{ cat.name }}</option>
                                {% endfor %}
                            </select>
                            <select id="home-city-m" class="form-select form-select-sm rounded-3">
                                <option value="">Ville</option>
                                {% for city in cities %}
                                    <option value="{{ city.id }}" {{ sf.cityId == city.id ? 'selected' }}>{{ city.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <main class="home-main">
        {# ——— CATÉGORIES (une ligne, défilement horizontal) ——— #}
        <section class="home-section home-section--categories" data-animate="fade-up">
            <div class="container">
                <div class="home-section__head">
                    <div>
                        <p class="home-section__eyebrow">Explorer</p>
                        <h2 class="home-section__title">Parcourir par catégorie</h2>
                    </div>
                    <a href="{{ path('app_annonce_index') }}" class="home-section__link">
                        Toutes les annonces <i class="bi bi-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
            </div>

            {% if popular_categories is empty %}
                <div class="container">
                    <p class="text-muted small mb-0">Les catégories apparaîtront ici dès qu’elles seront créées.</p>
                </div>
            {% else %}
                <div class="home-cat-track" role="region" aria-label="Catégories — faites glisser horizontalement">
                    <div class="home-cat-showcase">
                        {% for item in popular_categories %}
                            {% set category = item.category %}
                            {% set total = item.total %}
                            {% set icon = 'bi-tag-fill' %}
                            {% set tone = loop.index0 % 3 %}
                            {% if 'meuble' in category.slug or 'meuble' in category.name|lower %}
                                {% set icon = 'bi-lamp' %}
                            {% elseif 'electro' in category.slug or 'électro' in category.name|lower %}
                                {% set icon = 'bi-plug' %}
                            {% elseif 'vehicule' in category.slug or 'véhicule' in category.name|lower or 'auto' in category.slug %}
                                {% set icon = 'bi-bicycle' %}
                            {% elseif category.icon %}
                                {% set icon = category.icon %}
                            {% endif %}

                            <a href="{{ path('app_annonce_category', { slug: category.slug }) }}"
                               class="home-cat-card home-cat-card--tone-{{ tone }}"
                               aria-label="{{ category.name }} — {{ total|cap999 }} annonce{{ total > 1 ? 's' : '' }}">
                                <span class="home-cat-card__visual" aria-hidden="true">
                                    {% if category.imageName %}
                                        <img src="{{ asset('uploads/categories/' ~ category.imageName) }}" alt="" loading="lazy" decoding="async">
                                    {% else %}
                                        <i class="bi {{ icon }}"></i>
                                    {% endif %}
                                </span>
                                <span class="home-cat-card__body">
                                    <span class="home-cat-card__name">{{ category.name }}</span>
                                    <span class="home-cat-card__meta">
                                        {{ total|cap999 }} annonce{{ total > 1 ? 's' : '' }}
                                    </span>
                                </span>
                                <span class="home-cat-card__go" aria-hidden="true">
                                    <i class="bi bi-arrow-right"></i>
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </section>

        {# ——— ANNONCES ——— #}
        <section id="annonces-list" class="home-listings" data-animate="fade-up">
            <div class="container">
                <div class="home-section__head">
                    <div>
                        <p class="home-section__eyebrow">{% if has_filters %}Recherche{% else %}Marketplace{% endif %}</p>
                        <h2 class="home-section__title">
                            {% if has_filters %}Résultats de recherche{% else %}Annonces à découvrir{% endif %}
                        </h2>
                        <p class="home-section__lead">
                            {% if has_filters %}Annonces correspondant à vos filtres.{% else %}Les dernières opportunités de la communauté.{% endif %}
                        </p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="annonce-page-stat">
                            <i class="bi bi-layout-grid text-brand" aria-hidden="true"></i>
                            <strong>{{ annonces.getTotalItemCount|cap999 }}</strong>
                            annonce{{ annonces.getTotalItemCount > 1 ? 's' : '' }}
                        </span>
                        <a href="{{ path('app_annonce_new') }}" class="btn btn-sm btn-custom-cyan rounded-pill px-3">
                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Vendre
                        </a>
                    </div>
                </div>

                {{ include('layouts/_filter_chips.html.twig', {
                    sf: sf,
                    search_categories: search_categories,
                    cities: cities,
                    reset_url: path('app_home')
                }) }}

                <div class="row g-3 g-md-4">
                    {% for annonce in annonces %}
                        <div class="col-6 col-md-4 col-xl-3">
                            {{ include('annonce/_card.html.twig', {
                                annonce: annonce,
                                show_category: true,
                                eager: loop.index <= 4
                            }) }}
                        </div>
                    {% else %}
                        <div class="col-12">
                            <div class="annonce-empty-state text-center py-5 px-4">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm mb-3" style="width: 4.5rem; height: 4.5rem;">
                                    <i class="bi bi-search fs-2 text-brand opacity-75" aria-hidden="true"></i>
                                </div>
                                <h3 class="h5 fw-bold mb-2">{% if has_filters %}Aucun résultat{% else %}Aucune annonce pour le moment{% endif %}</h3>
                                <p class="text-muted mx-auto mb-4" style="max-width: 26rem;">
                                    {% if has_filters %}Essayez d’autres mots-clés ou effacez les filtres.{% else %}Soyez le premier à publier sur Expat Souk.{% endif %}
                                </p>
                                {% if has_filters %}
                                    <a href="{{ path('app_home') }}" class="btn btn-outline-secondary rounded-pill px-4 me-2">Réinitialiser</a>
                                {% endif %}
                                <a href="{{ path('app_annonce_new') }}" class="btn btn-custom-cyan rounded-pill px-4">Publier une annonce</a>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {% if annonces|length > 0 %}
                    <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-3 mt-5">
                        <nav aria-label="Pagination">
                            <div class="pagination-wrapper">
                                {{ knp_pagination_render(annonces) }}
                            </div>
                        </nav>
                        <a href="{{ path('app_annonce_index') }}" class="btn btn-outline-secondary rounded-pill px-4">
                            Voir le catalogue complet
                        </a>
                    </div>
                {% endif %}
            </div>
        </section>

        {# ——— CTA ——— #}
        {% if not has_filters %}
            <section class="home-cta container" data-animate="fade-up">
                <div class="home-cta__panel">
                    <div class="home-cta__copy">
                        <h2 class="home-cta__title">Vous avez quelque chose à vendre&nbsp;?</h2>
                        <p class="home-cta__text mb-0">Publiez une annonce en quelques minutes et rejoignez la communauté SoukExpat.</p>
                    </div>
                    <a href="{{ path('app_annonce_new') }}" class="btn btn-light rounded-pill px-4 fw-bold text-brand">
                        Déposer une annonce
                    </a>
                </div>
            </section>
        {% endif %}
    </main>

    <script>
        (function () {
            var heroForm = document.getElementById('home-search-form');
            if (!heroForm) return;
            heroForm.addEventListener('submit', function () {
                if (!window.matchMedia('(max-width: 767.98px)').matches) return;
                var catM = document.getElementById('home-cat-m');
                var cityM = document.getElementById('home-city-m');
                var catD = document.getElementById('home-cat');
                var cityD = document.getElementById('home-city');
                if (catM && catD) catD.value = catM.value;
                if (cityM && cityD) cityD.value = cityM.value;
            });
        })();
    </script>

    {{ include('layouts/footer.html.twig') }}
{% endblock %}
