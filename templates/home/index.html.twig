{% extends 'base.html.twig' %}

{% block title %}Accueil | Expat Souk - Petites annonces entre expatriés{% endblock %}

{% block body %}
    {{ include('layouts/navBar.html.twig') }}

    {# --- SECTION SLIDER --- #}
    {% if sliders is not empty %}
        <section class="slider-section mb-5">
            <div id="homeCarousel" class="carousel slide shadow-sm" data-bs-ride="carousel">
                <div class="carousel-inner rounded-bottom-4">
                    {% for slider in sliders %}
                        <div class="carousel-item {{ loop.first ? 'active' : '' }}" data-bs-interval="5000">
                            <img src="{{ asset('uploads/sliders/' ~ slider.imageName) }}" class="d-block w-100" alt="{{ slider.title }}" style="height: 450px; object-fit: cover;">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-25 rounded-3 p-3">
                                <h2 class="fw-bold">{{ slider.title }}</h2>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>
        </section>
    {% endif %}

    {# Barre de recherche superposée #}
        <div class="position-absolute top-50 start-50 translate-middle w-100 px-3" style="z-index: 10;">
            <div class="container">
                <div class="text-center text-white mb-4">
                    <h1 class="fw-bold display-4">Trouvez tout, partout.</h1>
                    <p class="fs-5">La communauté des expatriés vous attend.</p>
                </div>
                
                <div class="card border-0 shadow-lg p-3 rounded-pill mx-auto" style="max-width: 900px;">
                    <form action="{{ path('app_home') }}" method="get" class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-0"><i class="bi bi-search text-muted"></i></span>
                                <input type="text" name="q" class="form-control border-0 shadow-none" placeholder="Que cherchez-vous ?">
                            </div>
                        </div>
                        <div class="col-md-3 border-start">
                            <select name="category" class="form-select border-0 shadow-none">
                                <option value="">Toutes catégories</option>
                                {% for cat in popular_categories %}
                                    <option value="{{ cat.id }}">{{ cat.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-3 border-start">
                            <select name="city" class="form-select border-0 shadow-none">
                                <option value="">Toutes les villes</option>
                                {% for city in cities %}
                                    <option value="{{ city.id }}">{{ city.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold" style="background-color: #42B1CE; border: none;">
                                Rechercher
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <main class="container">
        
        {# --- SECTION CATÉGORIES POPULAIRES --- #}
        <section class="mb-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold text-dark">Que recherchez-vous ?</h3>
            </div>
            <div class="row g-3">
                {% for category in popular_categories %}
                    <div class="col-6 col-md-4 col-lg-2">
                        <a href="{{ path('app_annonce_category', {'slug': category.slug}) }}" class="text-decoration-none">
                            <div class="card h-100 border-0 shadow-sm category-card text-center p-3 rounded-4">
                                <div class="category-icon mb-2">
                                    <i class="bi bi-tag-fill fs-3" style="color: #42B1CE;"></i>
                                </div>
                                <h6 class="mb-0 text-dark small fw-bold">{{ category.name }}</h6>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </section>

        <hr class="my-5 opacity-25">

        {# --- SECTION ANNONCES PRINCIPALES (PAGINÉES) --- #}
        <section id="annonces-list">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 class="fw-bold mb-1">Dernières Annonces</h3>
                    <p class="text-muted small">Découvrez les opportunités récentes à travers le monde</p>
                </div>
                <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                    {{ annonces.getTotalItemCount }} annonces
                </span>
            </div>

            <div class="row g-4">
                {% for annonce in annonces %}
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm annonce-card rounded-4 overflow-hidden">
                            <div class="position-relative">
                                {# On utilise bien 'annonceImages' ici #}
                                {% if annonce.annonceImages|length > 0 %}
                                    {# ATTENTION : On doit aussi utiliser 'annonceImages' ici ! #}
                                    <img src="{{ asset('uploads/annonces/' ~ annonce.annonceImages[0].imadeName) }}" 
                                        class="card-img-top" 
                                        alt="{{ annonce.title }}" 
                                        style="height: 200px; object-fit: cover;">
                                {% else %}
                                    <img src="{{ asset('images/no-image.jpg') }}" 
                                        class="card-img-top" 
                                        alt="No Image" 
                                        style="height: 200px; object-fit: cover;">
                                {% endif %}
                                
                                <span class="position-absolute top-0 end-0 m-3 badge bg-white text-primary rounded-pill shadow-sm">
                                    {{ annonce.price }} MAD
                                </span>
                            </div>
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="small text-uppercase fw-bold text-muted">{{ annonce.category.name }}</span>
                                    <span class="small text-muted"><i class="bi bi-geo-alt"></i> {{ annonce.city.name }}</span>
                                </div>
                                <h6 class="card-title fw-bold mb-3">
                                    <a href="{{ path('app_annonce_show', {'id': annonce.id}) }}" class="text-dark text-decoration-none stretched-link">
                                        {{ annonce.title|u.truncate(45, '...') }}
                                    </a>
                                </h6>
                                <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-auto">
                                    <span class="small text-muted">{{ annonce.createdAt|date('d/m/Y') }}</span>
                                    <i class="bi bi-heart text-danger"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-search fs-1 text-muted opacity-50"></i>
                        <p class="mt-3 text-muted">Aucune annonce trouvée pour le moment.</p>
                    </div>
                {% endfor %}
            </div>

            {# --- PAGINATION --- #}
            <div class="d-flex justify-content-center mt-5 mb-5">
                <div class="pagination-container p-2 bg-white rounded-pill shadow-sm">
                    {{ knp_pagination_render(annonces) }}
                </div>
            </div>
        </section>

    </main>

    <style>
        .category-card {
            transition: all 0.3s ease;
        }
        .category-card:hover {
            transform: translateY(-5px);
            background-color: #f8fdff;
            border: 1px solid #42B1CE !important;
        }
        .annonce-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .annonce-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.1) !important;
        }
        /* Customisation Pagination pour Bootstrap 5 */
        .pagination {
            margin-bottom: 0;
            gap: 5px;
        }
        .page-item.active .page-link {
            background-color: #42B1CE;
            border-color: #42B1CE;
            border-radius: 50%;
        }
        .page-link {
            border: none;
            color: #42B1CE;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>

    {{ include('layouts/footer.html.twig') }}
{% endblock %}