{% extends 'base.html.twig' %}

{% block title %}Réinitialiser mon mot de passe - Expat Souk{% endblock %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}

<div class="container py-5">
    <div class="row justify-content-center align-items-center" style="min-height: 65vh;">
        <div class="col-md-6 col-lg-5 col-xl-4">
            
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                {# Header avec la couleur thématique #}
                <div class="p-4 text-center text-white" style="background-color: #42B1CE;">
                    <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-shield-lock-fill fs-1"></i>
                    </div>
                    <h2 class="fw-bold h4 mb-1">Mot de passe oublié ?</h2>
                    <p class="small mb-0 opacity-75">Pas d'inquiétude, nous allons vous aider.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    {# Erreurs jeton / réinitialisation : flashes gérés globalement (toasts via base) #}

                    <p class="text-muted small mb-3 text-center">
                        Saisissez l’adresse e-mail de votre compte. Nous vous enverrons un message depuis
                        <strong class="text-dark">{{ contact_email }}</strong> avec un lien sécurisé pour choisir un nouveau mot de passe.
                    </p>

                    {{ form_start(requestForm) }}
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase ms-1">Votre adresse email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-envelope text-muted"></i></span>
                                {{ form_widget(requestForm.email, {
                                    'attr': {
                                        'class': 'form-control form-control-lg border-0 bg-light shadow-none ps-0', 
                                        'placeholder': 'exemple@mail.com'
                                    }
                                }) }}
                            </div>
                            <div class="text-danger small mt-1">{{ form_errors(requestForm.email) }}</div>
                        </div>

                        <div class="d-grid mt-2">
                            <button type="submit" class="btn btn-cyan-reset btn-lg rounded-pill py-3 fw-bold shadow-sm">
                                Envoyer le lien <i class="bi bi-send-fill ms-2"></i>
                            </button>
                        </div>
                    {{ form_end(requestForm) }}

                    <div class="text-center mt-4 pt-3 border-top">
                        <a href="{{ path('app_login') }}" class="text-decoration-none small fw-bold hover-cyan" style="color: #6c757d;">
                            <i class="bi bi-arrow-left me-1"></i> Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* Style spécifique au bouton #42B1CE */
    .btn-cyan-reset {
        background-color: #42B1CE;
        border: none;
        color: white;
        transition: all 0.3s ease;
    }
    .btn-cyan-reset:hover {
        background-color: #369ab3;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(66, 177, 206, 0.2) !important;
    }

    /* Focus sur l'input */
    .form-control:focus {
        background-color: #ffffff !important;
        border: 1px solid #42B1CE !important;
        box-shadow: 0 0 0 0.25rem rgba(66, 177, 206, 0.1) !important;
    }

    .input-group-text {
        border-right: none !important;
    }

    .hover-cyan:hover {
        color: #42B1CE !important;
    }

    /* Animation */
    .card {
        animation: fadeInUp 0.5s ease-out;
    }
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(15px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
{% endblock %}