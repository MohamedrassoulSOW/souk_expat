{% extends 'emails/_layout.html.twig' %}

{% block title %}{% if approved %}Annonce validée{% else %}Annonce refusée{% endif %}{% endblock %}

{% block body %}
    <h2>Bonjour {{ user.firstName|default('') }},</h2>

    {% if approved %}
        <p>Bonne nouvelle : votre annonce a été <strong>validée</strong> par notre équipe.</p>
        <p>Elle est maintenant visible par tous les visiteurs de {{ site ? site.siteName : 'SoukExpat' }}.</p>
    {% else %}
        <p>Votre annonce a été <strong>refusée</strong> par notre équipe de modération.</p>
        <p>Vous pouvez la modifier, puis la soumettre à nouveau depuis votre espace « Mes annonces ».</p>
    {% endif %}

    <div class="meta">
        <strong>Annonce :</strong> {{ annonce.title }}<br>
        {% if annonce.price is defined %}
            <strong>Prix :</strong> {{ annonce.price|number_format(0, ',', ' ') }} MAD<br>
        {% endif %}
        {% if annonce.city %}
            <strong>Ville :</strong> {{ annonce.city.name }}
        {% endif %}
    </div>

    {% if approved and annonceUrl %}
        <div class="button-wrapper">
            <a class="button" href="{{ annonceUrl }}">Voir mon annonce en ligne</a>
        </div>
    {% elseif not approved and mesAnnoncesUrl %}
        <div class="button-wrapper">
            <a class="button" href="{{ mesAnnoncesUrl }}">Modifier mon annonce</a>
        </div>
    {% endif %}

    <p>Cet e-mail a été envoyé depuis <strong>{{ siteContactEmail }}</strong>. Vous pouvez répondre directement si besoin.</p>
{% endblock %}
