{% extends 'base.html.twig' %}

{% block title %}Sécurité - Expat-Souk{% endblock %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            
            {# Retour profil #}
            <div class="mb-4">
                <a href="{{ path('app_profile') }}" class="text-decoration-none text-muted small fw-bold hover-cyan">
                    <i class="bi bi-chevron-left"></i> RETOUR AU PROFIL
                </a>
            </div>

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                {# Header Sécurité Stylisé #}
                <div class="p-4 text-center text-white" style="background-color: #42B1CE;">
                    <div class="bg-white bg-opacity-25 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-shield-lock-fill text-white fs-1"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Sécurité du compte</h3>
                    <p class="small mb-0 opacity-75">Protégez votre accès à Expat-Souk</p>
                </div>
                
                <div class="card-body p-4 p-md-5 bg-white">
                    {# Messages de succès/erreur #}
                    {% for label, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} border-0 shadow-sm rounded-3 mb-4 py-3">
                                <i class="bi {{ label == 'danger' ? 'bi-exclamation-circle' : 'bi-check-circle' }} me-2"></i>
                                {{ message }}
                            </div>
                        {% endfor %}
                    {% endfor %}

                    {{ form_start(passwordForm) }}
                        {% if isGoogleOnly|default(false) %}
                            <div class="alert alert-info border-0 small mb-4">
                                Compte Google : créez un mot de passe optionnel pour aussi vous connecter par e-mail.
                            </div>
                        {% endif %}

                        {% if passwordForm.oldPassword is defined %}
                        {# Mot de passe actuel #}
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Mot de passe actuel</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-key text-muted"></i></span>
                                {{ form_widget(passwordForm.oldPassword, {'attr': {'class': 'form-control form-control-lg border-0 bg-light-subtle shadow-none', 'placeholder': '••••••••'}}) }}
                            </div>
                            <div class="text-danger small">{{ form_errors(passwordForm.oldPassword) }}</div>
                        </div>
                        {% endif %}

                        <div class="d-flex align-items-center my-4">
                            <hr class="flex-grow-1 opacity-10">
                            <span class="mx-3 small text-muted text-uppercase fw-bold" style="font-size: 0.65rem;">Nouveau mot de passe</span>
                            <hr class="flex-grow-1 opacity-10">
                        </div>

                        {# Nouveau mot de passe (First) #}
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Nouveau mot de passe</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-lock-fill text-muted"></i></span>
                                {{ form_widget(passwordForm.newPassword.first, {'attr': {'class': 'form-control form-control-lg border-0 bg-light-subtle shadow-none', 'placeholder': 'Minimum 8 caractères'}}) }}
                            </div>
                            <div class="form-text small mt-2">Utilisez des chiffres et des symboles pour plus de sécurité.</div>
                        </div>

                        {# Confirmation (Second) #}
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Confirmer le nouveau mot de passe</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-shield-check text-muted"></i></span>
                                {{ form_widget(passwordForm.newPassword.second, {'attr': {'class': 'form-control form-control-lg border-0 bg-light-subtle shadow-none', 'placeholder': 'Répétez le mot de passe'}}) }}
                            </div>
                        </div>

                        {# Bouton de validation #}
                        <div class="d-grid mt-5">
                            <button type="submit" class="btn btn-cyan-security btn-lg rounded-pill fw-bold shadow-sm py-3">
                                Mettre à jour le mot de passe <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </div>
                    {{ form_end(passwordForm) }}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* --- Couleurs et Styles Custom --- */
    .bg-light-subtle {
        background-color: #f8f9fa;
    }

    .btn-cyan-security {
        background-color: #42B1CE;
        border: none;
        color: white;
        transition: all 0.3s ease;
    }
    .btn-cyan-security:hover {
        background-color: #369ab3;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(66, 177, 206, 0.25) !important;
    }

    /* Focus stylisé #42B1CE */
    .form-control:focus {
        background-color: #ffffff !important;
        border: 1px solid #42B1CE !important;
        box-shadow: 0 0 0 0.25rem rgba(66, 177, 206, 0.1) !important;
    }

    .input-group-text {
        border: none;
    }

    .hover-cyan:hover {
        color: #42B1CE !important;
    }

    /* Animation d'alerte */
    .alert {
        animation: slideDown 0.4s ease-out;
    }
    @keyframes slideDown {
        from { transform: translateY(-10px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
</style>

{{ include('layouts/footer.html.twig') }}
{% endblock %}