{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Expat-Souk{% endblock %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}

<div class="container pt-4 pt-md-5 mt-2 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            {{ include('layouts/_page_header.html.twig', {
                eyebrow: 'Mon compte',
                title_html: 'Mon <span class="text-brand">profil</span>',
                lead: 'Gérez votre identité, votre photo et vos paramètres.',
                breadcrumbs: [
                    { label: 'Accueil', url: path('app_home') },
                    { label: 'Profil' }
                ],
                actions: '<a href="' ~ path('app_profile_edit') ~ '" class="btn btn-custom-cyan btn-icon-action" title="Modifier" aria-label="Modifier"><i class="bi bi-pencil" aria-hidden="true"></i></a>'
            }) }}

            {# Messages Flash Stylisés #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'danger' ? 'danger' : 'success' }} border-0 shadow-sm rounded-4 alert-dismissible fade show mb-4 py-3">
                        <i class="bi {{ label == 'danger' ? 'bi-exclamation-triangle' : 'bi-check-circle' }} me-2"></i>
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                {# Header avec Dégradé Custom #}
                <div class="profile-header-custom"></div>
                
                <div class="card-body pt-0 px-4 px-md-5 pb-5">
                    {# Avatar Section #}
                    <div class="text-center avatar-container-custom mb-4">
                        <div class="d-inline-block position-relative">
                            <img src="{{ user.avatar ? asset('uploads/avatars/' ~ user.avatar) : asset('uploads/avatars/avatar.png') }}"
                                 class="rounded-circle avatar-img-custom shadow bg-white" 
                                 id="avatarPreview" alt="Avatar">
                            
                            {# Formulaire Avatar #}
                            {{ form_start(formAvatar, {'action': path('app_profile_avatar_update'), 'attr': {'id': 'avatarForm'}}) }}
                                {{ form_widget(formAvatar.avatar, {'attr': {'class': 'd-none', 'id': 'avatarInput'}}) }}
                                <button type="button" id="btnTriggerUpload"
                                        class="btn btn-cyan-round position-absolute bottom-0 end-0 shadow border border-3 border-white">
                                    <i class="bi bi-camera-fill"></i>
                                </button>
                            {{ form_end(formAvatar) }}
                        </div>
                        <h2 class="fw-bold mt-3 mb-0 text-dark">{{ user.firstName }} {{ user.lastName }}</h2>
                        <p class="text-muted"><i class="bi bi-envelope-at me-1"></i> {{ user.email }}</p>
                    </div>

                    <div class="row g-4 mt-2">
                        {# Détails #}
                        <div class="col-12 col-md-7">
                            <div class="bg-light-cyan rounded-4 p-3 p-md-4 h-100 border shadow-sm">
                                <h6 class="fw-bold mb-4 text-dark text-uppercase small letter-spacing">Détails personnels</h6>
                                <div class="row g-3">
                                    <div class="col-12 col-sm-6 border-end border-sm-end border-0">
                                        <label class="info-label">Prénom</label>
                                        <p class="fs-6 fw-bold text-dark mb-0">{{ user.firstName }}</p>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <label class="info-label">Nom</label>
                                        <p class="fs-6 fw-bold text-dark mb-0">{{ user.lastName }}</p>
                                    </div>
                                    <div class="col-12 mt-4 pt-3 border-top">
                                        <label class="info-label">E-mail</label>
                                        <p class="mb-0 fw-medium text-dark"><i class="bi bi-envelope-at me-2 text-brand"></i>{{ user.email }}</p>
                                    </div>
                                    <div class="col-12 mt-3">
                                        <label class="info-label">WhatsApp</label>
                                        {% if user.whatsappPhone %}
                                            {% set wa_href = user.whatsappPhone|whatsapp_url %}
                                            <p class="mb-0 fw-medium text-dark">
                                                <i class="bi bi-whatsapp me-2 text-success"></i>
                                                {% if wa_href != '#' %}
                                                    <a href="{{ wa_href }}" class="text-decoration-none text-dark" target="_blank" rel="noopener noreferrer">{{ user.whatsappPhone }}</a>
                                                {% else %}
                                                    {{ user.whatsappPhone }}
                                                {% endif %}
                                            </p>
                                        {% else %}
                                            <p class="mb-0 text-muted small">
                                                Non renseigné —
                                                <a href="{{ path('app_profile_edit') }}" class="text-brand fw-semibold text-decoration-none">ajouter un numéro</a>
                                                pour que les acheteurs puissent vous écrire.
                                            </p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Actions #}
                        <div class="col-12 col-md-5">
                            <div class="d-grid gap-2 h-100">
                                <a href="{{ path('app_profile_edit') }}" class="btn btn-action-profile py-3 px-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-person-gear me-2"></i> Éditer le profil</span>
                                        <i class="bi bi-chevron-right small opacity-50"></i>
                                    </div>
                                </a>
                                <a href="{{ path('app_profile_password') }}" class="btn btn-action-profile-outline py-3 px-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-lock me-2"></i> Mot de passe</span>
                                        <i class="bi bi-chevron-right small opacity-50"></i>
                                    </div>
                                </a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_2fa_setup') }}" class="btn btn-action-profile-outline py-3 px-4">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-shield-lock me-2"></i> Double authentification</span>
                                            <i class="bi bi-chevron-right small opacity-50"></i>
                                        </div>
                                    </a>
                                {% endif %}
                                <a href="{{ path('app_how_it_works') }}#videos" class="btn btn-action-profile-outline py-3 px-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span><i class="bi bi-play-btn me-2"></i> Vidéo-Tuto</span>
                                        <i class="bi bi-chevron-right small opacity-50"></i>
                                    </div>
                                </a>
                                {% if user.avatar %}
                                    <form method="post" action="{{ path('app_profile_avatar_delete') }}" class="text-center mt-2" onsubmit="return confirm('Supprimer la photo ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_avatar') }}">
                                        <button type="submit" class="btn btn-outline-danger btn-icon-action" title="Supprimer l'avatar" aria-label="Supprimer l'avatar">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Statistiques #}
            <div class="row mt-4 g-3 text-center">
                <div class="col-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 stat-card-hover">
                        <div class="mb-2"><i class="bi bi-megaphone display-6 text-brand"></i></div>
                        <h4 class="fw-bold mb-0">{{ user.annonces|length|cap999 }}</h4>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Annonces</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 stat-card-hover">
                        <div class="mb-2"><i class="bi bi-chat-dots display-6 text-brand"></i></div>
                        <h4 class="fw-bold mb-0">{{ user.messagesAsSender|length }}</h4>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Messages</small>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .profile-header-custom {
        height: 140px;
        background: linear-gradient(135deg, var(--cyan-main) 0%, var(--cyan-hover) 100%);
    }
    .avatar-container-custom { margin-top: -70px; }
    .avatar-img-custom {
        width: 140px; height: 140px;
        object-fit: cover; border: 5px solid var(--surface);
    }
    
    @media (max-width: 768px) {
        .profile-header-custom {
            height: 100px;
        }
        .avatar-container-custom { 
            margin-top: -50px; 
        }
        .avatar-img-custom {
            width: 100px; 
            height: 100px;
            border: 4px solid var(--surface);
        }
        .btn-cyan-round {
            width: 32px;
            height: 32px;
            font-size: 0.875rem;
        }
    }
    .btn-cyan-round {
        background-color: var(--cyan-main);
        color: white; border-radius: 50%;
        width: 40px; height: 40px;
        display: flex; align-items: center; justify-content: center;
    }
    .btn-cyan-round:hover { background-color: var(--cyan-hover); color: white; }
    
    .bg-light-cyan { background-color: color-mix(in srgb, var(--cyan-main) 10%, var(--surface)); }
    .info-label { font-size: 0.65rem; color: var(--text-muted-custom); font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
    
    .btn-action-profile {
        background-color: var(--cyan-hover); color: white;
        border-radius: 15px; border: none; transition: 0.3s;
        font-weight: 600;
    }
    .btn-action-profile:hover { background-color: var(--cyan-main); transform: translateX(5px); color: white; }
    
    .btn-action-profile-outline {
        background-color: transparent; color: var(--text-strong);
        border-radius: 15px; border: 2px solid var(--border-soft); transition: 0.3s;
        font-weight: 600;
    }
    .btn-action-profile-outline:hover { border-color: var(--cyan-main); color: var(--cyan-main); }

    .stat-card-hover { transition: 0.3s; border: 1px solid transparent !important; }
    .stat-card-hover:hover { transform: translateY(-5px); border-color: var(--cyan-main) !important; }
    
    .hover-cyan:hover { color: var(--cyan-main) !important; }
    .letter-spacing { letter-spacing: 1.5px; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('btnTriggerUpload');
        const input = document.getElementById('avatarInput');
        if (btn && input) {
            btn.addEventListener('click', () => input.click());
            input.addEventListener('change', () => {
                if (input.files && input.files[0]) {
                    document.getElementById('avatarPreview').style.opacity = '0.5';
                    document.getElementById('avatarForm').submit();
                }
            });
        }
    });
</script>

{{ include('layouts/footer.html.twig') }}
{% endblock %}