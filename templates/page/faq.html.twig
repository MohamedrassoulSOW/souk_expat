{% extends 'page/static_base.html.twig' %}

{% block title %}FAQ — {{ site ? site.siteName : 'SoukExpat' }}{% endblock %}

{% block page_badge %}FAQ{% endblock %}
{% block page_heading %}Questions fréquentes{% endblock %}
{% block page_lead %}{{ site ? site.faqLead : 'Les réponses aux demandes les plus courantes.' }}{% endblock %}

{% block static_body %}
{% set faqs = site ? site.faqItems : [] %}
<div class="accordion accordion-flush shadow-sm rounded-4 overflow-hidden border" id="faqAccordion" style="border-color: rgba(66, 177, 206, 0.22) !important;">
    {% for item in faqs %}
        <div class="accordion-item border-0 border-bottom" style="border-color: rgba(0,0,0,.06) !important;">
            <h2 class="accordion-header" id="faqHeading{{ loop.index }}">
                <button class="accordion-button {{ loop.first ? '' : 'collapsed' }} fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse{{ loop.index }}" aria-expanded="{{ loop.first ? 'true' : 'false' }}" aria-controls="faqCollapse{{ loop.index }}">
                    <i class="bi bi-patch-question-fill text-cyan-brand me-2"></i>{{ item.q }}
                </button>
            </h2>
            <div id="faqCollapse{{ loop.index }}" class="accordion-collapse collapse {{ loop.first ? 'show' : '' }}" aria-labelledby="faqHeading{{ loop.index }}" data-bs-parent="#faqAccordion">
                <div class="accordion-body text-secondary small">{{ item.a }}</div>
            </div>
        </div>
    {% else %}
        <div class="p-4 text-muted">Aucune question pour le moment.</div>
    {% endfor %}
</div>

<div class="mt-5 p-4 rounded-4 text-center static-card-soft">
    <p class="mb-2 fw-semibold text-dark">Vous ne trouvez pas votre réponse ?</p>
    <a href="{{ path('app_contact') }}" class="btn text-white px-4" style="background: #42B1CE; border-color: #42B1CE;">Contactez le support</a>
</div>
{% endblock %}
