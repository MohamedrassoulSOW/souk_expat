{% extends 'page/static_base.html.twig' %}

{% block title %}Vidéo-Tuto — {{ site ? site.siteName : 'SoukExpat' }}{% endblock %}

{% block guide_videos_hint %}{% endblock %}

{% block page_badge %}Vidéo-Tuto{% endblock %}
{% block page_heading %}Tutoriels vidéo pour utiliser la plateforme{% endblock %}
{% block page_lead %}{{ site ? site.howItWorksLead : 'Achetez et vendez entre expatriés au Maroc, en quelques étapes simples.' }}{% endblock %}

{% block static_body %}
{% set steps = site ? site.howItWorksSteps : [] %}
{% set brand = site ? site.siteName : 'SoukExpat' %}

{# Sommaire rapide #}
<nav class="guide-toc mb-5" aria-label="Sommaire du guide">
    <a href="#videos" class="guide-toc__link">Vidéo-Tuto</a>
    <a href="#vue-ensemble" class="guide-toc__link">Vue d’ensemble</a>
    <a href="#acheter" class="guide-toc__link">Acheter</a>
    <a href="#vendre" class="guide-toc__link">Vendre</a>
    <a href="#messagerie" class="guide-toc__link">Messagerie</a>
    <a href="#securite" class="guide-toc__link">Sécurité</a>
</nav>

{# Ordre = numérotation des Vidéo-Tuto (1→7) #}
{% set guideVideos = [
    {
        id: 'video-mobile',
        file: 'soukexpat-tutoriel-mobile.mp4',
        poster: 'soukexpat-tutoriel-mobile.jpg',
        title: 'Découvrir SoukExpat',
        audience: 'Pour commencer',
        duration: '≈ 3 min',
        text: 'Le premier tutoriel à regarder : page d’accueil, catégories, recherche, fiche annonce, contact vendeur et conseils de sécurité. Une visite guidée pour comprendre la plateforme en quelques minutes.',
        points: [
            'Découvrir l’accueil et la navigation',
            'Rechercher un produit et ouvrir une annonce',
            'Contacter un vendeur en toute sécurité'
        ]
    },
    {
        id: 'video-user',
        file: 'soukexpat-guide-user.mp4',
        poster: 'soukexpat-guide-user.jpg',
        title: 'Parcourir & vendre',
        audience: 'Guide utilisateur',
        duration: 'Guide complet',
        text: 'Le parcours membre : se connecter, parcourir les annonces, contacter un vendeur, publier sa propre annonce avec photos et prix, puis suivre le statut dans Mes annonces.',
        points: [
            'Parcourir les annonces et contacter un vendeur',
            'Déposer une annonce (photos, prix, ville)',
            'Suivre ses publications dans Mes annonces'
        ]
    },
    {
        id: 'video-editor',
        file: 'soukexpat-guide-editor.mp4',
        poster: 'soukexpat-guide-editor.jpg',
        title: 'Modérer les annonces',
        audience: 'Guide éditeur',
        duration: 'Guide interne',
        text: 'Réservé à l’équipe éditoriale : tableau de bord, file des annonces en attente à valider ou refuser, catégories, villes, contacts, conversations, slider et paramètres — sans gestion des comptes.',
        points: [
            'Valider ou refuser les annonces en attente',
            'Gérer catégories, villes, slider et contacts',
            'Sans accès à la gestion des comptes'
        ]
    },
    {
        id: 'video-admin',
        file: 'soukexpat-guide-admin.mp4',
        poster: 'soukexpat-guide-admin.jpg',
        title: 'Gérer la plateforme',
        audience: 'Guide admin',
        duration: 'Guide interne',
        text: 'Le rôle administrateur : tout ce qu’un éditeur peut faire, plus la gestion des utilisateurs (rôles, blocage), le suivi global via analytics et le rapport d’annonces.',
        points: [
            'Gérer les utilisateurs et leurs rôles',
            'Suivre l’activité via analytics et rapports',
            'Piloter l’ensemble des réglages du site'
        ]
    },
    {
        id: 'video-messaging',
        file: 'soukexpat-guide-messaging.mp4',
        poster: 'soukexpat-guide-messaging.jpg',
        title: 'Validation & messages',
        audience: 'Messagerie',
        duration: 'Guide complet',
        text: 'Après la publication : l’annonce passe en attente, puis est validée ou refusée. Notifications, e-mails, puis messagerie interne liée à l’annonce (texte, photos, position).',
        points: [
            'Cycle d’une annonce : en attente, validée, refusée',
            'Notifications dans l’app et e-mails reçus',
            'Échanger par message : texte, photos, position'
        ]
    },
    {
        id: 'video-profile',
        file: 'soukexpat-guide-profile.mp4',
        poster: 'soukexpat-guide-profile.jpg',
        title: 'Profil & mot de passe',
        audience: 'Compte',
        duration: 'Guide pratique',
        text: 'Mettre à jour son profil (photo, WhatsApp, infos) et récupérer un accès perdu : mot de passe oublié, e-mail de réinitialisation, puis changement de mot de passe depuis Mon profil.',
        points: [
            'Compléter son profil pour rassurer les acheteurs',
            'Réinitialiser un mot de passe oublié',
            'Changer son mot de passe depuis son espace'
        ]
    },
    {
        id: 'video-pwa',
        file: 'soukexpat-guide-pwa.mp4',
        poster: 'soukexpat-guide-pwa.jpg',
        title: 'Responsive & PWA',
        audience: 'Application',
        duration: 'Guide pratique',
        text: 'SoukExpat s’adapte à tous les écrans et s’installe comme une application : Android via la bannière, iPhone/iPad avec « Sur l’écran d’accueil », ordinateur avec Chrome ou Edge.',
        points: [
            'Android : installer depuis la bannière',
            'iPhone / iPad : Partager → Sur l’écran d’accueil',
            'Ordinateur : installation Chrome ou Edge'
        ]
    }
] %}

<section id="videos" class="mb-5">
    <h2 class="guide-section-title">Vidéo-Tuto</h2>
    <p class="text-secondary mb-4">
        Ces tutoriels suivent l’ordre logique d’utilisation de {{ brand }} : commencez par la première pour découvrir
        la plateforme, puis avancez selon vos besoins. Cliquez sur une vidéo pour la lire en grand,
        ou téléchargez-la pour la regarder hors ligne.
    </p>

    <div class="guide-video-list" data-guide-video-list>
        {% for video in guideVideos %}
            <article class="guide-video-row" id="{{ video.id }}">
                <div class="row g-4 align-items-center">
                    <div class="col-12 col-md-5 col-xl-4">
                        <button
                            type="button"
                            class="guide-video-thumb"
                            data-guide-video
                            data-video-src="{{ asset('videos/guide/' ~ video.file) }}"
                            data-video-poster="{{ asset('videos/guide/posters/' ~ video.poster) }}"
                            data-video-title="{{ video.title }}"
                            aria-label="Lire en grand : {{ video.title }}"
                        >
                            <img
                                class="guide-video-thumb__media"
                                src="{{ asset('videos/guide/posters/' ~ video.poster) }}"
                                alt="Couverture de la vidéo : {{ video.title }}"
                                width="1080"
                                height="1920"
                                loading="lazy"
                                decoding="async"
                            >
                            <span class="guide-video-thumb__overlay">
                                <span class="guide-video-thumb__hint">
                                    <i class="bi bi-play-circle me-1" aria-hidden="true"></i>Lire en grand
                                </span>
                            </span>
                        </button>
                    </div>
                    <div class="col-12 col-md-7 col-xl-8">
                        <div class="guide-video-row__body">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <span class="guide-video-row__num">{{ loop.index }}</span>
                                <span class="badge rounded-pill guide-step-badge">{{ video.audience }}</span>
                                <span class="badge rounded-pill guide-video-row__meta">{{ video.duration }}</span>
                            </div>
                            <h3 class="h4 fw-bold mb-2">{{ video.title }}</h3>
                            <p class="text-secondary mb-3">{{ video.text }}</p>
                            <ul class="guide-video-row__points list-unstyled mb-3">
                                {% for point in video.points %}
                                    <li><i class="bi bi-check2-circle" aria-hidden="true"></i> {{ point }}</li>
                                {% endfor %}
                            </ul>
                            <div class="d-flex flex-wrap gap-2">
                                <button
                                    type="button"
                                    class="btn btn-sm btn-custom-cyan rounded-pill px-3"
                                    data-guide-video
                                    data-video-src="{{ asset('videos/guide/' ~ video.file) }}"
                                    data-video-poster="{{ asset('videos/guide/posters/' ~ video.poster) }}"
                                    data-video-title="{{ video.title }}"
                                >
                                    <i class="bi bi-play-fill me-1" aria-hidden="true"></i>Lire
                                </button>
                                <a
                                    class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                    href="{{ asset('videos/guide/' ~ video.file) }}"
                                    download="{{ video.file }}"
                                    title="Télécharger {{ video.title }}"
                                >
                                    <i class="bi bi-download me-1" aria-hidden="true"></i>Télécharger
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        {% endfor %}
    </div>
</section>

{# Lecteur agrandi #}
<div class="modal fade" id="guideVideoModal" tabindex="-1" aria-labelledby="guideVideoModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered guide-video-modal__dialog">
        <div class="modal-content border-0 rounded-4 overflow-hidden guide-video-modal__content">
            <div class="modal-header border-0 pb-2">
                <h2 class="h6 fw-bold mb-0 text-white" id="guideVideoModalTitle">Vidéo-Tuto</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body pt-0 pb-3 d-flex justify-content-center">
                <video
                    id="guideVideoModalPlayer"
                    class="guide-video-modal__media"
                    controls
                    playsinline
                    preload="none"
                ></video>
            </div>
            <div class="modal-footer border-0 pt-0 pb-3 justify-content-center">
                <a
                    id="guideVideoModalDownload"
                    class="btn btn-sm btn-outline-light rounded-pill px-3"
                    href="#"
                    download
                >
                    <i class="bi bi-download me-1" aria-hidden="true"></i>Télécharger la vidéo
                </a>
            </div>
        </div>
    </div>
</div>

<section id="vue-ensemble" class="mb-5">
    <h2 class="guide-section-title">Vue d’ensemble</h2>
    <p class="text-secondary mb-4">
        {{ brand }} est une marketplace communautaire : vous publiez ou consultez des annonces,
        puis vous contactez l’autre membre. La plateforme met en relation — elle ne gère ni paiement ni livraison.
    </p>
    <div class="row g-3 g-md-4">
        {% for s in steps %}
            <div class="col-12 col-md-6">
                <div class="p-4 h-100 static-card-soft">
                    <div class="d-flex align-items-start gap-3">
                        <div class="static-icon-circle flex-shrink-0">
                            <i class="bi {{ s.icon|default('bi-circle') }}" aria-hidden="true"></i>
                        </div>
                        <div>
                            <span class="badge rounded-pill mb-2 guide-step-badge">Étape {{ loop.index }}</span>
                            <h3 class="h5 fw-bold mb-2">{{ s.title }}</h3>
                            <p class="text-secondary mb-0 small">{{ s.text }}</p>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <p class="text-muted">Les étapes seront bientôt disponibles.</p>
            </div>
        {% endfor %}
    </div>
</section>

<section id="acheter" class="mb-5">
    <h2 class="guide-section-title">Comment acheter</h2>
    <ol class="guide-steps list-unstyled mb-0">
        <li class="guide-steps__item">
            <span class="guide-steps__num" aria-hidden="true">1</span>
            <div>
                <h3 class="h6 fw-bold mb-1">Parcourir les annonces</h3>
                <p class="text-secondary small mb-0">
                    Depuis l’accueil ou <a href="{{ path('app_annonce_index') }}">Annonces</a>, filtrez par catégorie, ville ou mots-clés.
                </p>
            </div>
        </li>
        <li class="guide-steps__item">
            <span class="guide-steps__num" aria-hidden="true">2</span>
            <div>
                <h3 class="h6 fw-bold mb-1">Ouvrir une fiche</h3>
                <p class="text-secondary small mb-0">
                    Consultez photos, prix (MAD), description et le profil public du vendeur.
                </p>
            </div>
        </li>
        <li class="guide-steps__item">
            <span class="guide-steps__num" aria-hidden="true">3</span>
            <div>
                <h3 class="h6 fw-bold mb-1">Contacter le vendeur</h3>
                <p class="text-secondary small mb-0">
                    Connectez-vous, puis utilisez la messagerie {{ brand }} et/ou WhatsApp si le vendeur l’a renseigné.
                </p>
            </div>
        </li>
        <li class="guide-steps__item">
            <span class="guide-steps__num" aria-hidden="true">4</span>
            <div>
                <h3 class="h6 fw-bold mb-1">Conclure en personne</h3>
                <p class="text-secondary small mb-0">
                    Convenez d’un lieu sûr, vérifiez le bien, puis payez uniquement après réception.
                </p>
            </div>
        </li>
    </ol>
</section>

<section id="vendre" class="mb-5">
    <h2 class="guide-section-title">Comment vendre</h2>
    <ol class="guide-steps list-unstyled mb-0">
        <li class="guide-steps__item">
            <span class="guide-steps__num" aria-hidden="true">1</span>
            <div>
                <h3 class="h6 fw-bold mb-1">Créer un compte</h3>
                <p class="text-secondary small mb-0">
                    <a href="{{ path('app_register') }}">Inscrivez-vous</a>, complétez votre profil (photo, WhatsApp optionnel) pour rassurer les acheteurs.
                </p>
            </div>
        </li>
        <li class="guide-steps__item">
            <span class="guide-steps__num" aria-hidden="true">2</span>
            <div>
                <h3 class="h6 fw-bold mb-1">Publier une annonce</h3>
                <p class="text-secondary small mb-0">
                    Cliquez sur <strong>Vendre</strong> : titre, description, prix, photos, catégorie et ville.
                </p>
            </div>
        </li>
        <li class="guide-steps__item">
            <span class="guide-steps__num" aria-hidden="true">3</span>
            <div>
                <h3 class="h6 fw-bold mb-1">Attendre la validation</h3>
                <p class="text-secondary small mb-0">
                    L’annonce passe en modération. Vous recevez une notification dès qu’elle est approuvée ou refusée.
                    Suivez l’état dans <a href="{{ path('app_mes_annonces') }}">Mes annonces</a>.
                </p>
            </div>
        </li>
        <li class="guide-steps__item">
            <span class="guide-steps__num" aria-hidden="true">4</span>
            <div>
                <h3 class="h6 fw-bold mb-1">Répondre aux messages</h3>
                <p class="text-secondary small mb-0">
                    Répondez vite, précisez l’état du bien et organisez la remise en personne.
                </p>
            </div>
        </li>
    </ol>
</section>

<section id="messagerie" class="mb-5">
    <h2 class="guide-section-title">Messagerie &amp; contact</h2>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="p-4 h-100 static-card-soft text-center">
                <div class="static-icon-circle mx-auto mb-3"><i class="bi bi-chat-dots" aria-hidden="true"></i></div>
                <h3 class="h6 fw-bold">Messagerie {{ brand }}</h3>
                <p class="text-secondary small mb-0">Texte, photos et partage de position dans une conversation liée à l’annonce.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 h-100 static-card-soft text-center">
                <div class="static-icon-circle mx-auto mb-3"><i class="bi bi-whatsapp" aria-hidden="true"></i></div>
                <h3 class="h6 fw-bold">WhatsApp</h3>
                <p class="text-secondary small mb-0">Si le vendeur l’a ajouté à son profil, contactez-le aussi via WhatsApp.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 h-100 static-card-soft text-center">
                <div class="static-icon-circle mx-auto mb-3"><i class="bi bi-bell" aria-hidden="true"></i></div>
                <h3 class="h6 fw-bold">Notifications</h3>
                <p class="text-secondary small mb-0">Soyez informé de la validation de vos annonces et des échanges importants.</p>
            </div>
        </div>
    </div>
</section>

<section id="securite" class="mb-5">
    <h2 class="guide-section-title">Conseils de sécurité</h2>
    <ul class="guide-safety list-unstyled mb-0">
        <li><i class="bi bi-check2-circle" aria-hidden="true"></i> Ne payez jamais avant d’avoir reçu et vérifié le produit.</li>
        <li><i class="bi bi-check2-circle" aria-hidden="true"></i> Rencontrez-vous dans un lieu public et fréquenté.</li>
        <li><i class="bi bi-check2-circle" aria-hidden="true"></i> Méfiez-vous des prix trop bas ou des demandes de paiement anticipé.</li>
        <li><i class="bi bi-check2-circle" aria-hidden="true"></i> {{ brand }} ne gère pas les paiements, livraisons ni litiges entre particuliers.</li>
        <li><i class="bi bi-check2-circle" aria-hidden="true"></i> Signalez une annonce douteuse via le <a href="{{ path('app_contact') }}">formulaire de contact</a>.</li>
    </ul>
</section>

<div class="text-center p-4 p-md-5 rounded-4 border guide-cta">
    <h3 class="h5 fw-bold mb-2">Prêt à commencer ?</h3>
    <p class="text-secondary mb-4">Rejoignez la communauté {{ brand }} ou consultez la FAQ.</p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a href="{{ path('app_annonce_index') }}" class="btn btn-lg text-white border-0 px-4 rounded-pill about-btn-brand">Voir les annonces</a>
        {% if not app.user %}
            <a href="{{ path('app_register') }}" class="btn btn-lg btn-outline-secondary rounded-pill px-4">Créer un compte</a>
        {% else %}
            <a href="{{ path('app_annonce_new') }}" class="btn btn-lg btn-outline-secondary rounded-pill px-4">Publier une annonce</a>
        {% endif %}
        <a href="{{ path('app_faq') }}" class="btn btn-lg btn-outline-secondary rounded-pill px-4">FAQ</a>
    </div>
</div>

<style>
    .guide-toc {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .guide-toc__link {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--cyan-hover, #1B2E4B);
        background: rgba(75, 121, 161, 0.1);
        border: 1px solid rgba(75, 121, 161, 0.18);
        transition: background .15s ease, color .15s ease;
    }
    .guide-toc__link:hover {
        background: var(--cyan-main, #4B79A1);
        color: #fff;
        border-color: transparent;
    }
    .guide-section-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--text-strong, #1B2E4B);
        margin-bottom: 1rem;
        padding-bottom: 0.4rem;
        border-bottom: 3px solid var(--cyan-main, #4B79A1);
        display: inline-block;
        min-width: 6rem;
    }
    .guide-step-badge {
        background: var(--cyan-soft, rgba(75, 121, 161, 0.14));
        color: var(--cyan-hover, #1B2E4B);
    }

    /* Mode sombre : contraste lisible (pills + badges) */
    [data-bs-theme="dark"] .guide-toc__link,
    html.theme-dark .guide-toc__link {
        color: #f8fafc !important;
        background: rgba(148, 163, 184, 0.22) !important;
        border-color: rgba(186, 230, 253, 0.35) !important;
    }
    [data-bs-theme="dark"] .guide-toc__link:hover,
    html.theme-dark .guide-toc__link:hover {
        background: #4B79A1 !important;
        color: #fff !important;
        border-color: transparent !important;
    }
    [data-bs-theme="dark"] .guide-step-badge,
    html.theme-dark .guide-step-badge {
        background: #4B79A1 !important;
        color: #fff !important;
    }
    [data-bs-theme="dark"] .guide-section-title,
    html.theme-dark .guide-section-title {
        color: #f8fafc !important;
    }
    [data-bs-theme="dark"] .static-card-soft .text-secondary,
    html.theme-dark .static-card-soft .text-secondary {
        color: #cbd5e1 !important;
    }
    .guide-steps__item {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        padding: 1rem 0;
        border-bottom: 1px solid rgba(75, 121, 161, 0.12);
    }
    .guide-steps__item:last-child { border-bottom: 0; }
    .guide-steps__num {
        flex-shrink: 0;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 0.9rem;
        background: #1B2E4B;
        color: #fff;
    }
    .guide-safety li {
        display: flex;
        gap: 0.65rem;
        align-items: flex-start;
        padding: 0.55rem 0;
        color: var(--text-strong, #0f172a);
        font-size: 0.95rem;
    }
    .guide-safety .bi {
        color: #198754;
        font-size: 1.15rem;
        margin-top: 0.1rem;
    }
    .guide-cta {
        border-color: rgba(66, 177, 206, 0.2) !important;
        background: linear-gradient(180deg, var(--surface-2, #f4f7fb) 0%, var(--surface, #fff) 100%);
    }
    .guide-video-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    .guide-video-row {
        padding: 1.15rem;
        border-radius: 18px;
        border: 1px solid rgba(66, 177, 206, 0.16);
        background: var(--surface, #fff);
        box-shadow: 0 4px 18px rgba(27, 46, 75, 0.05);
        scroll-margin-top: 90px;
    }
    .guide-video-thumb {
        position: relative;
        display: block;
        width: min(100%, 250px);
        margin: 0 auto;
        padding: 0;
        border: 0;
        border-radius: 16px;
        overflow: hidden;
        background: #0f172a;
        cursor: pointer;
        line-height: 0;
        transition: transform .18s ease, box-shadow .18s ease;
    }
    .guide-video-thumb:hover,
    .guide-video-thumb:focus-visible {
        transform: translateY(-3px);
        box-shadow: 0 14px 32px rgba(15, 23, 42, 0.28);
        outline: none;
    }
    .guide-video-thumb__media {
        width: 100%;
        height: auto;
        aspect-ratio: 9 / 16;
        object-fit: cover;
        display: block;
        pointer-events: none;
    }
    .guide-video-thumb__overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding-bottom: 1.1rem;
        background: linear-gradient(180deg, rgba(15, 23, 42, 0) 55%, rgba(15, 23, 42, 0.55) 100%);
