{% extends 'page/static_base.html.twig' %}

{% block title %}Mentions légales — {{ site ? site.siteName : 'SoukExpat' }}{% endblock %}

{% block page_badge %}Légal{% endblock %}
{% block page_heading %}Mentions légales{% endblock %}
{% block page_lead %}Informations réglementaires relatives à l’édition du site {{ site ? site.siteName : 'SoukExpat' }}.{% endblock %}

{% block static_body %}
<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        <div class="p-4 p-md-5 static-card-soft mb-4">
            <h2 class="h5 fw-bold text-dark mb-3"><i class="bi bi-building text-cyan-brand me-2"></i>Éditeur du site</h2>
            <p class="text-secondary small mb-2">{{ site ? site.legalPublisher|nl2br : '' }}</p>
            <p class="text-secondary small mb-0">
                Siège : <strong>{{ site ? site.contactAddress : '' }}</strong><br>
                Contact : <a href="mailto:{{ contact_email }}" class="text-cyan-brand fw-semibold text-decoration-none">{{ contact_email }}</a>
                ou via le <a href="{{ path('app_contact') }}" class="text-cyan-brand fw-semibold text-decoration-none">formulaire de contact</a>.
            </p>
        </div>

        <div class="p-4 p-md-5 static-card-soft mb-4">
            <h2 class="h5 fw-bold text-dark mb-3"><i class="bi bi-hdd-network text-cyan-brand me-2"></i>Hébergement</h2>
            <p class="text-secondary small mb-0">{{ site ? site.legalHosting|nl2br : '' }}</p>
        </div>

        {% if site and site.legalExtra %}
        <div class="p-4 p-md-5 static-card-soft mb-4">
            <h2 class="h5 fw-bold text-dark mb-3"><i class="bi bi-file-text text-cyan-brand me-2"></i>Informations complémentaires</h2>
            <p class="text-secondary small mb-0">{{ site.legalExtra|nl2br }}</p>
        </div>
        {% endif %}

        <div class="p-4 p-md-5 static-card-soft mb-4">
            <h2 class="h5 fw-bold text-dark mb-3"><i class="bi bi-shield-lock text-cyan-brand me-2"></i>Données personnelles</h2>
            <p class="text-secondary small mb-0">
                Les informations collectées via les formulaires sont traitées pour la gestion du service.
                Vous pouvez demander l’accès, la rectification ou la suppression de vos données en écrivant à
                <a href="mailto:{{ contact_email }}" class="text-cyan-brand fw-semibold text-decoration-none">{{ contact_email }}</a>.
            </p>
        </div>

        <div class="p-4 p-md-5 static-card-soft">
            <h2 class="h5 fw-bold text-dark mb-3"><i class="bi bi-exclamation-triangle text-cyan-brand me-2"></i>Limitation de responsabilité</h2>
            <p class="text-secondary small mb-0">
                {{ site ? site.siteName : 'SoukExpat' }} est une plateforme de mise en relation.
                Les transactions s’effectuent entre utilisateurs sous leur seule responsabilité.
            </p>
        </div>

        <p class="text-center text-muted small mt-4 mb-0">
            Dernière mise à jour : {{ site ? site.updatedAt|date('d/m/Y') : "now"|date('d/m/Y') }}.
        </p>
    </div>
</div>
{% endblock %}
