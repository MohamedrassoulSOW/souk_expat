        background: rgba(75, 121, 161, 0.08);
        border-radius: 0 12px 12px 0;
        font-style: italic;
    }
    .partner-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
    }
    .partner-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }
    @media (max-width: 768px) {
        .partner-grid-2, .partner-grid-3 { grid-template-columns: 1fr; }
    }
    .partner-card {
        background: var(--surface, #fff);
        border: 1px solid rgba(75, 121, 161, 0.18);
        border-radius: 14px;
        padding: 1.1rem 1.2rem;
    }
    .partner-card h3 { margin-top: 0; }
    .partner-card--warn { border-top: 3px solid #b45309; }
    .partner-card--ok { border-top: 3px solid #4B79A1; }
    .partner-steps { padding-left: 1.2rem; }
    .partner-steps li { margin-bottom: .4rem; }
    .partner-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .92rem;
        margin: .5rem 0 1rem;
    }
    .partner-table th, .partner-table td {
        border: 1px solid rgba(27, 46, 75, 0.12);
        padding: .55rem .7rem;
        text-align: left;
        vertical-align: top;
    }
    .partner-table th {
        background: #1B2E4B;
        color: #fff;
        font-weight: 600;
    }
    .partner-table tr:nth-child(even) td {
        background: rgba(75, 121, 161, 0.06);
    }
    .partner-chips {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: .45rem;
    }
    .partner-chips li {
        background: rgba(75, 121, 161, 0.12);
        color: #1B2E4B;
        font-weight: 600;
        font-size: .85rem;
        padding: .35rem .7rem;
        border-radius: 999px;
    }
    .partner-note {
        font-size: .9rem;
        color: #64748b !important;
        margin-top: .75rem;
    }
    .partner-doc__closing {
        font-weight: 700;
        color: #1B2E4B !important;
        margin-top: 1rem;
    }
    .partner-sec code {
        font-size: .85em;
        background: rgba(27, 46, 75, 0.06);
        padding: .1rem .35rem;
        border-radius: 4px;
    }

    @media print {
        .no-print,
        .modern-nav,
        .footer-modern,
        .whatsapp-fab,
        [data-whatsapp-fab],
        .theme-toggle,
        aside.partner-actions {
            display: none !important;
        }
        body {
            background: #fff !important;
            padding-top: 0 !important;
        }
        .partner-doc__cover {
            background: #1B2E4B !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            padding: 1.5rem 0;
        }
        .partner-doc__body {
            max-width: 100%;
            padding-top: 1rem;
        }
        .partner-sec {
            page-break-inside: avoid;
        }
        .partner-table th {
            background: #1B2E4B !important;
            color: #fff !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        a[href]::after { content: none !important; }
    }
</style>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if auto_print %}
    <script>
        (function () {
            var ran = false;
            function go() {
                if (ran) return;
                ran = true;
                setTimeout(function () { window.print(); }, 400);
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', go);
            } else {
                go();
            }
            document.addEventListener('turbo:load', go);
        })();
    </script>
    {% endif %}
{% endblock %}
