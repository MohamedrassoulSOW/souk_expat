{# Gabarit commun — pages institutionnelles #}
{% extends 'base.html.twig' %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}

<header class="page-hero">
    <div class="container">
        <div class="page-hero__inner">
            <span class="page-hero__badge">{% block page_badge %}{% endblock %}</span>
            <h1 class="page-hero__title">{% block page_heading %}{% endblock %}</h1>
            <p class="page-hero__lead">{% block page_lead %}{% endblock %}</p>
        </div>
    </div>
</header>

<main class="pb-5">
    <div class="container py-4 py-md-5">
        {% block static_body %}{% endblock %}
    </div>
</main>

{{ include('layouts/footer.html.twig') }}

<style>
    .static-card-soft {
        border-radius: 16px;
        border: 1px solid rgba(66, 177, 206, 0.14);
        background: #fafcfd;
        transition: box-shadow .2s ease, transform .2s ease;
    }
    .static-card-soft:hover {
        box-shadow: 0 10px 35px rgba(42, 141, 167, 0.12);
    }
    .static-icon-circle {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        background: rgba(66, 177, 206, 0.12);
        color: #2a8da7;
    }
    .text-cyan-brand { color: #42B1CE !important; }
    .about-btn-brand { background-color: #42B1CE; }
    .about-btn-brand:hover { background-color: #369ab3; color: #fff; }
</style>
{% endblock %}
