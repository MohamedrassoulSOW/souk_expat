{% extends 'base.html.twig' %}

{% block title %}Chat - {{ thread.annonce.title }}{% endblock %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}

<div class="container chat-container mt-4">
    <div class="card card-chat shadow-lg border-0">
        {# 1. Header de la conversation #}
        <div class="chat-header bg-white d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <a href="{{ path('app_messages_list') }}" class="btn btn-link text-muted p-0 me-3">
                    <i class="bi bi-arrow-left fs-4"></i>
                </a>

                <div class="position-relative me-3">
                    {% if thread.annonce.annonceImages|length > 0 %}
                        <img src="{{ asset('uploads/annonces/' ~ thread.annonce.annonceImages[0].imadeName) }}" class="annonce-mini-img shadow-sm">
                    {% else %}
                        <div class="annonce-mini-img bg-light d-flex align-items-center justify-content-center text-muted border">
                            <i class="bi bi-image"></i>
                        </div>
                    {% endif %}
                    <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-1" style="width: 12px; height: 12px;"></span>
                </div>

                <div>
                    <h6 class="mb-0 fw-bold text-dark">{{ thread.annonce.title }}</h6>
                    <small class="text-muted">
                        <span class="fw-bold" style="color: #42B1CE;">{{ (app.user == thread.buyer ? thread.seller : thread.buyer).userIdentifier|split('@')[0]|capitalize }}</span> • En ligne
                    </small>
                </div>
            </div>
            
            <div class="d-none d-sm-block">
                <span class="badge rounded-pill text-dark border bg-light px-3 py-2">
                    {{ thread.annonce.price }} €
                </span>
            </div>
        </div>
        
        {# 2. Zone de messages (Scrollable) #}
        <div id="message-container">
            <div class="text-center my-4">
                <span class="badge bg-white text-muted shadow-sm px-3 py-2 rounded-pill small">
                    <i class="bi bi-lock-fill me-1"></i> Les échanges sont sécurisés par Expat Souk
                </span>
            </div>
            
            {% for message in thread.messagesAsThread %}
                {{ include('message/_message_item.html.twig') }}
            {% endfor %}
        </div>

        {# 3. Barre de saisie #}
        <div class="input-group-chat bg-white">
            {{ form_start(form, {'attr': {'id': 'chat-form', 'class': 'mb-0 w-100'}}) }}
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-light rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-paperclip text-muted fs-5"></i>
                    </button>
                    
                    <div class="flex-grow-1">
                        {{ form_widget(form.content, {
                            'attr': {
                                'class': 'form-control form-control-chat border-0 bg-light shadow-none', 
                                'placeholder': 'Votre message...',
                                'autocomplete': 'off'
                            }
                        }) }}
                    </div>

                    <button type="submit" class="btn btn-send-custom">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            {{ form_end(form, {'render_rest': true}) }}
        </div>
    </div>
</div>

<style>
    /* Structure du Chat */
    .card-chat { 
        height: 82vh; 
        display: flex; 
        flex-direction: column; 
        overflow: hidden;
        border-radius: 20px !important;
    }

    .chat-header { 
        padding: 12px 20px; 
        border-bottom: 1px solid #f0f0f0; 
        z-index: 10;
    }

    .annonce-mini-img { 
        width: 48px; 
        height: 48px; 
        border-radius: 12px; 
        object-fit: cover; 
    }

    /* Container de messages avec fond texturé */
    #message-container { 
        flex-grow: 1; 
        background-color: #f7f9fb;
        background-image: url("https://www.transparenttextures.com/patterns/cubes.png"); /* Texture plus moderne */
        padding: 20px; 
        overflow-y: auto; 
    }

    /* Barre d'envoi */
    .input-group-chat { 
        padding: 15px 20px; 
        border-top: 1px solid #f0f0f0; 
    }

    .form-control-chat { 
        border-radius: 25px !important; 
        padding: 12px 20px !important;
        font-size: 0.95rem;
    }

    /* Bouton d'envoi thématisé #42B1CE */
    .btn-send-custom { 
        width: 48px; 
        height: 48px; 
        border-radius: 50% !important; 
        background-color: #42B1CE !important;
        border: none !important;
        color: white !important;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 4px 10px rgba(66, 177, 206, 0.3);
    }
    
    .btn-send-custom:hover { 
        transform: scale(1.1) rotate(-5deg);
        background-color: #369ab3 !important;
        box-shadow: 0 6px 15px rgba(66, 177, 206, 0.4);
    }

    .btn-send-custom i { font-size: 1.2rem; margin-left: 3px; }

    /* Scrollbar */
    #message-container::-webkit-scrollbar { width: 4px; }
    #message-container::-webkit-scrollbar-thumb { background: #cbd5e0; border-radius: 10px; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const container = document.getElementById('message-container');
        container.scrollTop = container.scrollHeight;

        const hubUrl = '{{ mercure_hub_url|default("")|escape("js") }}';
        if (hubUrl) {
            const url = new URL(hubUrl);
            url.searchParams.append('topic', 'chat_thread_{{ thread.id }}');
            const eventSource = new EventSource(url);
            eventSource.onmessage = event => {
                container.insertAdjacentHTML('beforeend', event.data);
                container.scrollTo({ top: container.scrollHeight, behavior: 'smooth' });
            }
        }
    });
</script>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
{% endblock %}