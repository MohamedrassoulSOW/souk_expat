{% extends 'base.html.twig' %}

{% block title %}Messages | SoukExpat{% endblock %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}

<main class="msg-inbox">
    <div class="container msg-inbox__container">
        {{ include('layouts/_page_header.html.twig', {
            eyebrow: 'Messagerie',
            title_html: 'Mes <span class="text-brand">messages</span>',
            lead: 'Échangez avec acheteurs et vendeurs autour de vos annonces.',
            breadcrumbs: [
                { label: 'Accueil', url: path('app_home') },
                { label: 'Messages' }
            ],
            actions: '<span class="annonce-page-stat"><i class="bi bi-chat-dots" aria-hidden="true"></i><strong>' ~ threads|length|cap999 ~ '</strong> discussion' ~ (threads|length > 1 ? 's' : '') ~ '</span>'
        }) }}

        <div class="msg-inbox__panel">
            <div class="row g-0 msg-inbox__row">
                <div class="col-12 col-md-5 col-lg-4 msg-inbox__list-col">
                    <div class="msg-inbox__list" role="list">
                        {% for thread in threads %}
                            {% set interlocuteur = (app.user == thread.buyer ? thread.seller : thread.buyer) %}
                            {% set last = thread.messagesAsThread|last %}
                            {% set unread = 0 %}
                            {% for m in thread.messagesAsThread %}
                                {% if m.sender != app.user and not m.isIsRead %}
                                    {% set unread = unread + 1 %}
                                {% endif %}
                            {% endfor %}
                            {% set preview %}
                                {% if last %}
                                    {% if last.kind == constant('App\\Entity\\Message::KIND_IMAGE') %}
                                        📷 Photo
                                    {% elseif last.kind == constant('App\\Entity\\Message::KIND_LOCATION') %}
                                        📍 Position
                                    {% else %}
                                        {{ last.content|striptags|u.truncate(52, '…') }}
                                    {% endif %}
                                {% else %}
                                    Nouvelle conversation
                                {% endif %}
                            {% endset %}

                            <a href="{{ path('app_chat_view', { id: thread.id }) }}"
                               class="msg-thread-card {{ unread > 0 ? 'is-unread' : '' }}"
                               role="listitem">
                                <div class="msg-thread-card__media">
                                    {% if thread.annonce.annonceImages|length > 0 %}
                                        <img src="{{ asset('uploads/annonces/' ~ thread.annonce.annonceImages[0].imadeName) }}"
                                             alt=""
                                             loading="lazy"
                                             decoding="async">
                                    {% else %}
                                        <span class="msg-thread-card__placeholder"><i class="bi bi-image" aria-hidden="true"></i></span>
                                    {% endif %}
                                </div>
                                <div class="msg-thread-card__body min-w-0">
                                    <div class="d-flex align-items-start justify-content-between gap-2">
                                        <h2 class="msg-thread-card__title">{{ thread.annonce.title|u.truncate(42, '…') }}</h2>
                                        {% if last %}
                                            <time class="msg-thread-card__time" datetime="{{ last.createdAt|date('c') }}">
                                                {{ last.createdAt|date('d/m') }}
                                            </time>
                                        {% endif %}
                                    </div>
                                    <div class="msg-thread-card__meta">
                                        {% if interlocuteur.avatar %}
                                            <img class="msg-thread-card__avatar" src="{{ asset('uploads/avatars/' ~ interlocuteur.avatar) }}" alt="" width="20" height="20" loading="lazy">
                                        {% else %}
                                            <span class="msg-thread-card__avatar msg-thread-card__avatar--fallback">{{ interlocuteur.firstName|default('?')|slice(0, 1)|upper }}</span>
                                        {% endif %}
                                        <span class="text-truncate">{{ interlocuteur.firstName|default(interlocuteur.userIdentifier|split('@')[0]|capitalize) }}</span>
                                        <span class="msg-thread-card__price">{{ thread.annonce.price|number_format(0, ',', ' ') }} MAD</span>
                                    </div>
                                    <p class="msg-thread-card__preview {{ unread > 0 ? 'fw-semibold' : '' }}">{{ preview|trim }}</p>
                                </div>
                                {% if unread > 0 %}
                                    <span class="msg-thread-card__badge" aria-label="{{ unread }} non lu{{ unread > 1 ? 's' : '' }}">{{ unread > 9 ? '9+' : unread }}</span>
                                {% else %}
                                    <i class="bi bi-chevron-right msg-thread-card__chevron" aria-hidden="true"></i>
                                {% endif %}
                            </a>
                        {% else %}
                            <div class="msg-inbox__empty">
                                <div class="msg-inbox__empty-icon" aria-hidden="true">
                                    <i class="bi bi-chat-left-dots"></i>
                                </div>
                                <h2 class="h5 fw-bold mb-2">Aucun message</h2>
                                <p class="text-muted small mb-3">Contactez un vendeur depuis une annonce pour démarrer une discussion.</p>
                                <a href="{{ path('app_annonce_index') }}" class="btn btn-custom-cyan rounded-pill px-4 btn-sm fw-bold">
                                    Voir les annonces
                                </a>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="col-md-7 col-lg-8 d-none d-md-flex msg-inbox__aside">
                    <div class="msg-inbox__aside-inner">
                        <div class="msg-inbox__aside-icon" aria-hidden="true">
                            <i class="bi bi-chat-square-text"></i>
                        </div>
                        <h2 class="h4 fw-bold mb-2">Sélectionnez une discussion</h2>
                        <p class="text-muted mb-0">Choisissez une conversation pour afficher l’historique et continuer l’échange sur SoukExpat.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}
