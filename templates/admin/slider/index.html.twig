{% extends 'base.html.twig' %}

{% block title %}Gestion du Slider{% endblock %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}
{{ include('layouts/flush_message.html.twig') }}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary">Retour Dashboard<a>
        <h1>📸 Gestion du Slider Accueil</h1>
        <a href="{{ path('admin_slider_new') }}" class="btn btn-outline-primary">Ajouter une slide</a>
    </div>

    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Aperçu</th>
                    <th>Titre</th>
                    <th>Statut</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for slider in sliders %}
                <tr>
                    <td>
                        <img src="{{ asset('uploads/sliders/' ~ slider.imageName) }}" 
                            alt="" class="rounded" style="width: 120px; height: 60px; object-fit: cover;">
                    </td>
                    <td>{{ slider.title|default('Sans titre') }}</td>
                    <td>
                        {% if slider.isActive %}
                            <span class="badge bg-success">Actif</span>
                        {% else %}
                            <span class="badge bg-secondary">Inactif</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <a href="{{ path('admin_slider_toggle', {id: slider.id}) }}" class="btn btn-outline-secondary btn-sm" >Modifier statut</a>
                        <form method="post" action="{{ path('admin_slider_delete', {id: slider.id}) }}" 
                              onsubmit="return confirm('Supprimer cette image du slider ?');" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ slider.id) }}">
                            <button class="btn btn-outline-danger btn-sm">🗑️ Supprimer</button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="text-center py-4 text-muted">Aucune image dans le slider.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}