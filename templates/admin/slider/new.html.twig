{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvelle slide | SoukExpat{% endblock %}
{% block admin_mobile_title %}Nouvelle slide{% endblock %}

{% block admin_main %}
    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Slider',
        title: 'Ajouter une image',
        lead: 'Format recommandé : 1920×800 px.',
        actions: '<a href="' ~ path('admin_slider_index') ~ '" class="btn btn-light border rounded-pill">Retour</a>'
    }) }}

    <div class="admin-panel" style="max-width: 560px;">
        <div class="card-body p-4">
            {{ form_start(form) }}
                <div class="mb-3">{{ form_row(form.title, {'attr': {'class': 'form-control rounded-3'}}) }}</div>
                <div class="mb-3">
                    {{ form_row(form.imageFile, {'attr': {'class': 'form-control rounded-3'}}) }}
                </div>
                <div class="mb-4">{{ form_row(form.isActive) }}</div>
                <div class="d-flex gap-2">
                    <a href="{{ path('admin_slider_index') }}" class="btn btn-light border rounded-pill">Annuler</a>
                    <button class="btn btn-admin-primary rounded-pill px-4">Enregistrer</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
