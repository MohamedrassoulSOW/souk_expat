{% extends 'base.html.twig' %}

{% block title %}Nouvelle Slide{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h2 class="mb-4">Ajouter une image</h2>
                    
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_row(form.title, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                            <small class="text-muted">Format recommandé : 1920x800px</small>
                        </div>
                        <div class="mb-3">
                            {{ form_row(form.isActive) }}
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a href="{{ path('admin_slider_index') }}" class="btn btn-light">Annuler</a>
                            <button class="btn btn-success">Enregistrer</button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}