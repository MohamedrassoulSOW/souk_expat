<header id="heroSlider" class="carousel slide carousel-fade modern-hero" data-bs-ride="carousel">
    {# Indicateurs personnalisés avec #42B1CE #}
    <div class="carousel-indicators custom-indicators mb-3">
        {% for slider in sliders %}
            <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="{{ loop.index0 }}" 
                    class="{{ loop.first ? 'active' : '' }}"></button>
        {% endfor %}
    </div>

    <div class="carousel-inner">
        {% for slider in sliders %}
            <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                <div class="hero-bg-compact" style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('{{ asset('uploads/sliders/' ~ slider.imageName) }}');">
                    <div class="container h-100">
                        <div class="row h-100 align-items-center justify-content-center">
                            <div class="col-lg-8 text-center text-white">
                                
                                {# Titre #}
                                <h2 class="display-6 fw-bold mb-3 slide-up-animation">{{ slider.title }}</h2>
                                
                                {# Texte #}
                                <p class="lead mb-4 fade-in-animation delay-1 fw-light">
                                    Découvrez les meilleures opportunités de la communauté expatriée au Maroc.
                                </p>
                                
                                {# Bouton CTA avec la nouvelle couleur #}
                                <div class="fade-in-animation delay-2">
                                    <a href="{{ path('app_annonce_index') }}" class="btn btn-custom-cyan rounded-pill px-5 py-2 fw-bold shadow hover-up">
                                        Voir les annonces
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</header>

<style>
    /* --- Bouton Custom Cyan --- */
    .btn-custom-cyan {
        background-color: #42B1CE;
        border-color: #42B1CE;
        color: white;
        transition: all 0.3s ease;
    }
    .btn-custom-cyan:hover {
        background-color: #369ab3;
        border-color: #369ab3;
        color: white;
        transform: translateY(-2px);
    }

    .hero-bg-compact {
        height: 420px;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
    }

    /* --- Typographie --- */
    .display-6 { 
        font-size: 2.5rem;
        text-shadow: 0 2px 15px rgba(0,0,0,0.4); 
    }
    
    .lead { 
        font-size: 1.15rem;
        max-width: 600px;
        margin: 0 auto;
        text-shadow: 0 1px 8px rgba(0,0,0,0.3);
    }

    /* --- Animations --- */
    .slide-up-animation { animation: slideUp 0.7s ease-out forwards; }
    .fade-in-animation { opacity: 0; animation: fadeIn 1s ease-out forwards; }
    .delay-1 { animation-delay: 0.3s; }
    .delay-2 { animation-delay: 0.5s; }

    @keyframes slideUp {
        from { transform: translateY(30px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
    }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

    /* --- Indicateurs (Points du bas) --- */
    .custom-indicators button {
        width: 10px !important;
        height: 10px !important;
        border-radius: 50% !important;
        margin: 0 5px !important;
        background-color: rgba(255, 255, 255, 0.5) !important;
        border: none !important;
        transition: all 0.3s ease;
    }
    .custom-indicators button.active { 
        background-color: #42B1CE !important; 
        transform: scale(1.3);
        box-shadow: 0 0 10px rgba(66, 177, 206, 0.5);
    }

    /* --- Responsivité --- */
    @media (max-width: 768px) {
        .hero-bg-compact { height: 350px; }
        .display-6 { font-size: 1.8rem; }
        .lead { font-size: 1rem; }
    }

    .hover-up:hover {
        box-shadow: 0 8px 20px rgba(66, 177, 206, 0.3) !important;
    }
</style>