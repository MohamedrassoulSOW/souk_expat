<header id="heroSlider" class="carousel slide carousel-fade" data-bs-ride="carousel">
    {# 1. Indicateurs (Points du bas) #}
    <div class="carousel-indicators" style="margin-bottom: 20px;">
        {% for slider in sliders %}
            <button type="button" data-bs-target="#heroSlider" data-bs-slide-to="{{ loop.index0 }}" 
                    class="{{ loop.first ? 'active' : '' }}" 
                    style="width: 10px; height: 10px; border-radius: 50%; margin: 0 5px;"></button>
        {% endfor %}
    </div>

    {# 2. Contenu du Slider #}
    <div class="carousel-inner">
        {% for slider in sliders %}
            <div class="carousel-item {{ loop.first ? 'active' : '' }}">
                
                {# LE BLOC IMAGE : On force le centrage du texte avec d-flex #}
                <div class="d-flex align-items-center justify-content-center" 
                     style="height: 450px; 
                            width: 100%; 
                            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('{{ asset('uploads/sliders/' ~ slider.imageName) }}') center/cover no-repeat; 
                            position: relative;">
                    
                    {# LE BLOC TEXTE : On utilise des styles inline pour le forcer SUR l'image #}
                    <div style="width: 90%; max-width: 800px; text-align: center; color: white; z-index: 10;">
                        
                        {# Titre Responsive #}
                        <h2 style="font-weight: 800; 
                                   text-shadow: 2px 2px 10px rgba(0,0,0,0.8); 
                                   margin-bottom: 15px; 
                                   line-height: 1.2;
                                   font-size: clamp(1.5rem, 5vw, 2.8rem);">
                            {{ slider.title }}
                        </h2>

                        {# Description (On la réduit sur mobile pour gagner de la place) #}
                        <p style="font-weight: 300; 
                                  text-shadow: 1px 1px 5px rgba(0,0,0,0.8); 
                                  margin-bottom: 25px; 
                                  font-size: clamp(0.9rem, 2vw, 1.2rem);">
                            Découvrez les meilleures opportunités au Maroc.
                        </p>

                        {# Bouton Cyan #}
                        <div>
                            <a href="{{ path('app_annonce_index') }}" 
                               style="background-color: #42B1CE; 
                                      color: white; 
                                      padding: 12px 35px; 
                                      border-radius: 50px; 
                                      text-decoration: none; 
                                      font-weight: bold; 
                                      display: inline-block;
                                      box-shadow: 0 4px 15px rgba(66, 177, 206, 0.4);">
                                Voir les annonces
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</header>

<style>
    /* Style pour les indicateurs actifs (Cyan) */
    .carousel-indicators button.active {
        background-color: #42B1CE !important;
        border: none;
    }

    /* Animation de fondu plus douce */
    .carousel-fade .carousel-item {
        transition-duration: 0.8s;
    }
</style>