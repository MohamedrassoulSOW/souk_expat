{% extends 'admin/base_admin.html.twig' %}

{% block title %}Conversations | SoukExpat{% endblock %}
{% block admin_mobile_title %}Conversations{% endblock %}

{% block admin_main %}
    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Gestion',
        title: 'Conversations',
        lead: 'Fils de discussion entre acheteurs et vendeurs — nettoyez les anciens messages si besoin.',
        actions: '<span class="admin-badge">' ~ (threads|length|cap999) ~ ' conversation' ~ (threads|length > 1 ? 's' : '') ~ '</span>'
    }) }}

    <div class="admin-panel mb-3">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                <div>
                    <h2 class="h6 fw-bold mb-1"><i class="bi bi-chat-left-dots me-1 text-danger" aria-hidden="true"></i>Nettoyage des anciens messages</h2>
                    <p class="small text-muted mb-0">
                        Supprime les messages plus anciens que la durée choisie.
                        Les conversations vides sont ensuite retirées automatiquement.
                        {% if emptyThreadsCount|default(0) > 0 %}
                            <span class="d-block mt-1">Conversations déjà vides : <strong>{{ emptyThreadsCount }}</strong>.</span>
                        {% endif %}
                    </p>
                </div>
                <form method="post" action="{{ path('app_admin_chats_purge_old') }}" class="d-flex flex-wrap align-items-end gap-2"
                      onsubmit="var u=this.unit.value,v=this.value.value; return confirm('Supprimer définitivement tous les messages de plus de ' + v + ' ' + (u==='months'?'mois':'jours') + ' ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_purge_old_messages') }}">
                    <div>
                        <label class="form-label small text-muted mb-1" for="purge-msg-value">Plus de</label>
                        <input type="number" name="value" id="purge-msg-value" class="form-control form-control-sm rounded-3" style="width:5.5rem"
                               min="1" max="3650" value="30" required>
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-1" for="purge-msg-unit">Unité</label>
                        <select name="unit" id="purge-msg-unit" class="form-select form-select-sm rounded-3">
                            <option value="days" selected>Jours</option>
                            <option value="months">Mois</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-sm btn-danger rounded-pill px-3">
                        <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Purger les messages
                    </button>
                </form>
            </div>
            <p class="small text-muted mb-0 mt-2">Raccourcis : 7 / 14 / 30 / 60 / 90 j — ou saisissez n’importe quelle durée en jours ou mois.</p>
        </div>
    </div>

    <div class="admin-panel">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3 border-0">#</th>
                        <th class="py-3 border-0">Annonce</th>
                        <th class="py-3 border-0 d-none d-md-table-cell">Acheteur</th>
                        <th class="py-3 border-0 d-none d-lg-table-cell">Vendeur</th>
                        <th class="py-3 border-0">Messages</th>
                        <th class="pe-3 py-3 border-0 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for thread in threads %}
                        <tr>
                            <td class="ps-3 text-muted small font-monospace">#{{ thread.id }}</td>
                            <td>
                                {% if thread.annonce %}
                                    <a href="{{ path('app_annonce_show', { id: thread.annonce.id }) }}" class="fw-bold text-dark text-decoration-none" target="_blank" rel="noopener">
                                        {{ thread.annonce.title|u.truncate(42, '…') }}
                                    </a>
                                {% else %}
                                    <span class="text-muted">Annonce supprimée</span>
                                {% endif %}
                            </td>
                            <td class="d-none d-md-table-cell">
                                {% if thread.buyer %}
                                    <div class="small fw-semibold">{{ thread.buyer.firstName }} {{ thread.buyer.lastName }}</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">{{ thread.buyer.email }}</div>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="d-none d-lg-table-cell">
                                {% if thread.seller %}
                                    <div class="small fw-semibold">{{ thread.seller.firstName }} {{ thread.seller.lastName }}</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">{{ thread.seller.email }}</div>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td><span class="admin-badge">{{ thread.messagesAsThread|length }}</span></td>
                            <td class="pe-3 text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <a href="{{ path('app_chat_view', { id: thread.id }) }}" class="btn btn-sm btn-admin-primary btn-icon-action" title="Voir" aria-label="Voir">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_admin_chats_delete', { id: thread.id }) }}" class="d-inline"
                                          onsubmit="return confirm('Supprimer définitivement cette conversation et tous ses messages ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_thread_' ~ thread.id) }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger btn-icon-action" title="Supprimer" aria-label="Supprimer">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-5">Aucune conversation.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
