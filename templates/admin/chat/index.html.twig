{% extends 'base.html.twig' %}

{% block title %}Conversations (chat) | Expat Souk{% endblock %}

{% block body %}
<div class="container-fluid p-4 bg-light min-vh-100">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="bi bi-chat-dots me-2" style="color: #42B1CE;"></i>Conversations
            </h3>
            <p class="text-muted mb-0 small">Messages entre acheteurs et vendeurs (toutes les discussions).</p>
        </div>
        <a href="{{ path('app_dashboard') }}" class="btn btn-white shadow-sm border rounded-pill px-4 bg-white">
            <i class="bi bi-speedometer2 me-2"></i>Tableau de bord
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 p-3 p-md-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h5 class="fw-bold mb-0">Liste des fils</h5>
            <span class="badge rounded-pill px-3 py-2" style="background-color: #42B1CE20; color: #0d6efd;">{{ threads|length }} conversation(s)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4 py-3 border-0">#</th>
                            <th class="py-3 border-0">Annonce</th>
                            <th class="py-3 border-0">Acheteur</th>
                            <th class="py-3 border-0">Vendeur</th>
                            <th class="py-3 border-0">Messages</th>
                            <th class="pe-4 py-3 border-0 text-end">Ouvrir</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for thread in threads %}
                            <tr class="border-bottom border-light">
                                <td class="ps-4 text-muted small font-monospace">#{{ thread.id }}</td>
                                <td>
                                    <a href="{{ path('app_annonce_show', { id: thread.annonce.id }) }}" class="fw-bold text-dark text-decoration-none" target="_blank" rel="noopener">
                                        {{ thread.annonce.title|u.truncate(48, '…') }}
                                    </a>
                                </td>
                                <td>
                                    <div class="small text-dark fw-semibold">{{ thread.buyer.firstName }} {{ thread.buyer.lastName }}</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">{{ thread.buyer.email }}</div>
                                </td>
                                <td>
                                    <div class="small text-dark fw-semibold">{{ thread.seller.firstName }} {{ thread.seller.lastName }}</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">{{ thread.seller.email }}</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill">{{ thread.messagesAsThread|length }}</span>
                                </td>
                                <td class="pe-4 text-end">
                                    <a href="{{ path('app_chat_view', { id: thread.id }) }}" class="btn btn-sm rounded-pill px-3" style="background-color: #42B1CE; color: #fff; border: none;">
                                        <i class="bi bi-eye me-1"></i> Voir
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">Aucune conversation pour l’instant.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
