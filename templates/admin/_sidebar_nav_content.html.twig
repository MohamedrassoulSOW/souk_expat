{# Contenu de navigation admin (sidebar desktop + menu mobile) #}
{% set _r = app.request.attributes.get('_route') ?? '' %}
{% set mobile = nav_mobile|default(false) %}

<ul class="nav nav-pills flex-column gap-1 mb-0 {{ mobile ? 'admin-mobile-nav' : '' }}">

    <li class="nav-item">
        <a href="{{ path('app_dashboard') }}"
           class="nav-link {{ _r == 'app_dashboard' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
           {% if mobile %}data-admin-nav-link{% endif %}>
            <i class="bi bi-speedometer2 me-2" aria-hidden="true"></i> Dashboard
        </a>
    </li>

    {% if is_granted('ROLE_EDITOR') %}
        <li class="admin-nav-section {{ mobile ? 'mt-3' : 'mt-4' }} mb-1 ms-1 small text-uppercase fw-bold text-muted" style="letter-spacing: 1px; font-size: 0.72rem; list-style: none;">
            Modération
        </li>

        <li class="nav-item">
            <a href="{{ path('admin_annonces_pending') }}"
               class="nav-link {{ _r == 'admin_annonces_pending' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-clock-history me-2 text-warning" aria-hidden="true"></i> En attente
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('admin_annonces_approved') }}"
               class="nav-link {{ _r == 'admin_annonces_approved' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-check-circle me-2 text-success" aria-hidden="true"></i> Validées
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('admin_annonces_rejected') }}"
               class="nav-link {{ _r == 'admin_annonces_rejected' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-x-circle me-2 text-danger" aria-hidden="true"></i> Refusées
            </a>
        </li>

        <li class="admin-nav-section mt-3 mb-1 ms-1 small text-uppercase fw-bold text-muted" style="letter-spacing: 1px; font-size: 0.72rem; list-style: none;">
            Gestion
        </li>

        {% if is_granted('ROLE_ADMIN') %}
        <li class="nav-item">
            <a href="{{ path('app_user') }}"
               class="nav-link {{ _r == 'app_user' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-people me-2" aria-hidden="true"></i> Utilisateurs
            </a>
        </li>
        {% endif %}
        <li class="nav-item">
            <a href="{{ path('app_admin_contact_index') }}"
               class="nav-link {{ _r starts with 'app_admin_contact' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-chat-left-text me-2" aria-hidden="true"></i> Contacts
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_admin_chats_index') }}"
               class="nav-link {{ _r == 'app_admin_chats_index' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-chat-dots me-2" aria-hidden="true"></i> Conversations
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_category') }}"
               class="nav-link {{ _r starts with 'app_category' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-tags me-2" aria-hidden="true"></i> Catégories
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_city_index') }}"
               class="nav-link {{ _r starts with 'app_city' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-geo-alt me-2" aria-hidden="true"></i> Villes
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('admin_slider_index') }}"
               class="nav-link {{ _r starts with 'admin_slider' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-images me-2" aria-hidden="true"></i> Slider accueil
            </a>
        </li>

        <li class="admin-nav-section mt-3 mb-1 ms-1 small text-uppercase fw-bold text-muted" style="letter-spacing: 1px; font-size: 0.72rem; list-style: none;">
            Site
        </li>

        <li class="nav-item">
            <a href="{{ path('admin_site_settings') }}"
               class="nav-link {{ _r == 'admin_site_settings' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-sliders me-2" aria-hidden="true"></i> Paramètres du site
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_annonce_index') }}"
               class="nav-link {{ _r == 'app_annonce_index' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-grid me-2" aria-hidden="true"></i> Annonces (public)
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_home') }}"
               class="nav-link text-dark hover-light"
               {% if mobile %}data-admin-nav-link{% endif %}>
                <i class="bi bi-house-door me-2" aria-hidden="true"></i> Page d'accueil
            </a>
        </li>
    {% endif %}

    <li class="nav-item mt-3 pt-3 border-top">
        <a href="{{ path('app_logout') }}"
           class="nav-link text-danger hover-light small"
           {% if mobile %}data-admin-nav-link{% endif %}>
            <i class="bi bi-box-arrow-left me-2" aria-hidden="true"></i> Déconnexion
        </a>
    </li>
</ul>
