{# Contenu de navigation admin (réutilisé dans la sidebar desktop et l'offcanvas mobile) #}
{% set _r = app.request.attributes.get('_route') ?? '' %}

<ul class="nav nav-pills flex-column gap-1 mb-0">

    <li class="nav-item">
        <a href="{{ path('app_dashboard') }}" class="nav-link {{ _r == 'app_dashboard' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
            <i class="bi bi-speedometer2 me-2"></i> Dashboard
        </a>
    </li>

    {% if is_granted('ROLE_EDITOR') %}
        <li class="mt-4 mb-2 ms-3 small text-uppercase fw-bold text-muted opacity-50" style="letter-spacing: 1px; font-size: 0.75rem;">Modération</li>

        <li class="nav-item">
            <a href="{{ path('admin_annonces_pending') }}" class="nav-link {{ _r == 'admin_annonces_pending' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
                <i class="bi bi-clock-history me-2 text-warning"></i> En attente
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('admin_annonces_approved') }}" class="nav-link {{ _r == 'admin_annonces_approved' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
                <i class="bi bi-check-circle me-2 text-success"></i> Validées
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('admin_annonces_rejected') }}" class="nav-link {{ _r == 'admin_annonces_rejected' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
                <i class="bi bi-x-circle me-2 text-danger"></i> Rejetées
            </a>
        </li>

        <li class="mt-4 mb-2 ms-3 small text-uppercase fw-bold text-muted opacity-50" style="letter-spacing: 1px; font-size: 0.75rem;">Gestion</li>

        {% if is_granted('ROLE_ADMIN') %}
        <li class="nav-item">
            <a href="{{ path('app_user') }}" class="nav-link {{ _r == 'app_user' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
                <i class="bi bi-people me-2"></i> Utilisateurs
            </a>
        </li>
        {% endif %}
        <li class="nav-item">
            <a href="{{ path('app_admin_contact_index') }}" class="nav-link {{ _r matches '/^app_admin_contact/' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
                <i class="bi bi-chat-left-text me-2"></i> Contacts
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_admin_chats_index') }}" class="nav-link {{ _r == 'app_admin_chats_index' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
                <i class="bi bi-chat-dots me-2"></i> Conversations
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_category') }}" class="nav-link {{ _r matches '/^app_category/' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
                <i class="bi bi-tags me-2"></i> Catégories
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_city_index') }}" class="nav-link {{ _r matches '/^app_city/' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
                <i class="bi bi-geo-alt me-2"></i> Villes
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('admin_slider_index') }}" class="nav-link {{ _r matches '/^admin_slider/' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
                <i class="bi bi-images me-2"></i> Slider accueil
            </a>
        </li>

        <li class="mt-4 mb-2 ms-3 small text-uppercase fw-bold text-muted opacity-50" style="letter-spacing: 1px; font-size: 0.75rem;">Site</li>

        <li class="nav-item">
            <a href="{{ path('app_annonce_index') }}" class="nav-link {{ _r == 'app_annonce_index' ? 'active-cyan shadow-sm' : 'text-dark hover-light' }}">
                <i class="bi bi-grid me-2"></i> Annonces (public)
            </a>
        </li>
        <li class="nav-item">
            <a href="{{ path('app_home') }}" class="nav-link text-dark hover-light">
                <i class="bi bi-house-door me-2"></i> Page d'accueil
            </a>
        </li>
    {% endif %}

    <li class="nav-item mt-3 pt-3 border-top">
        <a href="{{ path('app_logout') }}" class="nav-link text-danger hover-light small">
            <i class="bi bi-box-arrow-left me-2"></i> Déconnexion
        </a>
    </li>
</ul>
