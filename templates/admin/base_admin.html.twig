{% extends 'base.html.twig' %}

{% block body_attributes %} class="dashboard-admin-page"{% endblock %}

{% block whatsapp_fab %}{% endblock %}
{% block safety_disclaimer %}{% endblock %}

{% block body %}
<div class="container-fluid p-0 dashboard-shell">
    {# ——— En-tête + menu déroulant (mobile uniquement) ——— #}
    <header class="d-md-none sticky-top dashboard-mobile-header">
        <div class="bg-white border-bottom shadow-sm px-3 py-2">
            <div class="d-flex align-items-center gap-2">
                <a href="{{ path('app_dashboard') }}" class="flex-shrink-0 text-decoration-none" title="Tableau de bord">
                    <img src="{{ asset('logo-souk-expat-nav.png') }}" alt="SoukExpat" width="110" height="34" class="admin-mobile-logo" decoding="async">
                </a>
                <div class="min-w-0 flex-grow-1">
                    <div class="admin-mobile-kicker">Administration</div>
                    <div class="fw-bold text-truncate admin-mobile-title">{% block admin_mobile_title %}Menu{% endblock %}</div>
                </div>
                {{ include('layouts/_theme_toggle.html.twig', { btn_class: 'theme-toggle--admin' }) }}
                <button class="btn admin-menu-toggle flex-shrink-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#adminMobileDropdown"
                        aria-expanded="false"
                        aria-controls="adminMobileDropdown"
                        id="adminMenuToggleBtn">
                    <i class="bi bi-list admin-menu-toggle__icon-open" aria-hidden="true"></i>
                    <i class="bi bi-x-lg admin-menu-toggle__icon-close d-none" aria-hidden="true"></i>
                    <span class="admin-menu-toggle__label">Menu</span>
                </button>
            </div>
        </div>

        <div class="collapse admin-mobile-dropdown" id="adminMobileDropdown">
            <div class="admin-mobile-dropdown__panel">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                    <span class="small fw-bold text-uppercase text-muted" style="letter-spacing: .06em;">Navigation</span>
                    <button type="button" class="btn btn-sm btn-light border rounded-pill px-3"
                            data-bs-toggle="collapse" data-bs-target="#adminMobileDropdown"
                            aria-label="Fermer le menu">
                        Fermer
                    </button>
                </div>
                {{ include('admin/_sidebar_nav_content.html.twig', { nav_mobile: true }) }}
            </div>
        </div>
    </header>

    <div class="row g-0 align-items-stretch dashboard-main-row">
        {{ include('admin/_sidebar.html.twig') }}

        <main class="col-12 col-md-9 col-lg-10 dashboard-main custom-scrollbar p-3 p-sm-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} border-0 shadow-sm rounded-3 alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block admin_main %}{% endblock %}
        </main>
    </div>
</div>

<script>
(function () {
    var menu = document.getElementById('adminMobileDropdown');
    var btn = document.getElementById('adminMenuToggleBtn');
    if (!menu || !btn) return;

    var iconOpen = btn.querySelector('.admin-menu-toggle__icon-open');
    var iconClose = btn.querySelector('.admin-menu-toggle__icon-close');
    var label = btn.querySelector('.admin-menu-toggle__label');

    function setOpen(open) {
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.classList.toggle('is-open', open);
        if (iconOpen) iconOpen.classList.toggle('d-none', open);
        if (iconClose) iconClose.classList.toggle('d-none', !open);
        if (label) label.textContent = open ? 'Fermer' : 'Menu';
        document.body.classList.toggle('admin-mobile-menu-open', open);
    }

    menu.addEventListener('show.bs.collapse', function () { setOpen(true); });
    menu.addEventListener('hide.bs.collapse', function () { setOpen(false); });

    menu.querySelectorAll('[data-admin-nav-link]').forEach(function (link) {
        link.addEventListener('click', function () {
            if (window.bootstrap && bootstrap.Collapse) {
                var instance = bootstrap.Collapse.getInstance(menu);
                if (instance) instance.hide();
            }
        });
    });
})();
</script>
{% endblock %}
