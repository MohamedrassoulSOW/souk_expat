{% extends 'base.html.twig' %}

{% block body_attributes %} class="dashboard-admin-page"{% endblock %}

{% block whatsapp_fab %}{% endblock %}
{% block safety_disclaimer %}{% endblock %}
{% block guide_videos_hint %}{% endblock %}

{% block body %}
<div class="container-fluid p-0 dashboard-shell">
    {# ——— En-tête + menu déroulant (mobile uniquement) ——— #}
    <header class="d-md-none sticky-top dashboard-mobile-header">
        <div class="bg-white border-bottom shadow-sm px-3 py-2">
            <div class="d-flex align-items-center gap-2">
                <a href="{{ path('app_dashboard') }}" class="flex-shrink-0 text-decoration-none" title="Tableau de bord">
                    <img src="{{ asset('logo-souk-expat-nav.png') }}" alt="SoukExpat" width="110" height="34" class="admin-mobile-logo" decoding="async">
                </a>
                <div class="min-w-0 flex-grow-1">
                    <div class="admin-mobile-kicker">Administration</div>
                    <div class="fw-bold text-truncate admin-mobile-title">{% block admin_mobile_title %}Menu{% endblock %}</div>
                </div>
                {{ include('layouts/_theme_toggle.html.twig', { btn_class: 'theme-toggle--admin' }) }}
                <button class="btn admin-menu-toggle flex-shrink-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#adminMobileDropdown"
                        aria-expanded="false"
                        aria-controls="adminMobileDropdown"
                        id="adminMenuToggleBtn">
                    <i class="bi bi-list admin-menu-toggle__icon-open" aria-hidden="true"></i>
                    <i class="bi bi-x-lg admin-menu-toggle__icon-close d-none" aria-hidden="true"></i>
                    <span class="admin-menu-toggle__label">Menu</span>
                </button>
            </div>
        </div>

        <div class="collapse admin-mobile-dropdown" id="adminMobileDropdown">
            <div class="admin-mobile-dropdown__panel">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                    <span class="small fw-bold text-uppercase text-muted" style="letter-spacing: .06em;">Navigation</span>
                    <button type="button" class="btn btn-sm btn-light border rounded-pill px-3"
                            data-bs-toggle="collapse" data-bs-target="#adminMobileDropdown"
                            aria-label="Fermer le menu">
                        Fermer
                    </button>
                </div>
                {{ include('admin/_sidebar_nav_content.html.twig', { nav_mobile: true }) }}
                <div class="mt-3 pt-3 border-top">
                    {{ include('security/_logout_button.html.twig', {
                        variant: 'sidebar-footer',
                        form_class: 'd-block m-0'
                    }) }}
                </div>
            </div>
        </div>
    </header>

    <div class="row g-0 align-items-stretch dashboard-main-row">
        {{ include('admin/_sidebar.html.twig') }}

        <main class="col-12 col-md-9 col-lg-10 dashboard-main custom-scrollbar p-3 p-sm-4">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} border-0 shadow-sm rounded-3 alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block admin_main %}{% endblock %}
        </main>
    </div>
</div>

<script>
(function () {
    var menu = document.getElementById('adminMobileDropdown');
    var btn = document.getElementById('adminMenuToggleBtn');
    if (menu && btn) {
        var iconOpen = btn.querySelector('.admin-menu-toggle__icon-open');
        var iconClose = btn.querySelector('.admin-menu-toggle__icon-close');
        var label = btn.querySelector('.admin-menu-toggle__label');

        function setOpen(open) {
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            btn.classList.toggle('is-open', open);
            if (iconOpen) iconOpen.classList.toggle('d-none', open);
            if (iconClose) iconClose.classList.toggle('d-none', !open);
            if (label) label.textContent = open ? 'Fermer' : 'Menu';
            document.body.classList.toggle('admin-mobile-menu-open', open);
        }

        menu.addEventListener('show.bs.collapse', function () { setOpen(true); });
        menu.addEventListener('hide.bs.collapse', function () { setOpen(false); });

        menu.querySelectorAll('[data-admin-nav-link]').forEach(function (link) {
            link.addEventListener('click', function () {
                if (window.bootstrap && bootstrap.Collapse) {
                    var instance = bootstrap.Collapse.getInstance(menu);
                    if (instance) instance.hide();
                }
            });
        });
    }
})();

/* Recherche tableaux admin (catégories / villes) — autonome, sans asset mapper */
(function () {
    function stripAccents(str) {
        return String(str || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '');
    }

    function bindAdminTableSearch() {
        document.querySelectorAll('input.js-admin-table-search').forEach(function (input) {
            if (input.dataset.boundAdminSearch === '1') return;
            input.dataset.boundAdminSearch = '1';

            var table = document.querySelector(input.getAttribute('data-table-target') || '');
            if (!table) return;

            var emptyEl = document.querySelector(input.getAttribute('data-empty-target') || '');
            var countEl = document.querySelector(input.getAttribute('data-count-target') || '');
            var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr[data-search]'));

            function apply() {
                var q = stripAccents((input.value || '').trim());
                var visible = 0;
                rows.forEach(function (row) {
                    var hay = stripAccents(row.getAttribute('data-search') || '');
                    var match = !q || hay.indexOf(q) !== -1;
                    row.classList.toggle('d-none', !match);
                    if (match) visible += 1;
                });
                if (emptyEl) {
                    emptyEl.classList.toggle('d-none', visible > 0 || rows.length === 0);
                }
                if (countEl) {
                    countEl.textContent = String(visible);
                }
            }

            input.addEventListener('input', apply);
            input.addEventListener('search', apply);
            apply();
        });
    }

    document.addEventListener('DOMContentLoaded', bindAdminTableSearch);
    document.addEventListener('turbo:load', bindAdminTableSearch);
})();

/* Menus Actions : ouverture vers le haut si pas assez de place en bas */
(function () {
    if (window.__soukSmartDropupBoundInline) return;
    window.__soukSmartDropupBoundInline = true;

    document.addEventListener('show.bs.dropdown', function (event) {
        var toggle = event.target;
        if (!toggle || !toggle.closest) return;

        var dropdown = toggle.closest('.dropdown, .dropup');
        if (!dropdown) return;
        if (dropdown.closest('.modern-nav, .navbar, .nav-quick-actions, .nav-account-card, .nav-notif-dropdown')) {
            return;
        }

        var menu = dropdown.querySelector('.dropdown-menu');
        if (!menu) return;

        var rect = toggle.getBoundingClientRect();
        var spaceBelow = window.innerHeight - rect.bottom;
        var spaceAbove = rect.top;

        var prevDisplay = menu.style.display;
        var prevVisibility = menu.style.visibility;
        menu.style.visibility = 'hidden';
        menu.style.display = 'block';
        var menuHeight = Math.max(menu.offsetHeight, 180);
        menu.style.display = prevDisplay;
        menu.style.visibility = prevVisibility;

        var needUp = spaceBelow < menuHeight + 12 && spaceAbove > spaceBelow;
        dropdown.classList.toggle('dropup', needUp);
    });

    document.addEventListener('hidden.bs.dropdown', function (event) {
        var toggle = event.target;
        if (!toggle || !toggle.closest) return;
        var dropdown = toggle.closest('.dropdown, .dropup');
        if (dropdown && !dropdown.classList.contains('js-keep-dropup')) {
            dropdown.classList.remove('dropup');
        }
    });
})();
</script>
{% endblock %}
