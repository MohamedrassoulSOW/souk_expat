{% extends 'admin/base_admin.html.twig' %}

{% block title %}Annonces en attente | SoukExpat{% endblock %}
{% block admin_mobile_title %}En attente{% endblock %}

{% block admin_main %}
    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Modération',
        title: 'Annonces en attente',
        lead: 'Validez ou refusez les annonces soumises par la communauté.',
        actions: '<span class="admin-badge">' ~ (annonces|length|cap999) ~ ' en attente</span>'
    }) }}

    {% if annonces is empty %}
        <div class="admin-panel text-center py-5 px-3">
            <div class="mb-3 text-success" style="font-size: 2.5rem;"><i class="bi bi-check2-circle" aria-hidden="true"></i></div>
            <h2 class="h5 fw-bold">Tout est à jour</h2>
            <p class="text-muted mb-0">Aucune annonce en attente de modération.</p>
        </div>
    {% else %}
        <div class="admin-panel">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-3 py-3 border-0">Annonce</th>
                            <th class="py-3 border-0 d-none d-md-table-cell">Auteur</th>
                            <th class="py-3 border-0">Prix</th>
                            <th class="py-3 border-0 d-none d-lg-table-cell">Date</th>
                            <th class="pe-3 py-3 border-0 text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for annonce in annonces %}
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        {% if annonce.annonceImages|length > 0 %}
                                            <img src="{{ asset('uploads/annonces/' ~ annonce.annonceImages[0].imadeName) }}"
                                                 class="rounded-3" width="44" height="44" style="object-fit: cover;" alt="" loading="lazy">
                                        {% endif %}
                                        <div class="min-w-0">
                                            <div class="fw-bold text-truncate">{{ annonce.title }}</div>
                                            <small class="text-muted">{{ annonce.city.name|default('—') }}</small>
                                            <div class="small text-muted d-md-none">{{ annonce.user.email }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="small d-none d-md-table-cell">{{ annonce.user.email }}</td>
                                <td><span class="admin-badge">{{ annonce.price|number_format(0, ',', ' ') }} MAD</span></td>
                                <td class="small text-muted d-none d-lg-table-cell text-nowrap">{{ annonce.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="pe-3 text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-1">
                                        <a href="{{ path('admin_annonce_show', {id: annonce.id}) }}" class="btn btn-outline-secondary btn-sm btn-icon-action" title="Voir" aria-label="Voir">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>
                                        <form method="post" action="{{ path('admin_annonce_approve', {id: annonce.id}) }}" class="d-inline" onsubmit="return confirm('Approuver cette annonce ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ annonce.id) }}">
                                            <button type="submit" class="btn btn-success btn-sm btn-icon-action" title="Approuver" aria-label="Approuver"><i class="bi bi-check-lg" aria-hidden="true"></i></button>
                                        </form>
                                        <form method="post" action="{{ path('admin_annonce_reject', {id: annonce.id}) }}" class="d-inline" onsubmit="return confirm('Refuser cette annonce ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ annonce.id) }}">
                                            <button type="submit" class="btn btn-warning btn-sm btn-icon-action" title="Refuser" aria-label="Refuser"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
                                        </form>
                                        {{ include('admin/annonce/_delete_form.html.twig', { annonce: annonce }) }}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
