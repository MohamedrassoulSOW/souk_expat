{% extends 'base.html.twig' %}

{% block title %}{{ annonce.title }} | Modération{% endblock %}

{% block body %}
{{ include('layouts/flush_message.html.twig') }}

<main class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">{{ annonce.title }}</h1>
        <a href="{{ path('admin_annonces_pending') }}" class="btn btn-outline-secondary btn-sm">
            ← Retour à la liste
        </a>
    </div>

    <div class="row">
        <div class="col-md-5">
            {% if annonce.annonceImages|length > 0 %}
                <div id="carouselAnnonce" class="carousel slide mb-3 shadow-sm" data-bs-ride="carousel">
                    <div class="carousel-inner rounded">
                        {% for image in annonce.annonceImages %}
                            <div class="carousel-item {% if loop.first %}active{% endif %}">
                                {# Correction ici : imageName au lieu de imadeName #}
                                <img src="{{ asset('uploads/annonces/' ~ image.imadeName) }}"
                                    class="d-block w-100"
                                    style="height: 400px; object-fit: cover;"
                                    alt="{{ annonce.title }}">
                            </div>
                        {% endfor %}
                    </div>
                    {% if annonce.annonceImages|length > 1 %}
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselAnnonce" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselAnnonce" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    {% endif %}
                </div>
            {% else %}
                <div class="bg-light d-flex align-items-center justify-content-center rounded mb-3" style="height: 300px;">
                    <span class="text-muted">Aucune image disponible</span>
                </div>
            {% endif %}
        </div>

        <div class="col-md-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title border-bottom pb-2 mb-3">Détails de l'annonce</h5>
                    
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="text-muted small d-block">Référence (ID)</label>
                            <span>#{{ annonce.id }}</span>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small d-block">Prix</label>
                            <span class="fw-bold text-primary">{{ annonce.price|number_format(0, '.', ' ') }} MAD</span>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small d-block">Statut actuel</label>
                            {% if annonce.status == 'pending' %}
                                <span class="badge bg-warning text-dark">⏳ En attente</span>
                            {% elseif annonce.status == 'approved' %}
                                <span class="badge bg-success">✅ Validée</span>
                            {% else %}
                                <span class="badge bg-danger">❌ Rejetée</span>
                            {% endif %}
                        </div>
                        <div class="col-6">
                            <label class="text-muted small d-block">Ville / Quartier</label>
                            <span>{{ annonce.city.name|default('N/A') }}</span>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small d-block">Catégorie</label>
                            <span>{{ annonce.category.name|default('N/A') }}</span>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small d-block">Contact</label>
                            <span>{{ annonce.phone|default('Non renseigné') }}</span>
                        </div>
                        <div class="col-12">
                            <label class="text-muted small d-block border-top pt-2 mt-2">Description</label>
                            <p class="mt-1">{{ annonce.description|nl2br }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {% if is_granted('ROLE_ADMIN') and annonce.status == 'pending' %}
                <div class="alert alert-info d-flex align-items-center justify-content-between">
                    <div>
                        <strong>Action requise :</strong> Souhaitez-vous publier cette annonce ?
                    </div>
                    <div class="d-flex gap-2">
                        <form method="post" action="{{ path('admin_annonce_approve', {id: annonce.id}) }}" onsubmit="return confirm('Approuver cette annonce ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ annonce.id) }}">
                            <button class="btn btn-success">Valider</button>
                        </form>

                        <form method="post" action="{{ path('admin_annonce_reject', {id: annonce.id}) }}" onsubmit="return confirm('Rejeter cette annonce ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ annonce.id) }}">
                            <button class="btn btn-danger">Refuser</button>
                        </form>
                    </div>
                </div>
            {% endif %}
            </div>
        </div>
    </div>
</main>
{% endblock %}