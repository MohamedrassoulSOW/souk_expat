{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ annonce.title }} | Modération{% endblock %}
{% block admin_mobile_title %}Modération{% endblock %}

{% block admin_main %}
    {% set back_route = annonce.status == 'approved' ? 'admin_annonces_approved' : (annonce.status == 'rejected' ? 'admin_annonces_rejected' : 'admin_annonces_pending') %}
    {% set actions %}
        <a href="{{ path(back_route) }}" class="btn btn-light border rounded-pill px-3">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour
        </a>
        <a href="{{ path('app_annonce_show', {id: annonce.id}) }}" class="btn btn-outline-secondary rounded-pill px-3" target="_blank" rel="noopener">
            <i class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></i>Voir sur le site
        </a>
    {% endset %}

    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Modération',
        title: annonce.title,
        lead: 'Contrôle et actions sur l’annonce #' ~ annonce.id ~ '.',
        actions: actions
    }) }}

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="admin-panel p-3">
                {% if annonce.annonceImages|length > 0 %}
                    <div id="carouselAnnonceAdmin" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner rounded-3">
                            {% for image in annonce.annonceImages %}
                                <div class="carousel-item {% if loop.first %}active{% endif %}">
                                    <img src="{{ asset('uploads/annonces/' ~ image.imadeName) }}"
                                         class="d-block w-100"
                                         style="height: 320px; object-fit: cover;"
                                         alt="{{ annonce.title }}">
                                </div>
                            {% endfor %}
                        </div>
                        {% if annonce.annonceImages|length > 1 %}
                            <button class="carousel-control-prev" type="button" data-bs-target="#carouselAnnonceAdmin" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#carouselAnnonceAdmin" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="bg-light d-flex align-items-center justify-content-center rounded-3" style="height: 240px;">
                        <span class="text-muted">Aucune image</span>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="col-lg-7">
            <div class="admin-panel p-4 mb-3">
                <h2 class="h6 fw-bold text-uppercase text-muted mb-3" style="letter-spacing:.04em;">Détails</h2>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="small text-muted">Référence</div>
                        <div class="fw-semibold">#{{ annonce.id }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small text-muted">Prix</div>
                        <div class="fw-bold text-brand">{{ annonce.price|number_format(0, '.', ' ') }} MAD</div>
                    </div>
                    <div class="col-6">
                        <div class="small text-muted">Statut</div>
                        {% if annonce.status == 'pending' %}
                            <span class="badge bg-warning text-dark">En attente</span>
                        {% elseif annonce.status == 'approved' %}
                            <span class="badge bg-success">Validée</span>
                        {% else %}
                            <span class="badge bg-danger">Refusée</span>
                        {% endif %}
                    </div>
                    <div class="col-6">
                        <div class="small text-muted">Ville</div>
                        <div>{{ annonce.city.name|default('N/A') }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small text-muted">Catégorie</div>
                        <div>{{ annonce.category.name|default('N/A') }}</div>
                    </div>
                    <div class="col-6">
                        <div class="small text-muted">Vendeur</div>
                        <div>{{ annonce.user ? annonce.user.firstName ~ ' ' ~ annonce.user.lastName : '—' }}</div>
                    </div>
                    <div class="col-12">
                        <div class="small text-muted border-top pt-3">Description</div>
                        <p class="mb-0 mt-1">{{ annonce.description|nl2br }}</p>
                    </div>
                </div>
            </div>

            <div class="admin-panel p-3 d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <div class="small text-muted">Actions de modération</div>
                <div class="d-flex flex-wrap gap-2">
                    {% if annonce.status == 'pending' %}
                        <form method="post" action="{{ path('admin_annonce_approve', {id: annonce.id}) }}" onsubmit="return confirm('Valider cette annonce ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ annonce.id) }}">
                            <button class="btn btn-success btn-sm rounded-pill px-3">Valider</button>
                        </form>
                        <form method="post" action="{{ path('admin_annonce_reject', {id: annonce.id}) }}" onsubmit="return confirm('Refuser cette annonce ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ annonce.id) }}">
                            <button class="btn btn-warning btn-sm rounded-pill px-3">Refuser</button>
                        </form>
                    {% elseif annonce.status == 'rejected' %}
                        <form method="post" action="{{ path('admin_annonce_approve', {id: annonce.id}) }}" onsubmit="return confirm('Valider cette annonce ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ annonce.id) }}">
                            <button class="btn btn-success btn-sm rounded-pill px-3">Valider</button>
                        </form>
                    {% elseif annonce.status == 'approved' %}
                        <form method="post" action="{{ path('admin_annonce_reject', {id: annonce.id}) }}" onsubmit="return confirm('Suspendre cette annonce ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ annonce.id) }}">
                            <button class="btn btn-warning btn-sm rounded-pill px-3">Suspendre</button>
                        </form>
                    {% endif %}
                    {{ include('admin/annonce/_delete_form.html.twig', { annonce: annonce }) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
