{% extends 'admin/base_admin.html.twig' %}

{% block title %}Annonces refusées | SoukExpat{% endblock %}
{% block admin_mobile_title %}Refusées{% endblock %}

{% block admin_main %}
    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Modération',
        title: 'Annonces refusées',
        lead: 'Validez à nouveau une annonce ou supprimez-la définitivement.',
        actions: '<span class="admin-badge">' ~ (annonces|length|cap999) ~ ' refusée' ~ (annonces|length > 1 ? 's' : '') ~ '</span>'
    }) }}

    <div class="admin-panel">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3 border-0">Annonceur</th>
                        <th class="py-3 border-0">Titre</th>
                        <th class="py-3 border-0">Prix</th>
                        <th class="py-3 border-0 d-none d-md-table-cell">Déposée le</th>
                        <th class="pe-3 py-3 border-0 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for annonce in annonces %}
                        <tr>
                            <td class="ps-3">{{ annonce.user.firstName }} {{ annonce.user.lastName }}</td>
                            <td class="fw-bold">{{ annonce.title|u.truncate(40, '…') }}</td>
                            <td>{{ annonce.price|number_format(0, ',', ' ') }} MAD</td>
                            <td class="small text-muted text-nowrap d-none d-md-table-cell">{{ annonce.createdAt|date('d/m/Y') }}</td>
                            <td class="pe-3 text-end">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <a href="{{ path('admin_annonce_show', {id: annonce.id}) }}" class="btn btn-sm btn-outline-secondary btn-icon-action" title="Voir" aria-label="Voir"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    <form method="post" action="{{ path('admin_annonce_approve', {id: annonce.id}) }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ annonce.id) }}">
                                        <button type="submit" class="btn btn-sm btn-success btn-icon-action" title="Valider" aria-label="Valider"><i class="bi bi-check-lg" aria-hidden="true"></i></button>
                                    </form>
                                    {{ include('admin/annonce/_delete_form.html.twig', { annonce: annonce }) }}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-5">Aucune annonce refusée.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
