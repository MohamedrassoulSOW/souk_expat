{% extends 'admin/base_admin.html.twig' %}

{% block title %}Contacts | SoukExpat{% endblock %}
{% block admin_mobile_title %}Contacts{% endblock %}

{% block admin_main %}
    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Gestion',
        title: 'Messages contact',
        lead: 'Demandes reçues via le formulaire du site.',
        actions: '<span class="admin-badge">' ~ (contacts|length|cap999) ~ ' message' ~ (contacts|length > 1 ? 's' : '') ~ '</span>'
    }) }}

    <div class="admin-panel">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3 border-0">Réception</th>
                        <th class="py-3 border-0">Expéditeur</th>
                        <th class="py-3 border-0 d-none d-md-table-cell">Objet</th>
                        <th class="py-3 border-0">Statut</th>
                        <th class="pe-3 py-3 border-0 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for contact in contacts %}
                        <tr class="{{ not contact.isProcessed ? 'table-warning' : '' }}">
                            <td class="ps-3">
                                <div class="fw-semibold small">{{ contact.createdAt|date('d/m/Y') }}</div>
                                <div class="text-muted small">{{ contact.createdAt|date('H:i') }}</div>
                            </td>
                            <td>
                                <div class="fw-bold small">{{ contact.name }}</div>
                                <div class="text-muted small">{{ contact.email }}</div>
                                <div class="text-truncate small d-md-none" style="max-width: 180px;">{{ contact.subject }}</div>
                            </td>
                            <td class="d-none d-md-table-cell" style="max-width: 280px;">
                                <div class="fw-semibold small text-truncate">{{ contact.subject }}</div>
                                <div class="text-muted small text-truncate">{{ contact.message }}</div>
                            </td>
                            <td>
                                {% if contact.isProcessed %}
                                    <span class="badge rounded-pill bg-success-subtle text-success">Traité</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-warning-subtle text-dark">Nouveau</span>
                                {% endif %}
                            </td>
                            <td class="pe-3 text-end">
                                <a href="{{ path('app_admin_contact_show', {id: contact.id}) }}" class="btn btn-sm btn-admin-primary btn-icon-action" title="Ouvrir" aria-label="Ouvrir">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-5">Boîte de réception vide.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
