{% extends 'admin/base_admin.html.twig' %}

{% block title %}Message — {{ contact.name }} | SoukExpat{% endblock %}
{% block admin_mobile_title %}Message{% endblock %}

{% block admin_main %}
    {% set actions %}
        <a href="{{ path('app_admin_contact_index') }}" class="btn btn-light border rounded-pill px-3 bg-white">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour
        </a>
    {% endset %}

    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Contacts',
        title: contact.subject,
        lead: 'Reçu le ' ~ contact.createdAt|date('d/m/Y à H:i'),
        actions: actions
    }) }}

    <div class="row g-3 g-lg-4">
        <div class="col-lg-8">
            <div class="admin-panel p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <span class="text-muted small">Message #{{ contact.id }}</span>
                    {% if contact.isProcessed %}
                        <span class="badge rounded-pill bg-success-subtle text-success">Traité</span>
                    {% else %}
                        <span class="badge rounded-pill bg-warning-subtle text-dark">En attente</span>
                    {% endif %}
                </div>
                <div class="p-3 p-md-4 rounded-3 bg-light border-start border-4" style="border-color: var(--cyan-main) !important; white-space: pre-line; line-height: 1.7;">
                    {{ contact.message }}
                </div>
                <div class="mt-3 d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-light border rounded-pill px-3" onclick="window.print()">
                        <i class="bi bi-printer me-1" aria-hidden="true"></i>Imprimer
                    </button>
                    <button type="button" class="btn btn-admin-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#replyModal{{ contact.id }}">
                        <i class="bi bi-reply me-1" aria-hidden="true"></i>Répondre
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="admin-panel p-4 mb-3">
                <h2 class="h6 fw-bold text-uppercase text-muted mb-3" style="letter-spacing: .04em;">Expéditeur</h2>
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white flex-shrink-0"
                         style="width: 48px; height: 48px; background: var(--cyan-main);">
                        {{ contact.name|first|upper }}
                    </div>
                    <div class="min-w-0">
                        <div class="fw-bold text-truncate">{{ contact.name }}</div>
                        <a href="mailto:{{ contact.email }}" class="small text-muted text-decoration-none text-truncate d-block">{{ contact.email }}</a>
                    </div>
                </div>
                <a href="mailto:{{ contact.email }}" class="btn btn-outline-secondary w-100 rounded-pill">
                    E-mail direct
                </a>
            </div>

            <div class="admin-panel p-4">
                <h2 class="h6 fw-bold text-uppercase text-muted mb-3" style="letter-spacing: .04em;">Gestion</h2>
                <form method="post" action="{{ path('app_admin_contact_toggle', {id: contact.id}) }}" class="mb-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('contact_toggle' ~ contact.id) }}">
                    <button type="submit" class="btn {{ contact.isProcessed ? 'btn-light border' : 'btn-success' }} w-100 rounded-pill">
                        {{ contact.isProcessed ? 'Réouvrir' : 'Marquer comme traité' }}
                    </button>
                </form>
                <button type="button" class="btn btn-admin-primary w-100 rounded-pill mb-3" data-bs-toggle="modal" data-bs-target="#replyModal{{ contact.id }}">
                    Notifier l’utilisateur
                </button>
                <form method="post" action="{{ path('app_admin_contact_delete', {id: contact.id}) }}" class="text-center" onsubmit="return confirm('Suppression irréversible ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('contact_delete' ~ contact.id) }}">
                    <button type="submit" class="btn btn-outline-danger btn-icon-action" title="Supprimer" aria-label="Supprimer">
                        <i class="bi bi-trash3" aria-hidden="true"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="replyModal{{ contact.id }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form action="{{ path('app_admin_contact_reply', {id: contact.id}) }}" method="POST" class="modal-content border-0 shadow rounded-4">
                <input type="hidden" name="_token" value="{{ csrf_token('contact_reply' ~ contact.id) }}">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">Répondre à {{ contact.name }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-3">L’utilisateur recevra une notification sur son compte{% if site %} {{ site.siteName }}{% else %} SoukExpat{% endif %}.</p>
                    <label class="form-label small fw-bold">Votre réponse</label>
                    <textarea name="reply_message" class="form-control rounded-3" rows="6" placeholder="Soyez clair et courtois…" required></textarea>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-admin-primary rounded-pill px-3">Envoyer</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
