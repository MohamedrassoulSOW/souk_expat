{% extends 'page/static_base.html.twig' %}

{% block title %}À propos — {{ site ? site.siteName : 'SoukExpat' }}{% endblock %}

{% block page_badge %}Qui sommes-nous{% endblock %}
{% block page_heading %}{{ site ? site.aboutHeading : 'Bienvenue sur SoukExpat' }}{% endblock %}
{% block page_lead %}{{ site ? site.aboutLead : 'La passerelle entre les expatriés et les meilleures opportunités locales au Maroc.' }}{% endblock %}

{% block static_body %}
<div class="row align-items-center g-4 g-lg-5 mb-5">
    <div class="col-lg-6 order-lg-2">
        <img src="{{ asset('images/souk_expat.jpg') }}"
             alt="Communauté {{ site ? site.siteName : 'SoukExpat' }}"
             class="img-fluid rounded-4 shadow-sm w-100 about-hero-img"
             style="border: 1px solid rgba(66, 177, 206, 0.2); object-fit: cover; max-height: 420px;">
    </div>
    <div class="col-lg-6 order-lg-1">
        <p class="text-secondary mb-4">{{ site ? site.aboutBody : '' }}</p>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_annonce_new') }}" class="btn btn-lg text-white border-0 px-4 rounded-pill about-btn-brand">
                Déposer une annonce
            </a>
            <a href="{{ path('app_annonce_index') }}" class="btn btn-lg btn-outline-secondary rounded-pill px-4">
                Parcourir les annonces
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="p-4 h-100 text-center static-card-soft">
            <div class="static-icon-circle mx-auto mb-3"><i class="bi bi-shield-check"></i></div>
            <h3 class="h5 fw-bold text-dark mb-2">{{ site ? site.aboutValue1Title : 'Sécurité' }}</h3>
            <p class="text-secondary small mb-0">{{ site ? site.aboutValue1Text : '' }}</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 h-100 text-center static-card-soft">
            <div class="static-icon-circle mx-auto mb-3"><i class="bi bi-people"></i></div>
            <h3 class="h5 fw-bold text-dark mb-2">{{ site ? site.aboutValue2Title : 'Communauté' }}</h3>
            <p class="text-secondary small mb-0">{{ site ? site.aboutValue2Text : '' }}</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 h-100 text-center static-card-soft">
            <div class="static-icon-circle mx-auto mb-3"><i class="bi bi-lightning-charge"></i></div>
            <h3 class="h5 fw-bold text-dark mb-2">{{ site ? site.aboutValue3Title : 'Rapidité' }}</h3>
            <p class="text-secondary small mb-0">{{ site ? site.aboutValue3Text : '' }}</p>
        </div>
    </div>
</div>

<style>
    .about-btn-brand { background: #42B1CE; border-color: #42B1CE; }
    .about-btn-brand:hover { background: #369ab3; border-color: #369ab3; color: #fff; }
</style>
{% endblock %}
