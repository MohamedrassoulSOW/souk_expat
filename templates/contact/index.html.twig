{% extends 'base.html.twig' %}

{% block title %}Contact — Expat Souk{% endblock %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}

{# En-tête pleine largeur #}
<header class="page-hero">
    <div class="container">
        <div class="page-hero__inner">
            <span class="page-hero__badge">Contact</span>
            <h1 class="page-hero__title">Une question ? Écrivez-nous</h1>
            <p class="page-hero__lead">
                Notre équipe répond en général sous <strong>24 à 48 h ouvrées</strong>.
                Vous pouvez aussi consulter la <a href="{{ path('app_faq') }}">FAQ</a>
                avant d’envoyer votre message.
            </p>
        </div>
    </div>
</header>

<section class="contact-page-body">
    <div class="container py-5">
        <div class="row justify-content-center mb-4">
            <div class="col-lg-10">
            </div>
        </div>

        <div class="row g-4 g-xl-5 align-items-stretch">
            {# Colonne infos #}
            <div class="col-lg-5">
                <div class="contact-aside-card h-100 text-white position-relative overflow-hidden rounded-4 shadow-lg">
                    <div class="contact-aside-pattern" aria-hidden="true"></div>
                    <div class="position-relative p-4 p-lg-5">
                        <p class="text-white-50 small text-uppercase fw-semibold letter-spacing mb-2">Coordonnées</p>
                        <h2 class="h4 fw-bold mb-4">Informations utiles</h2>
                        <p class="text-white-50 mb-4 pb-2 border-bottom border-white border-opacity-25">
                            Pour un traitement rapide, indiquez votre sujet et des détails précis (référence d’annonce, capture d’écran, etc.).
                        </p>

                        <ul class="list-unstyled mb-0 contact-info-list">
                            <li class="d-flex mb-4">
                                <span class="contact-info-icon"><i class="bi bi-geo-alt"></i></span>
                                <div>
                                    <span class="d-block small text-white-50 mb-1">Adresse</span>
                                    <span class="fw-medium">{{ site ? site.contactAddress : 'Anfa Place, 20250 Casablanca, Maroc' }}</span>
                                </div>
                            </li>
                            <li class="d-flex mb-4">
                                <span class="contact-info-icon"><i class="bi bi-envelope-at"></i></span>
                                <div>
                                    <span class="d-block small text-white-50 mb-1">E-mail</span>
                                    <a href="mailto:{{ contact_email }}" class="contact-aside-link">{{ contact_email }}</a>
                                </div>
                            </li>
                            {% if site and site.contactPhone %}
                            <li class="d-flex mb-4">
                                <span class="contact-info-icon"><i class="bi bi-telephone"></i></span>
                                <div>
                                    <span class="d-block small text-white-50 mb-1">Téléphone</span>
                                    <a href="tel:{{ site.contactPhone }}" class="contact-aside-link">{{ site.contactPhone }}</a>
                                </div>
                            </li>
                            {% endif %}
                            <li class="d-flex mb-0">
                                <span class="contact-info-icon"><i class="bi bi-clock"></i></span>
                                <div>
                                    <span class="d-block small text-white-50 mb-1">Disponibilité</span>
                                    <span class="fw-medium">{{ site ? site.contactHours : 'Lun – Ven, 9h – 18h (Maroc)' }}</span>
                                </div>
                            </li>
                        </ul>

                        {% if site and (site.facebookUrl or site.instagramUrl or site.linkedinUrl) %}
                        <div class="mt-5 pt-4 border-top border-white border-opacity-25">
                            <p class="small text-white-50 mb-3">Réseaux</p>
                            <div class="d-flex gap-2 flex-wrap">
                                {% if site.facebookUrl %}<a href="{{ site.facebookUrl }}" class="contact-social-btn" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="bi bi-facebook"></i></a>{% endif %}
                                {% if site.instagramUrl %}<a href="{{ site.instagramUrl }}" class="contact-social-btn" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="bi bi-instagram"></i></a>{% endif %}
                                {% if site.linkedinUrl %}<a href="{{ site.linkedinUrl }}" class="contact-social-btn" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>{% endif %}
                            </div>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Formulaire #}
            <div class="col-lg-7">
                <div class="card contact-form-card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 p-lg-5">
                        <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
                            <div>
                                <h2 class="h4 fw-bold text-dark mb-1">Formulaire</h2>
                                <p class="text-muted small mb-0">Répondez avec le plus de précision possible pour un traitement rapide.</p>
                            </div>
                            <a href="{{ path('app_faq') }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                <i class="bi bi-question-circle me-1"></i> FAQ
                            </a>
                        </div>

                        {{ form_start(contactForm, {'attr': {'novalidate': 'novalidate', 'class': 'contact-form'}}) }}
                            {{ form_errors(contactForm) }}

                            <div class="row g-3">
                                <div class="col-md-6">
                                    {{ form_label(contactForm.name, null, {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                                    {{ form_widget(contactForm.name, {'attr': {'class': 'form-control contact-field', 'placeholder': 'Prénom et nom', 'autocomplete': 'name'}}) }}
                                    {{ form_errors(contactForm.name) }}
                                </div>
                                <div class="col-md-6">
                                    {{ form_label(contactForm.email, null, {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                                    {{ form_widget(contactForm.email, {'attr': {'class': 'form-control contact-field', 'placeholder': 'vous@exemple.com', 'autocomplete': 'email'}}) }}
                                    {{ form_errors(contactForm.email) }}
                                </div>
                                <div class="col-12">
                                    {{ form_label(contactForm.subject, null, {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                                    {{ form_widget(contactForm.subject, {'attr': {'class': 'form-select contact-field'}}) }}
                                    {{ form_errors(contactForm.subject) }}
                                </div>
                                <div class="col-12">
                                    {{ form_label(contactForm.message, null, {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                                    {{ form_widget(contactForm.message, {'attr': {'class': 'form-control contact-field contact-field-textarea', 'rows': 6, 'placeholder': 'Décrivez votre demande le plus précisément possible…'}}) }}
                                    {{ form_errors(contactForm.message) }}
                                </div>
                            </div>

                            <div class="mt-4 pt-2">
                                <button type="submit" class="btn btn-lg w-100 w-md-auto px-5 rounded-pill fw-semibold text-white border-0 contact-submit-btn">
                                    Envoyer le message <i class="bi bi-send-fill ms-2"></i>
                                </button>
                                <p class="text-muted small mt-3 mb-0 text-center text-md-start">
                                    <i class="bi bi-shield-lock text-cyan-brand me-1"></i>
                                    Transmission sécurisée (HTTPS). Vos données servent uniquement à traiter votre demande,
                                    conformément aux <a href="{{ path('app_legal') }}" class="text-cyan-brand fw-medium">mentions légales</a>.
                                </p>
                            </div>
                        {{ form_end(contactForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .contact-page-body {
        background: linear-gradient(180deg, color-mix(in srgb, var(--cyan-main) 8%, var(--page-bg)) 0%, var(--page-bg) 40%, var(--page-bg) 100%);
        padding-bottom: 3rem;
    }
    .letter-spacing { letter-spacing: 0.06em; }
    .contact-aside-card {
        background: linear-gradient(160deg, #42B1CE 0%, #2a8da7 55%, #247a92 100%);
    }
    .contact-aside-pattern {
        position: absolute;
        inset: 0;
        opacity: 0.07;
        background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23fff'%3E%3Cpath d='M30 0h30v30H30zM0 30h30v30H0z'/%3E%3C/g%3E%3C/svg%3E");
        pointer-events: none;
    }
    .contact-info-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.18);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
        margin-right: 1rem;
    }
    .contact-aside-link {
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.35);
        transition: border-color .2s ease, opacity .2s ease;
    }
    .contact-aside-link:hover {
        color: #fff;
        border-bottom-color: #fff;
        opacity: .95;
    }
    .contact-social-btn {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: transform .2s ease, background .2s ease;
        font-size: 1.15rem;
    }
    .contact-social-btn:hover {
        background: #fff;
        color: #42B1CE;
        transform: translateY(-2px);
    }
    .contact-form-card {
        border: 1px solid rgba(66, 177, 206, 0.12) !important;
        background: var(--surface) !important;
        color: var(--text-strong);
    }
    .contact-field {
        border-radius: 12px;
        border: 2px solid var(--border-soft) !important;
        padding: 0.75rem 1rem;
        background: var(--surface-2) !important;
        color: var(--text-strong) !important;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .contact-field:focus {
        border-color: rgba(66, 177, 206, 0.55) !important;
        background: var(--surface) !important;
        box-shadow: 0 0 0 4px rgba(66, 177, 206, 0.12) !important;
        color: var(--text-strong) !important;
    }
    .contact-field-textarea {
        min-height: 140px;
        resize: vertical;
    }
    .text-cyan-brand { color: #42B1CE !important; }
    .contact-submit-btn {
        background: #42B1CE;
        box-shadow: 0 8px 24px rgba(66, 177, 206, 0.35);
        transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    }
    .contact-submit-btn:hover {
        background: #369ab3;
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(66, 177, 206, 0.4);
        color: #fff;
    }
    @media (max-width: 991px) {
        .contact-page-hero .display-5 { font-size: 1.75rem; }
        .contact-page-hero .lead { font-size: 1rem; }
    }
</style>

{{ include('layouts/footer.html.twig') }}
{% endblock %}
