{% extends 'admin/base_admin.html.twig' %}

{% block title %}Modifier {{ city.name }} | SoukExpat{% endblock %}
{% block admin_mobile_title %}Modifier{% endblock %}

{% block admin_main %}
    {% set actions %}
        <a href="{{ path('app_city_index') }}" class="btn btn-light border rounded-pill px-3 bg-white">
            Annuler
        </a>
    {% endset %}

    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Villes',
        title: 'Modifier : ' ~ city.name,
        lead: 'Mise à jour de la zone géographique.',
        actions: actions
    }) }}

    <div class="row g-3 g-lg-4">
        <div class="col-lg-8">
            <div class="admin-panel p-4">
                {{ include('city/_form.html.twig', { button_label: 'Mettre à jour' }) }}
            </div>
        </div>
        <div class="col-lg-4">
            <div class="admin-panel p-4 mb-3">
                <h2 class="h6 fw-bold mb-3">Récapitulatif</h2>
                <dl class="row small mb-0">
                    <dt class="col-5 text-muted">ID</dt>
                    <dd class="col-7 fw-semibold">#{{ city.id }}</dd>
                    <dt class="col-5 text-muted">Nom</dt>
                    <dd class="col-7 fw-semibold">{{ city.name }}</dd>
                </dl>
            </div>
            <div class="admin-panel p-4 border-top border-danger border-3">
                <h2 class="h6 fw-bold text-danger mb-2">Zone de danger</h2>
                <p class="small text-muted mb-3">
                    La suppression est irréversible et peut affecter les annonces liées.
                </p>
                {{ include('city/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
