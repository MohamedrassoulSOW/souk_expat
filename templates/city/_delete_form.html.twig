<form method="post" action="{{ path('app_city_delete', {id: city.id}) }}" class="d-inline"
      onsubmit="return confirm('Supprimer définitivement cette ville ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ city.id) }}">
    <button type="submit" class="btn btn-outline-danger btn-icon-action" title="Supprimer" aria-label="Supprimer">
        <i class="bi bi-trash3" aria-hidden="true"></i>
    </button>
</form>
