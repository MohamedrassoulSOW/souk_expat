{% extends 'admin/base_admin.html.twig' %}

{% block title %}Nouvelle ville | SoukExpat{% endblock %}
{% block admin_mobile_title %}Nouvelle ville{% endblock %}

{% block admin_main %}
    {% set actions %}
        <a href="{{ path('app_city_index') }}" class="btn btn-light border rounded-pill px-3 bg-white">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Retour
        </a>
    {% endset %}

    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Villes',
        title: 'Ajouter une ville',
        lead: 'Nouvelle zone géographique pour les filtres d’annonces.',
        actions: actions
    }) }}

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">
            <div class="admin-panel p-4">
                {{ include('city/_form.html.twig', { button_label: 'Enregistrer la ville' }) }}
            </div>
            <p class="small text-muted mt-3 mb-0">
                Vérifiez l’orthographe : les utilisateurs filtrent leurs recherches sur ces noms.
            </p>
        </div>
    </div>
{% endblock %}
