{{ form_start(form, { attr: { class: 'needs-validation', novalidate: 'novalidate' } }) }}
    <div class="mb-4">
        {{ form_label(form.name, 'Nom de la ville', { label_attr: { class: 'form-label fw-bold small text-uppercase text-muted' } }) }}
        {{ form_widget(form.name, {
            attr: {
                class: 'form-control form-control-lg rounded-3',
                placeholder: 'Ex. Casablanca, Rabat, Marrakech…'
            }
        }) }}
        <div class="text-danger small mt-1">{{ form_errors(form.name) }}</div>
    </div>
    <div class="d-grid">
        <button type="submit" class="btn btn-admin-primary btn-lg rounded-pill py-3 fw-semibold">
            <i class="bi bi-check2 me-2" aria-hidden="true"></i>{{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}
