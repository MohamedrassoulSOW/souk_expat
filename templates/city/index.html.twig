{% extends 'admin/base_admin.html.twig' %}

{% block title %}Villes | SoukExpat{% endblock %}
{% block admin_mobile_title %}Villes{% endblock %}

{% block admin_main %}
    {% set actions %}
        <a href="{{ path('app_city_new') }}" class="btn btn-admin-primary rounded-pill px-3">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Nouvelle ville
        </a>
    {% endset %}

    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Référentiels',
        title: 'Villes',
        lead: 'Zones géographiques utilisées pour filtrer les annonces.',
        actions: actions
    }) }}

    <div class="admin-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-3 border-bottom">
            <div class="admin-table-search flex-grow-1" style="max-width: 22rem;">
                <label class="visually-hidden" for="admin-city-search">Rechercher une ville</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted" aria-hidden="true"></i></span>
                    <input id="admin-city-search"
                           type="search"
                           class="form-control border-start-0 js-admin-table-search"
                           placeholder="Rechercher une ville…"
                           data-table-target="#admin-cities-table"
                           data-empty-target="#admin-cities-empty"
                           data-count-target="#admin-cities-count"
                           autocomplete="off">
                </div>
            </div>
            <span class="admin-badge"><span id="admin-cities-count">{{ cities|length|cap999 }}</span> ville{{ cities|length > 1 ? 's' : '' }}</span>
        </div>
        <div class="table-responsive">
            <table id="admin-cities-table" class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3 border-0">ID</th>
                        <th class="py-3 border-0">Nom</th>
                        <th class="pe-3 py-3 border-0 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for city in cities %}
                        <tr data-search="{{ (city.name ~ ' ' ~ city.id)|lower }}">
                            <td class="ps-3"><span class="admin-badge">#{{ city.id }}</span></td>
                            <td class="fw-semibold">{{ city.name }}</td>
                            <td class="pe-3 text-end">
                                <div class="d-inline-flex gap-1">
                                    <a href="{{ path('app_city_show', {id: city.id}) }}" class="btn btn-sm btn-light border btn-icon-action" title="Voir" aria-label="Voir">
                                        <i class="bi bi-eye" aria-hidden="true"></i>
                                    </a>
                                    <a href="{{ path('app_city_edit', {id: city.id}) }}" class="btn btn-sm btn-light border btn-icon-action" title="Modifier" aria-label="Modifier">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="text-center text-muted py-5">Aucune ville enregistrée.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div id="admin-cities-empty" class="text-center text-muted py-4 d-none">Aucune ville ne correspond à la recherche.</div>
        </div>
    </div>
{% endblock %}
