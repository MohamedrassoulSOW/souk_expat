{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ city.name }} | SoukExpat{% endblock %}
{% block admin_mobile_title %}Ville{% endblock %}

{% block admin_main %}
    {% set actions %}
        <a href="{{ path('app_city_index') }}" class="btn btn-light border btn-icon-action" title="Retour à la liste" aria-label="Retour à la liste">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
        </a>
        <a href="{{ path('app_city_edit', {id: city.id}) }}" class="btn btn-admin-primary btn-icon-action" title="Modifier" aria-label="Modifier">
            <i class="bi bi-pencil" aria-hidden="true"></i>
        </a>
    {% endset %}

    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Villes',
        title: city.name,
        lead: 'Détail de la zone géographique.',
        actions: actions
    }) }}

    <div class="row g-3 g-lg-4">
        <div class="col-md-6">
            <div class="admin-panel p-4">
                <table class="table mb-0">
                    <tbody>
                        <tr>
                            <th class="text-muted small" style="width: 35%;">ID</th>
                            <td class="font-monospace">#{{ city.id }}</td>
                        </tr>
                        <tr>
                            <th class="text-muted small">Nom</th>
                            <td class="fw-bold fs-5">{{ city.name }}</td>
                        </tr>
                    </tbody>
                </table>
                <div class="mt-3 pt-3 border-top">
                    {{ include('city/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="admin-panel h-100 d-flex flex-column align-items-center justify-content-center text-center py-5">
                <div class="rounded-circle d-flex align-items-center justify-content-center mb-3 bg-soft-info"
                     style="width: 72px; height: 72px;">
                    <i class="bi bi-geo-alt-fill fs-2" style="color: var(--cyan-main);" aria-hidden="true"></i>
                </div>
                <p class="text-muted small mb-0 px-3">
                    Les annonces publiées dans cette zone seront liées à cette localité.
                </p>
            </div>
        </div>
    </div>
{% endblock %}
