<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="theme-color" content="#42B1CE">
        {# Favicon & ajouts écran d’accueil — une seule icône PNG (évite le doublon qui masquait le logo) #}
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('logo-souk-expat.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('logo-souk-expat.png') }}">
        {# Thème clair/sombres avant le 1er paint (évite un flash de couleurs) #}
        <script>
            (function () {
                try {
                    if (localStorage.getItem('theme') === 'dark') {
                        document.documentElement.setAttribute('data-bs-theme', 'dark');
                    }
                } catch (e) {}
            })();
        </script>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" crossorigin="anonymous">
        <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body{% block body_attributes %}{% endblock %}>
        {{ include('layouts/flush_message.html.twig') }}
        <div id="app-toast-stack" class="toast-container position-fixed bottom-0 end-0 p-3 pb-4 pe-3" style="z-index: 1090;" aria-live="polite" aria-atomic="false"></div>

        {% block body %}{% endblock %}
    </body>
</html>
