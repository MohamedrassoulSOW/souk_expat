<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="description" content="SoukExpat — achetez et vendez entre expatriés au Maroc.">
        <meta name="theme-color" content="#4B79A1" media="(prefers-color-scheme: light)">
        <meta name="theme-color" content="#1B2E4B" media="(prefers-color-scheme: dark)">
        <meta name="mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-capable" content="yes">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta name="apple-mobile-web-app-title" content="SoukExpat">
        <meta name="format-detection" content="telephone=no">
        <link rel="manifest" href="{{ asset('manifest.webmanifest') }}">
        <link rel="icon" type="image/png" sizes="96x96" href="{{ asset('favicon.png') }}?v=2">
        <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('icons/icon-192.png') }}?v=2">
        <link rel="apple-touch-icon" href="{{ asset('icons/apple-touch-icon.png') }}?v=2">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('icons/apple-touch-icon.png') }}?v=2">
        <script>
            (function () {
                try {
                    var t = localStorage.getItem('theme');
                    if (t === 'dark') {
                        document.documentElement.setAttribute('data-bs-theme', 'dark');
                        document.documentElement.classList.add('theme-dark');
                    } else {
                        document.documentElement.removeAttribute('data-bs-theme');
                        document.documentElement.classList.remove('theme-dark');
                    }
                } catch (e) {}
            })();
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
        <noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet"></noscript>
        {# Vendors locaux + fallback CDN si /vendor/ absent (prod Hostinger) #}
        <script>
            window.__soukVendorCdn = {
                bootstrapCss: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css',
                bootstrapIconsCss: 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css',
                tomSelectCss: 'https://cdn.jsdelivr.net/npm/tom-select@2.4.1/dist/css/tom-select.bootstrap5.min.css',
                bootstrapJs: 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js',
                tomSelectJs: 'https://cdn.jsdelivr.net/npm/tom-select@2.4.1/dist/js/tom-select.complete.min.js',
            };
            window.__soukLoadCss = function (href) {
                if (document.querySelector('link[data-souk-fallback="' + href + '"]')) return;
                var l = document.createElement('link');
                l.rel = 'stylesheet';
                l.href = href;
                l.dataset.soukFallback = href;
                document.head.appendChild(l);
            };
            window.__soukLoadJs = function (src, cb) {
                if (document.querySelector('script[data-souk-fallback="' + src + '"]')) {
                    if (typeof cb === 'function') cb();
                    return;
                }
                var s = document.createElement('script');
                s.src = src;
                s.dataset.soukFallback = src;
                s.onload = function () { if (typeof cb === 'function') cb(); };
                document.head.appendChild(s);
            };
        </script>
        <link rel="stylesheet" href="{{ asset('vendor/bootstrap/css/bootstrap.min.css') }}"
              onerror="this.onerror=null;window.__soukLoadCss(window.__soukVendorCdn.bootstrapCss)">
        <link rel="stylesheet" href="{{ asset('vendor/bootstrap-icons/css/bootstrap-icons.min.css') }}"
              onerror="this.onerror=null;window.__soukLoadCss(window.__soukVendorCdn.bootstrapIconsCss)">
        {% if not souk_auth_light|default(false) %}
        <link rel="stylesheet" href="{{ asset('vendor/tom-select/tom-select.bootstrap5.min.css') }}"
              onerror="this.onerror=null;window.__soukLoadCss(window.__soukVendorCdn.tomSelectCss)"
              data-souk-tom-select-css>
        {% endif %}
        <script defer src="{{ asset('vendor/bootstrap/js/bootstrap.bundle.min.js') }}"
                onerror="this.onerror=null;window.__soukLoadJs(window.__soukVendorCdn.bootstrapJs)"></script>
        {% if not souk_auth_light|default(false) %}
        <script defer src="{{ asset('vendor/tom-select/tom-select.complete.min.js') }}"
                onerror="this.onerror=null;window.__soukLoadJs(window.__soukVendorCdn.tomSelectJs)"
                data-souk-tom-select-js></script>
        {% endif %}
        <script>
            window.__soukVendorLocal = {
                tomSelectCss: {{ asset('vendor/tom-select/tom-select.bootstrap5.min.css')|json_encode|raw }},
                tomSelectJs: {{ asset('vendor/tom-select/tom-select.complete.min.js')|json_encode|raw }},
            };
        </script>
        <style>
            /* Secours si Bootstrap ne charge pas (prod sans /vendor/) */
            @media (min-width: 768px) {
                #homeMobileFilters { display: none !important; }
            }
            @media (max-width: 767.98px) {
                .home-search__row > .home-search__field--select { display: none !important; }
            }
            @media (max-width: 991.98px) {
                .modern-nav .navbar-collapse:not(.show) { display: none !important; }
            }
            @media (min-width: 992px) {
                .modern-nav .navbar-nav {
                    display: flex !important;
                    flex-direction: row !important;
                    list-style: none !important;
                    padding-left: 0 !important;
                    margin-bottom: 0 !important;
                }
            }
        </style>
        <noscript><style>[data-animate]{opacity:1!important}</style></noscript>
        {% block stylesheets %}
        {% endblock %}
        <style>
            /* WhatsApp FAB styling: visible label on md+ */
            .whatsapp-fab {
                position: fixed;
                right: 1rem;
                bottom: 1rem;
                z-index: 1095;
                display: inline-flex;
                align-items: center;
                gap: .6rem;
                background: #25D366;
                color: #fff;
                padding: .5rem .9rem;
                border-radius: 999px;
                box-shadow: 0 6px 18px rgba(0,0,0,.12);
                text-decoration: none;
                font-weight: 600;
            }
            .whatsapp-fab:hover { transform: translateY(-3px); }
            .whatsapp-fab i { font-size: 1.05rem; }
            .whatsapp-fab__label { display: none; }
            @media (min-width: 768px) {
                .whatsapp-fab__label { display: inline-block; }
            }
        </style>

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var probe = document.createElement('div');
                    probe.className = 'd-none';
                    probe.style.position = 'absolute';
                    probe.style.visibility = 'hidden';
                    document.body.appendChild(probe);
                    var bootstrapMissing = window.getComputedStyle(probe).display !== 'none';
                    probe.remove();
                    if (bootstrapMissing && window.__soukVendorCdn) {
                        window.__soukLoadCss(window.__soukVendorCdn.bootstrapCss);
                        window.__soukLoadCss(window.__soukVendorCdn.bootstrapIconsCss);
                        window.__soukLoadJs(window.__soukVendorCdn.bootstrapJs);
                    }
                    if (typeof TomSelect === 'undefined' && window.__soukVendorCdn) {
                        window.__soukLoadJs(window.__soukVendorCdn.tomSelectJs, function () {
                            if (typeof window.initSiteUi === 'function') {
                                window.initSiteUi();
                            }
                        });
                    }
                });
            </script>
        {% endblock %}
    </head>
    <body{% block body_attributes %}{% if souk_auth_light|default(false) %} data-turbo="false" class="souk-auth-light"{% endif %}{% endblock %}>
        {{ include('layouts/flush_message.html.twig') }}
        <div id="app-toast-stack" class="toast-container position-fixed bottom-0 end-0 p-3 pb-4 pe-3" style="z-index: 1090;" aria-live="polite" aria-atomic="false"></div>

        {% block body %}{% endblock %}
        {% block whatsapp_fab %}
            {% if not souk_auth_light|default(false) %}
                {{ include('layouts/_whatsapp_fab.html.twig') }}
            {% endif %}
        {% endblock %}
        {% block safety_disclaimer %}
            {% if not souk_auth_light|default(false) %}
                {{ include('layouts/_safety_disclaimer_modal.html.twig') }}
            {% endif %}
        {% endblock %}
        {% block guide_videos_hint %}
            {% if not souk_auth_light|default(false) %}
                {{ include('layouts/_guide_videos_hint_modal.html.twig') }}
            {% endif %}
        {% endblock %}
    </body>
</html>
