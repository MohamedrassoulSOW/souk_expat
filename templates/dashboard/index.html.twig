{% extends 'base.html.twig' %}

{% block title %}Tableau de bord | Expat Souk{% endblock %}

{% block body %}
{# On n'inclut pas la navBar classique ici car le dashboard a sa propre Sidebar #}
{{ include('layouts/flush_message.html.twig') }}

<div class="container-fluid p-0 overflow-hidden" style="height: 100vh;">
    <div class="row g-0 h-100">

        {# --- SIDEBAR FIXE --- #}
        <aside class="col-12 col-md-3 col-lg-2 bg-white border-end d-none d-md-flex flex-column h-100">
            
            {# Header de la Sidebar #}
            <div class="p-4 border-bottom text-center">
                <a href="{{ path('app_home') }}" class="text-decoration-none">
                    <span class="fs-4 fw-bold" style="color: #42B1CE;">Expat Souk</span>
                    <p class="small text-muted mb-0 font-monospace" style="font-size: 0.7rem;">ADMINISTRATION</p>
                </a>
            </div>
            
            {# Menu de navigation scrollable si besoin #}
            <div class="flex-grow-1 overflow-y-auto p-3 custom-scrollbar">
                <ul class="nav nav-pills flex-column gap-1">
                    
                    <li class="nav-item">
                        <a href="{{ path('app_dashboard') }}" class="nav-link active-cyan shadow-sm">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                    </li>

                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="mt-4 mb-2 ms-3 small text-uppercase fw-bold text-muted opacity-50" style="letter-spacing: 1px; font-size: 0.75rem;">Modération</li>
                        
                        <li class="nav-item">
                            <a href="{{ path('admin_annonces_pending') }}" class="nav-link text-dark hover-light">
                                <i class="bi bi-clock-history me-2 text-warning"></i> En attente
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('admin_annonces_approved') }}" class="nav-link text-dark hover-light">
                                <i class="bi bi-check-circle me-2 text-success"></i> Validées
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="{{ path('admin_annonces_rejected') }}" class="nav-link text-dark hover-light">
                                <i class="bi bi-x-circle me-2 text-danger"></i> Rejetées
                            </a>
                        </li>

                        <li class="mt-4 mb-2 ms-3 small text-uppercase fw-bold text-muted opacity-50" style="letter-spacing: 1px; font-size: 0.75rem;">Gestion</li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark hover-light" href="{{ path('app_admin_contact_index') }}">
                                <i class="bi bi-chat-left-text me-2"></i> Messages
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark hover-light" href="{{ path('app_category') }}">
                                <i class="bi bi-tags me-2"></i> Catégories
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark hover-light" href="{{ path('app_city_index') }}">
                                <i class="bi bi-geo-alt me-2"></i> Villes
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>

            {# Bas de Sidebar #}
            <div class="p-3 border-top">
                <a href="{{ path('app_logout') }}" class="nav-link text-danger hover-light small">
                    <i class="bi bi-box-arrow-left me-2"></i> Déconnexion
                </a>
            </div>
        </aside>

        {# --- CONTENU PRINCIPAL SCROLLABLE --- #}
        <main class="col-12 col-md-9 col-lg-10 bg-light h-100 overflow-y-auto p-4 custom-scrollbar">

            {# En-tête de bienvenue #}
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                <div>
                    <h3 class="fw-bold mb-0 text-dark">
                        {% if app.user %}
                            Bienvenue, {{ app.user.firstName }} ! 👋
                        {% else %}
                            Bonjour
                        {% endif %}
                    </h3>
                    <p class="text-muted mb-0">Voici l'activité actuelle de votre plateforme.</p>
                </div>
                <button type="button" class="btn btn-warning rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalNotifAll">
    <i class="bi bi-megaphone me-2"></i>Alerte Globale
</button>

{# La Modal #}
<div class="modal fade" id="modalNotifAll" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form action="{{ path('admin_notify_all') }}" method="POST" class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Diffuser une information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label small fw-bold">Titre de l'annonce</label>
                    <input type="text" name="title" class="form-control rounded-3" placeholder="Ex: Maintenance prévue" required>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Message</label>
                    <textarea name="message" class="form-control rounded-3" rows="4" placeholder="Votre message ici..." required></textarea>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-warning rounded-pill px-4">Envoyer à tout le monde</button>
            </div>
        </form>
    </div>
</div>
                <a href="{{ path('app_home') }}" class="btn btn-white shadow-sm border rounded-pill px-4 bg-white">
                    <i class="bi bi-eye me-2"></i>Voir le site
                </a>
            </div>

            {# Cartes de statistiques #}
            <div class="row g-3 mb-5">
                {% set stats = [
                    {'label': 'Messages', 'val': messageCount|default(0), 'icon': 'bi-chat-dots', 'color': '#42B1CE'},
                    {'label': 'Utilisateurs', 'val': userCount|default(0), 'icon': 'bi-people', 'color': '#6610f2'},
                    {'label': 'En attente', 'val': pendingCount|default(0), 'icon': 'bi-hourglass-split', 'color': '#fd7e14'},
                    {'label': 'Validées', 'val': approvedCount|default(0), 'icon': 'bi-check2-square', 'color': '#198754'}
                ] %}

                {% for stat in stats %}
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body d-flex align-items-center p-3">
                            <div class="rounded-circle p-3 me-3 d-flex align-items-center justify-content-center flex-shrink-0" 
                                 style="background-color: {{ stat.color }}15; width: 48px; height: 48px;">
                                <i class="bi {{ stat.icon }} fs-4" style="color: {{ stat.color }};"></i>
                            </div>
                            <div class="overflow-hidden">
                                <h6 class="text-muted small mb-0 text-truncate">{{ stat.label }}</h6>
                                <h4 class="fw-bold mb-0">{{ stat.val }}</h4>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            {# Tableau des utilisateurs #}
            {% if is_granted('ROLE_ADMIN') %}
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center sticky-top rounded-top-4">
                    <h5 class="fw-bold mb-0">Gestion des utilisateurs</h5>
                    <span class="badge text-info rounded-pill px-3 py-2" style="background-color: #42B1CE20;">{{ utilisateurs|length }} membres</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small">
                                <tr>
                                    <th class="ps-4 py-3 border-0">UTILISATEUR</th>
                                    <th class="py-3 border-0">EMAIL</th>
                                    <th class="py-3 border-0">ROLES</th>
                                    <th class="py-3 border-0 text-end pe-4">ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in utilisateurs|default([]) %}
                                <tr class="border-bottom border-light">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-3 rounded-circle d-flex align-items-center justify-content-center fw-bold" 
                                                 style="width: 38px; height: 38px; background-color: #42B1CE15; color: #42B1CE;">
                                                {{ user.firstName|slice(0, 1)|upper }}
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">{{ user.firstName }} {{ user.lastName }}</div>
                                                <div class="text-muted small">ID: #{{ user.id }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted">{{ user.email }}</td>
                                    <td>
                                        {% for role in user.roles %}
                                            <span class="badge rounded-pill fw-normal px-2 py-1 {{ role == 'ROLE_ADMIN' ? 'bg-danger-subtle text-danger' : 'bg-secondary-subtle text-secondary' }}" style="font-size: 0.7rem;">
                                                {{ role|replace({'ROLE_': ''}) }}
                                            </span>
                                        {% endfor %}
                                    </td>
                                    <td class="text-end pe-4">
    <div class="dropdown">
        <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
            Gérer
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
            {# --- ACTION : BLOQUER / DÉBLOQUER --- #}
            <li>
                <a class="dropdown-item rounded-2" href="{{ path('admin_user_toggle', {'id': user.id}) }}">
                    {% if user.isBlocked %}
                        <i class="bi bi-unlock me-2 text-success"></i> Débloquer l'utilisateur
                    {% else %}
                        <i class="bi bi-slash-circle me-2 text-danger"></i> Bloquer l'utilisateur
                    {% endif %}
                </a>
            </li>

            <li><hr class="dropdown-divider opacity-50"></li>

            {# --- ACTION : ADMIN --- #}
            <li>
                <a class="dropdown-item rounded-2" href="{{ path('admin_user_editor', {'id': user.id}) }}">
                    {% if 'ROLE_ADMIN' in user.roles %}
                        <i class="bi bi-person-dash me-2"></i> Retirer Admin
                    {% else %}
                        <i class="bi bi-person-check me-2"></i> Nommer Admin
                    {% endif %}
                </a>
            </li>

            <li><hr class="dropdown-divider opacity-50"></li>

            {# --- ACTION : SUPPRIMER --- #}
            <li>
                <a class="dropdown-item rounded-2 text-danger" href="{{ path('admin_user_delete', {'id': user.id}) }}" onclick="return confirm('Confirmer la suppression ?');">
                    <i class="bi bi-trash me-2"></i> Supprimer
                </a>
            </li>
        </ul>
    </div>
</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}

        </main>
    </div>
</div>

<style>
    /* Empêcher le scroll sur le body principal */
    body { overflow: hidden; }

    /* Barre de défilement personnalisée */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #42B1CE30;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #42B1CE;
    }

    /* Styles Sidebar */
    .active-cyan { 
        background-color: #42B1CE !important; 
        color: white !important; 
    }
    .nav-link {
        transition: all 0.2s ease;
        border-radius: 10px;
        padding: 0.7rem 1rem;
        font-weight: 500;
    }
    .hover-light:hover { 
        background-color: #f8f9fa; 
        color: #42B1CE !important; 
    }

    /* Effet Sticky sur le header du tableau */
    .card-header.sticky-top {
        z-index: 10;
        top: -1px;
    }

    .bg-danger-subtle { background-color: #f8d7da; }
    .bg-secondary-subtle { background-color: #e2e3e5; }
</style>

{# Lien Bootstrap Icons #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

{% endblock %}