{% extends 'admin/base_admin.html.twig' %}

{% block title %}Tableau de bord | SoukExpat{% endblock %}
{% block admin_mobile_title %}Tableau de bord{% endblock %}

{% block admin_main %}
    {% set actions %}
        <button type="button" class="btn btn-warning rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalNotifAll">
            <i class="bi bi-megaphone me-1" aria-hidden="true"></i>Alerte globale
        </button>
    {% endset %}

    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Administration',
        title: app.user ? 'Bienvenue, ' ~ app.user.firstName ~ ' !' : 'Tableau de bord',
        lead: 'Vue d’ensemble de l’activité SoukExpat.',
        actions: actions
    }) }}

    <div class="modal fade" id="modalNotifAll" tabindex="-1" aria-labelledby="modalNotifAllLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
            <form action="{{ path('admin_notify_all') }}" method="POST" class="modal-content border-0 shadow rounded-4">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_notify_all') }}">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="modalNotifAllLabel">Diffuser une information</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Titre</label>
                        <input type="text" name="title" class="form-control rounded-3" placeholder="Ex: Maintenance prévue" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Message</label>
                        <textarea name="message" class="form-control rounded-3" rows="4" placeholder="Votre message…" required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 flex-column flex-sm-row gap-2">
                    <button type="button" class="btn btn-light rounded-pill w-100 w-sm-auto" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 w-100 w-sm-auto">Envoyer à tout le monde</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 {{ is_granted('ROLE_ADMIN') ? 'row-cols-xl-5' : 'row-cols-xl-4' }} mb-4">
        {% set stats = [
            {'label': 'Contacts', 'val': messageCount|default(0), 'icon': 'bi-inbox', 'color': '#4B79A1', 'url': path('app_admin_contact_index')},
            {'label': 'Conversations', 'val': chatThreadCount|default(0), 'icon': 'bi-chat-dots', 'color': '#0d9488', 'url': path('app_admin_chats_index')}
        ] %}
        {% if is_granted('ROLE_ADMIN') %}
            {% set stats = stats|merge([{ 'label': 'Utilisateurs', 'val': userCount|default(0), 'icon': 'bi-people', 'color': '#1B2E4B', 'cap': true, 'url': path('app_user') }]) %}
        {% endif %}
        {% set stats = stats|merge([
            {'label': 'En attente', 'val': pendingCount|default(0), 'icon': 'bi-hourglass-split', 'color': '#fd7e14', 'cap': true, 'url': path('admin_annonces_pending')},
            {'label': 'Validées', 'val': approvedCount|default(0), 'icon': 'bi-check2-square', 'color': '#198754', 'cap': true, 'url': path('admin_annonces_approved')}
        ]) %}

        {% for stat in stats %}
            <div class="col">
                <a href="{{ stat.url }}" class="text-decoration-none admin-stat-card-link">
                    <div class="admin-stat-card">
                        <div class="card-body d-flex align-items-center p-3">
                            <div class="admin-stat-card__icon me-3" style="background: {{ stat.color }}18; color: {{ stat.color }};">
                                <i class="bi {{ stat.icon }}" aria-hidden="true"></i>
                            </div>
                            <div class="overflow-hidden min-w-0">
                                <div class="text-muted small text-truncate">{{ stat.label }}</div>
                                <div class="fs-4 fw-bold mb-0 admin-stat-card__value">{% if stat.cap|default(false) %}{{ stat.val|cap999 }}{% else %}{{ stat.val }}{% endif %}</div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-4">
            <div class="admin-panel h-100">
                <div class="card-header p-3">
                    <h2 class="h6 fw-bold mb-0">Accès rapides</h2>
                </div>
                <div class="card-body p-3 d-grid gap-2">
                    <a href="{{ path('admin_annonces_pending') }}" class="btn btn-outline-warning rounded-pill text-start">
                        <i class="bi bi-clock-history me-2" aria-hidden="true"></i>Modérer les annonces
                    </a>
                    <a href="{{ path('admin_annonces_approved', { olderThan: 90 }) }}" class="btn btn-outline-danger rounded-pill text-start">
                        <i class="bi bi-trash3 me-2" aria-hidden="true"></i>Nettoyer anciennes validées
                    </a>
                    <a href="{{ path('app_admin_chats_index') }}" class="btn btn-outline-danger rounded-pill text-start">
                        <i class="bi bi-chat-left-dots me-2" aria-hidden="true"></i>Nettoyer messages discussions
                    </a>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-8">
            {% if is_granted('ROLE_ADMIN') %}
                <div class="admin-panel">
                    <div class="card-header p-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h2 class="h6 fw-bold mb-0">Utilisateurs récents</h2>
                        <a href="{{ path('app_user') }}" class="btn btn-sm btn-admin-primary rounded-pill">Tous les comptes</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light text-muted small">
                                    <tr>
                                        <th class="ps-3 py-3 border-0">Utilisateur</th>
                                        <th class="py-3 border-0 d-none d-md-table-cell">Email</th>
                                        <th class="py-3 border-0 text-end pe-3">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user in utilisateurs|default([])|slice(0, 8) %}
                                        <tr>
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                                         style="width: 36px; height: 36px; background: var(--cyan-soft); color: var(--cyan-main);">
                                                        {{ user.firstName|slice(0, 1)|upper }}
                                                    </div>
                                                    <div class="min-w-0">
                                                        <div class="fw-bold text-truncate">{{ user.firstName }} {{ user.lastName }}</div>
                                                        <div class="small text-muted d-md-none text-truncate">{{ user.email }}</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-muted small d-none d-md-table-cell">{{ user.email }}</td>
                                            <td class="text-end pe-3">
                                                <div class="dropdown js-smart-dropup">
                                                    <button class="btn btn-sm btn-light border btn-icon-action" type="button" data-bs-toggle="dropdown" data-bs-display="static" title="Actions" aria-label="Actions" aria-expanded="false">
                                                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
                                                        {{ include('admin/_user_dropdown_actions.html.twig', { user: user }) }}
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="3" class="text-center text-muted py-4">Aucun utilisateur.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="admin-panel h-100">
                    <div class="card-body p-4">
                        <h2 class="h6 fw-bold mb-2">Modération</h2>
                        <p class="text-muted small mb-3">Traitez les annonces en attente et suivez les conversations de la communauté.</p>
                        <a href="{{ path('admin_annonces_pending') }}" class="btn btn-admin-primary rounded-pill">
                            Voir les annonces en attente
                        </a>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
