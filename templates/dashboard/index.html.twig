{% extends 'base.html.twig' %}

{% block title %}Tableau de bord | Expat Souk{% endblock %}

{% block body_attributes %} class="dashboard-admin-page"{% endblock %}

{% block body %}
{# Menu latéral mobile (offcanvas) #}
<div class="offcanvas offcanvas-start" tabindex="-1" id="adminMenuOffcanvas" aria-labelledby="adminMenuOffcanvasLabel">
    <div class="offcanvas-header border-bottom py-3">
        <div>
            <h5 class="offcanvas-title fw-bold mb-0" id="adminMenuOffcanvasLabel" style="color: #42B1CE;">Expat Souk</h5>
            <p class="small text-muted mb-0 font-monospace" style="font-size: 0.7rem;">ADMINISTRATION</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer le menu"></button>
    </div>
    <div class="offcanvas-body p-0 d-flex flex-column">
        <div class="flex-grow-1 overflow-y-auto p-3">
            {{ include('admin/_sidebar_nav_content.html.twig') }}
        </div>
    </div>
</div>

<div class="container-fluid p-0 dashboard-shell">
    {# Barre supérieure mobile / tablette (< md) #}
    <header class="d-md-none sticky-top bg-white border-bottom shadow-sm py-2 px-3 d-flex align-items-center gap-2 dashboard-mobile-header">
        <button class="btn btn-outline-primary rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 p-0"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#adminMenuOffcanvas"
                aria-controls="adminMenuOffcanvas"
                style="width: 44px; height: 44px;"
                aria-label="Ouvrir le menu">
            <i class="bi bi-list fs-3" aria-hidden="true"></i>
        </button>
        <span class="fw-bold text-truncate flex-grow-1" style="color: #42B1CE;">Tableau de bord</span>
        <a href="{{ path('app_home') }}" class="btn btn-light border rounded-pill btn-sm flex-shrink-0" title="Accueil site">
            <i class="bi bi-house-door" aria-hidden="true"></i>
        </a>
    </header>

    <div class="row g-0 align-items-stretch dashboard-main-row">
        {{ include('admin/_sidebar.html.twig') }}

        <main class="col-12 col-md-9 col-lg-10 bg-light dashboard-main custom-scrollbar p-3 p-sm-4">

            <div class="d-flex flex-column flex-md-row flex-wrap justify-content-between align-items-stretch align-items-md-center mb-4 gap-3">
                <div class="order-1">
                    <h3 class="fw-bold mb-0 text-dark fs-5 fs-md-3">
                        {% if app.user %}
                            Bienvenue, {{ app.user.firstName }} !
                        {% else %}
                            Bonjour
                        {% endif %}
                    </h3>
                    <p class="text-muted mb-0 small">Voici l'activité actuelle de votre plateforme.</p>
                </div>
                <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 order-2 order-md-3 ms-md-auto">
                    <button type="button" class="btn btn-warning rounded-pill px-3 px-md-4" data-bs-toggle="modal" data-bs-target="#modalNotifAll">
                        <i class="bi bi-megaphone me-2"></i><span class="d-none d-sm-inline">Alerte </span>Globale
                    </button>
                    <a href="{{ path('app_home') }}" class="btn btn-white shadow-sm border rounded-pill px-3 px-md-4 bg-white text-center">
                        <i class="bi bi-eye me-2"></i>Voir le site
                    </a>
                </div>
            </div>

            <div class="modal fade" id="modalNotifAll" tabindex="-1" aria-labelledby="modalNotifAllLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
                    <form action="{{ path('admin_notify_all') }}" method="POST" class="modal-content border-0 shadow rounded-4">
                        <div class="modal-header border-0">
                            <h5 class="modal-title fw-bold" id="modalNotifAllLabel">Diffuser une information</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Titre de l'annonce</label>
                                <input type="text" name="title" class="form-control rounded-3" placeholder="Ex: Maintenance prévue" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Message</label>
                                <textarea name="message" class="form-control rounded-3" rows="4" placeholder="Votre message ici..." required></textarea>
                            </div>
                        </div>
                        <div class="modal-footer border-0 flex-column flex-sm-row gap-2">
                            <button type="button" class="btn btn-light rounded-pill w-100 w-sm-auto" data-bs-dismiss="modal">Annuler</button>
                            <button type="submit" class="btn btn-warning rounded-pill px-4 w-100 w-sm-auto">Envoyer à tout le monde</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 {{ is_granted('ROLE_ADMIN') ? 'row-cols-xl-5' : 'row-cols-xl-4' }} mb-4 mb-md-5">
                {% set stats = [
                    {'label': 'Contacts (formulaire)', 'val': messageCount|default(0), 'icon': 'bi-inbox', 'color': '#42B1CE'},
                    {'label': 'Conversations (chat)', 'val': chatThreadCount|default(0), 'icon': 'bi-chat-dots', 'color': '#0d9488'}
                ] %}
                {% if is_granted('ROLE_ADMIN') %}
                    {% set stats = stats|merge([{ 'label': 'Utilisateurs', 'val': userCount|default(0), 'icon': 'bi-people', 'color': '#6610f2' }]) %}
                {% endif %}
                {% set stats = stats|merge([
                    {'label': 'En attente', 'val': pendingCount|default(0), 'icon': 'bi-hourglass-split', 'color': '#fd7e14'},
                    {'label': 'Validées', 'val': approvedCount|default(0), 'icon': 'bi-check2-square', 'color': '#198754'}
                ]) %}

                {% for stat in stats %}
                <div class="col">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body d-flex align-items-center p-3">
                            <div class="rounded-circle p-3 me-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                 style="background-color: {{ stat.color }}15; width: 48px; height: 48px;">
                                <i class="bi {{ stat.icon }} fs-4" style="color: {{ stat.color }};"></i>
                            </div>
                            <div class="overflow-hidden min-w-0">
                                <h6 class="text-muted small mb-0 text-truncate">{{ stat.label }}</h6>
                                <h4 class="fw-bold mb-0">{{ stat.val }}</h4>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            {% if is_granted('ROLE_ADMIN') %}
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 p-3 p-md-4 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 sticky-top rounded-top-4 dashboard-table-head">
                    <h5 class="fw-bold mb-0">Gestion des utilisateurs</h5>
                    <span class="badge text-info rounded-pill px-3 py-2 align-self-start align-self-sm-center" style="background-color: #42B1CE20;">{{ utilisateurs|length }} membres</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small">
                                <tr>
                                    <th class="ps-3 ps-md-4 py-3 border-0">Utilisateur</th>
                                    <th class="py-3 border-0 d-none d-lg-table-cell">Email</th>
                                    <th class="py-3 border-0 d-none d-md-table-cell">Rôles</th>
                                    <th class="py-3 border-0 text-end pe-3 pe-md-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in utilisateurs|default([]) %}
                                <tr class="border-bottom border-light">
                                    <td class="ps-3 ps-md-4">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm me-2 me-md-3 rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                                 style="width: 38px; height: 38px; background-color: #42B1CE15; color: #42B1CE;">
                                                {{ user.firstName|slice(0, 1)|upper }}
                                            </div>
                                            <div class="min-w-0">
                                                <div class="fw-bold text-dark text-truncate">{{ user.firstName }} {{ user.lastName }}</div>
                                                <div class="text-muted small">#{{ user.id }}</div>
                                                <div class="text-muted small text-truncate d-lg-none">{{ user.email }}</div>
                                                <div class="d-md-none mt-1">
                                                    {% for role in user.roles %}
                                                        <span class="badge rounded-pill fw-normal px-2 py-1 {{ role == 'ROLE_ADMIN' ? 'bg-danger-subtle text-danger' : 'bg-secondary-subtle text-secondary' }}" style="font-size: 0.65rem;">
                                                            {{ role|replace({'ROLE_': ''}) }}
                                                        </span>
                                                    {% endfor %}
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted d-none d-lg-table-cell">{{ user.email }}</td>
                                    <td class="d-none d-md-table-cell">
                                        {% for role in user.roles %}
                                            <span class="badge rounded-pill fw-normal px-2 py-1 {{ role == 'ROLE_ADMIN' ? 'bg-danger-subtle text-danger' : (role == 'ROLE_EDITOR' ? 'bg-info-subtle text-info' : 'bg-secondary-subtle text-secondary') }}" style="font-size: 0.7rem;{{ role == 'ROLE_EDITOR' ? ' border: 1px solid #0d948850;' : '' }}">
                                                {{ role|replace({'ROLE_': ''}) }}
                                            </span>
                                        {% endfor %}
                                    </td>
                                    <td class="text-end pe-3 pe-md-4">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" aria-label="Actions pour {{ user.email }}">
                                                <i class="bi bi-three-dots-vertical me-1" aria-hidden="true"></i><span class="d-none d-sm-inline"> Gérer</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
                                                {{ include('admin/_user_dropdown_actions.html.twig', { user: user }) }}
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}

        </main>
    </div>
</div>

<style>
    /* Mobile / tablette : hauteur naturelle, scroll page */
    .dashboard-shell {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
    }

    .dashboard-mobile-header {
        z-index: 1030;
    }

    .dashboard-main-row {
        flex: 1 1 auto;
        min-height: 0;
    }

    /* Desktop : plein écran, scroll dans la zone principale */
    @media (min-width: 768px) {
        body.dashboard-admin-page {
            overflow: hidden;
            height: 100vh;
            height: 100dvh;
        }

        .dashboard-shell {
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
        }

        .dashboard-main-row {
            flex: 1 1 0;
            min-height: 0;
            max-height: 100%;
        }

        .dashboard-sidebar-desktop {
            height: 100%;
            max-height: 100vh;
            max-height: 100dvh;
        }

        .dashboard-main {
            height: 100%;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }
    }

    @media (max-width: 767.98px) {
        .dashboard-main {
            overflow: visible;
            height: auto;
        }
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #42B1CE30;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #42B1CE;
    }

    .active-cyan {
        background-color: #42B1CE !important;
        color: white !important;
    }
    .nav-link {
        transition: all 0.2s ease;
        border-radius: 10px;
        padding: 0.7rem 1rem;
        font-weight: 500;
    }
    .hover-light:hover {
        background-color: #f8f9fa;
        color: #42B1CE !important;
    }

    .dashboard-table-head.sticky-top {
        z-index: 10;
        top: -1px;
    }

    .bg-danger-subtle { background-color: #f8d7da; }
    .bg-secondary-subtle { background-color: #e2e3e5; }

    .min-w-0 { min-width: 0; }
</style>
{% endblock %}
