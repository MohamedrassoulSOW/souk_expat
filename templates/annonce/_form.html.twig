<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            {# Carte Principale #}
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                {# Header de la carte #}
                <div class="p-4 text-white text-center" style="background-color: #42B1CE;">
                    <h3 class="fw-bold mb-1">Créer une annonce</h3>
                    <p class="mb-0 opacity-75 small">Remplissez les détails pour attirer les acheteurs</p>
                </div>

                <div class="card-body p-4 p-md-5 bg-white">
                    {{ form_start(form, {'attr': {'class': 'row g-4', 'id': 'createAd', 'enctype': 'multipart/form-data'}}) }}

                        {# TITRE #}
                        <div class="col-12 col-md-7">
                            <label class="form-label fw-bold small text-uppercase text-muted">Titre de l'annonce</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-tag text-muted"></i></span>
                                {{ form_widget(form.title, {'attr': {'class': 'form-control border-start-0 ps-0', 'placeholder': 'Ex: iPhone 15 Pro Max...'}}) }}
                            </div>
                            {{ form_errors(form.title) }}
                        </div>

                        {# PRIX #}
                        <div class="col-6 col-md-5">
                            <label class="form-label fw-bold small text-uppercase text-muted">Prix (MAD)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-cash text-muted"></i></span>
                                {{ form_widget(form.price, {'attr': {'class': 'form-control border-start-0 ps-0', 'placeholder': '0.00'}}) }}
                            </div>
                            {{ form_errors(form.price) }}
                        </div>

                        {# CATÉGORIE #}
                        <div class="col-6 col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-muted">Catégorie</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-grid text-muted"></i></span>
                                {{ form_widget(form.category, {'attr': {'class': 'form-select border-start-0 ps-0'}}) }}
                            </div>
                            {{ form_errors(form.category) }}
                        </div>

                        {# VILLE #}
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-muted">Ville / Quartier</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt text-muted"></i></span>
                                {{ form_widget(form.city, {'attr': {'class': 'form-control border-start-0 ps-0'}}) }}
                            </div>
                            {{ form_errors(form.city) }}
                        </div>

                        {# WHATSAPP #}
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-uppercase text-muted" for="{{ form.phone.vars.id }}">WhatsApp <span class="text-muted fw-normal">(optionnel)</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-whatsapp text-success"></i></span>
                                {{ form_widget(form.phone, {'attr': {'class': 'form-control border-start-0 ps-0', 'placeholder': '+212 6XX XXX XXX'}}) }}
                            </div>
                            <div class="form-text small">Prérempli depuis votre profil si disponible. Les acheteurs pourront vous écrire directement sur WhatsApp (même sans compte).</div>
                            {{ form_errors(form.phone) }}
                        </div>

                        {# DESCRIPTION #}
                        <div class="col-12">
                            <label class="form-label fw-bold small text-uppercase text-muted">Description détaillée</label>
                            {{ form_widget(form.description, {'attr': {'class': 'form-control rounded-3', 'rows': 5, 'placeholder': 'Décrivez votre objet, son état, etc.'}}) }}
                            {{ form_errors(form.description) }}
                        </div>

                        <div class="col-12">
                            <div class="alert alert-light border rounded-4 small mb-0">
                                <i class="bi bi-shield-check me-1 text-brand" aria-hidden="true"></i>
                                Les acheteurs peuvent vous contacter via la <strong>messagerie SoukExpat</strong>
                                {% if form.phone is defined %} et, si vous renseignez un numéro, via <strong>WhatsApp</strong>{% endif %}.
                            </div>
                        </div>

                        {# IMAGES - plusieurs photos #}
                        {% set currentAnnonce = form.vars.data %}
                        {% set existingCount = currentAnnonce and currentAnnonce.id ? currentAnnonce.annonceImages|length : 0 %}
                        <div class="col-12">
                            {% if existingCount > 0 %}
                                <div class="mb-3">
                                    <label class="form-label fw-bold small text-uppercase text-muted">Photos actuelles ({{ existingCount }}/8)</label>
                                    <div class="row g-2">
                                        {% for image in currentAnnonce.annonceImages %}
                                            {% set imgUrl = annonce_image_url(image) %}
                                            <div class="col-6 col-sm-4 col-md-3">
                                                <div class="position-relative border rounded-3 overflow-hidden bg-light" style="aspect-ratio: 1;">
                                                    {% if imgUrl %}
                                                        <img src="{{ imgUrl }}" alt="Photo {{ loop.index }}" class="w-100 h-100" style="object-fit: cover;">
                                                    {% endif %}
                                                    <form method="post"
                                                          action="{{ path('app_annonce_image_delete', { id: currentAnnonce.id, imageId: image.id }) }}"
                                                          class="position-absolute top-0 end-0 m-1"
                                                          onsubmit="return confirm('Supprimer cette photo ?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_image' ~ image.id) }}">
                                                        <button type="submit" class="btn btn-sm btn-danger rounded-circle p-1" title="Supprimer" aria-label="Supprimer la photo">
                                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                            <div class="upload-zone p-4 rounded-4 border-dashed text-center position-relative bg-light">
                                <i class="bi bi-cloud-arrow-up display-5 text-muted mb-2 d-block"></i>
                                <label class="form-label fw-bold mb-1" for="{{ form.images.vars.id }}">
                                    {{ existingCount > 0 ? 'Ajouter d?autres photos' : 'Images de l?annonce' }}
                                </label>
                                <p class="small text-muted mb-3">
                                    Sélectionnez <strong>plusieurs fichiers</strong> à la fois (Ctrl ou Cmd).
                                    {{ existingCount > 0 ? (8 - existingCount) ~ ' place(s) restante(s).' : 'Jusqu?à 8 photos · JPG, PNG, WEBP.' }}
                                </p>
                                {{ form_widget(form.images, {'attr': {
                                    'class': 'form-control form-control-sm',
                                    'accept': 'image/jpeg,image/png,image/webp',
                                    'data-preview-target': 'annonce-image-preview'
                                }}) }}
                                {{ form_errors(form.images) }}
                                {{ form_help(form.images) }}
                                <div id="annonce-image-preview" class="row g-2 mt-3 text-start"></div>
                            </div>
                        </div>

                        {# BOUTON VALIDER #}
                        <div class="col-12 text-center pt-3">
                            <button type="submit" class="btn btn-custom-cyan btn-lg rounded-pill px-5 fw-bold shadow-sm">
                                {{ button_label|default('Publier l\'annonce') }}
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    /* --- Couleur Thème --- */
    .btn-custom-cyan {
        background-color: #42B1CE;
        border-color: #42B1CE;
        color: white;
        transition: all 0.3s ease;
    }
    .btn-custom-cyan:hover {
        background-color: #369ab3;
        border-color: #369ab3;
        color: white;
        transform: translateY(-2px);
    }

    /* --- Form Styling --- */
    .form-control:focus, .form-select:focus {
        border-color: #42B1CE;
        box-shadow: 0 0 0 0.25rem rgba(66, 177, 206, 0.15);
    }

    .input-group-text {
        border: 1px solid #dee2e6;
    }

    .border-dashed {
        border: 2px dashed #dee2e6 !important;
        transition: 0.3s;
    }
    .upload-zone:hover {
        border-color: #42B1CE !important;
        background-color: #f8fdff !important;
    }

    /* --- Responsive --- */
    @media (max-width: 576px) {
        .card-body { padding: 1.5rem !important; }
        .btn-lg { width: 100%; }
    }
</style>
<script>
(function () {
    var input = document.querySelector('[data-preview-target="annonce-image-preview"]');
    var preview = document.getElementById('annonce-image-preview');
    if (!input || !preview) return;
    input.addEventListener('change', function () {
        preview.innerHTML = '';
        var files = Array.prototype.slice.call(input.files || [], 0, 8);
        files.forEach(function (file) {
            if (!file.type || file.type.indexOf('image/') !== 0) return;
            var col = document.createElement('div');
            col.className = 'col-4 col-md-3';
            var img = document.createElement('img');
            img.className = 'img-fluid rounded-3 border';
            img.style.aspectRatio = '1';
            img.style.objectFit = 'cover';
            img.style.width = '100%';
            img.alt = file.name;
            img.src = URL.createObjectURL(file);
            col.appendChild(img);
            preview.appendChild(col);
        });
        if (files.length) {
            var hint = document.createElement('div');
            hint.className = 'col-12 small text-muted';
            hint.textContent = files.length + ' photo(s) selectionnee(s)';
            preview.appendChild(hint);
        }
    });
})();
</script>
