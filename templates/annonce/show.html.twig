{% extends 'base.html.twig' %}

{% block title %}{{ annonce.title }} | Souk Expat{% endblock %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}

<main class="container pt-4 pt-md-5 mt-2 pb-5">
    {{ include('layouts/_page_header.html.twig', {
        eyebrow: annonce.category.name,
        title: annonce.title,
        lead: annonce.city.name ~ ' · ' ~ annonce.price|number_format(0, ',', ' ') ~ ' MAD',
        breadcrumbs: [
            { label: 'Accueil', url: path('app_home') },
            { label: 'Annonces', url: path('app_annonce_index') },
            { label: annonce.title|u.truncate(40, '…') }
        ],
        actions: '<a href="' ~ path('app_annonce_index') ~ '" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Retour</a>'
    }) }}

    <div class="row g-4 g-lg-5">
        {# --- COLONNE GAUCHE : VISUELS --- #}
        <div class="col-12 col-lg-7">
            {% if annonce.annonceImages|length > 0 %}
                <div id="carouselAnnonce" class="carousel slide shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        {% for image in annonce.annonceImages %}
                            <div class="carousel-item {% if loop.first %}active{% endif %}">
                                <img src="{{ asset('uploads/annonces/' ~ image.imadeName) }}" 
                                     class="d-block w-100 mx-auto" 
                                     style="aspect-ratio: 4/3; object-fit: cover; object-position: center center; max-height: 500px;" 
                                     alt="{{ annonce.title }}">
                            </div>
                        {% endfor %}
                    </div>
                    {% if annonce.annonceImages|length > 1 %}
                        <button class="carousel-control-prev" type="button" data-bs-target="#carouselAnnonce" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon p-2 p-md-3 bg-dark bg-opacity-75 rounded-circle" aria-hidden="true"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carouselAnnonce" data-bs-slide="next">
                            <span class="carousel-control-next-icon p-2 p-md-3 bg-dark bg-opacity-75 rounded-circle" aria-hidden="true"></span>
                        </button>
                    {% endif %}
                </div>
            {% else %}
                <div class="rounded-4 bg-light d-flex align-items-center justify-content-center" style="aspect-ratio: 4/3; min-height: 300px;">
                    <i class="bi bi-image text-muted display-1"></i>
                </div>
            {% endif %}
        </div>

        {# --- COLONNE DROITE : INFOS & CONTACT --- #}
        <div class="col-12 col-lg-5">
            <div class="sticky-top-annonce">
                {# Catégorie & Ville #}
                <div class="d-flex gap-2 mb-2">
                    <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(66, 177, 206, 0.1); color: #42B1CE;">
                        {{ annonce.category.name }}
                    </span>
                    <span class="text-muted small d-flex align-items-center">
                        <i class="bi bi-geo-alt me-1"></i> {{ annonce.city.name }}
                    </span>
                </div>

                <h2 class="fw-bold h3 mb-3">{{ annonce.title }}</h2>
                
                <div class="display-6 fw-bold mb-4 price-display" style="color: #42B1CE;">
                    {{ annonce.price|number_format(0, '.', ' ') }} <small class="fs-4 fs-5">MAD</small>
                </div>

                <hr class="my-4 opacity-25">

                <a href="{{ path('app_seller_show', { id: annonce.user.id }) }}" class="d-flex align-items-center gap-3 text-decoration-none text-dark mb-4 p-3 rounded-4 border bg-white seller-show-link">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 overflow-hidden" style="width: 48px; height: 48px; background: rgba(66,177,206,.12);">
                        {% if annonce.user.avatar %}
                            <img src="{{ asset('uploads/avatars/' ~ annonce.user.avatar) }}" alt="" width="48" height="48" style="object-fit: cover;">
                        {% else %}
                            <i class="bi bi-person-fill text-brand fs-4" aria-hidden="true"></i>
                        {% endif %}
                    </div>
                    <div class="min-w-0 flex-grow-1">
                        <div class="small text-muted">Vendeur</div>
                        <div class="fw-bold text-truncate">{{ annonce.user.firstName }} {{ annonce.user.lastName }}</div>
                    </div>
                    <span class="small text-brand fw-semibold flex-shrink-0">Voir le profil <i class="bi bi-chevron-right" aria-hidden="true"></i></span>
                </a>

                <h5 class="fw-bold mb-3">Description</h5>
                <p class="text-secondary lh-lg mb-5">
                    {{ annonce.description }}
                </p>

                {# Contact : messagerie site uniquement (pas de tél. stocké/affiché — apps mobiles) #}
                <div class="d-grid gap-3">
                    {% if app.user and app.user != annonce.user %}
                        <a href="{{ path('app_chat_check', {id: annonce.id}) }}" class="btn btn-custom-cyan btn-lg btn-md rounded-pill fw-bold py-3 py-2 shadow-sm">
                            <i class="bi bi-chat-dots-fill me-2"></i> Envoyer un message
                        </a>
                    {% elseif not app.user %}
                        <a href="{{ path('app_login') }}" class="btn btn-custom-cyan btn-lg btn-md rounded-pill fw-bold py-3 py-2">
                            Connectez-vous pour contacter
                        </a>
                    {% endif %}
                    <p class="small text-muted mb-0 text-center">
                        Contact via la messagerie SoukExpat — aucun numéro n’est publié sur le site.
                    </p>
                </div>

                {# Actions Propriétaire #}
                {% if app.user and app.user.id == annonce.user.id %}
                    <div class="mt-5 p-3 rounded-4 bg-light border d-flex align-items-center justify-content-between gap-2">
                        <span class="small fw-bold text-muted">Gérer mon annonce</span>
                        <div class="d-flex gap-1">
                            <a href="{{ path('app_annonce_edit', {id: annonce.id}) }}" class="btn btn-sm btn-warning btn-icon-action" title="Modifier" aria-label="Modifier">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                            </a>
                            {{ include('annonce/_delete_form.html.twig') }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</main>


<style>
    .btn-custom-cyan {
        background-color: #42B1CE;
        border: none;
        color: white;
        transition: 0.3s;
    }
    .btn-custom-cyan:hover {
        background-color: #369ab3;
        color: white;
        transform: translateY(-3px);
    }
    
    /* Style du carrousel */
    .carousel-control-prev-icon, .carousel-control-next-icon {
        width: 1.5rem;
        height: 1.5rem;
    }

    h1 { color: var(--text-strong); }
    
    .sticky-top-annonce {
        position: sticky;
        top: 100px;
    }
    
    @media (max-width: 991px) {
        .sticky-top-annonce { 
            position: static; 
        }
        .price-display {
            font-size: 2rem;
        }
    }
    
    @media (max-width: 576px) {
        .price-display {
            font-size: 1.75rem;
        }
        .price-display small {
            font-size: 1rem !important;
        }
        .carousel-control-prev-icon, 
        .carousel-control-next-icon {
            width: 1rem;
            height: 1rem;
        }
    }
</style>
{% endblock %}