{% extends 'base.html.twig' %}

{% block title %}Mes Annonces | Expat Souk{% endblock %}

{% block body %}
    {{ include('layouts/navBar.html.twig') }}

    <div class="container pt-4 pt-md-5 mt-2 pb-5">
        {% set actions %}
            <a href="{{ path('app_annonce_new') }}" class="btn btn-custom-cyan rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Nouvelle annonce
            </a>
        {% endset %}
        {{ include('layouts/_page_header.html.twig', {
            eyebrow: 'Espace vendeur',
            title_html: 'Mes <span class="text-brand">annonces</span>',
            lead: 'Gérez vos publications et suivez leur état de validation.',
            breadcrumbs: [
                { label: 'Accueil', url: path('app_home') },
                { label: 'Mes annonces' }
            ],
            actions: actions
        }) }}

        {# Affichage des messages Flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show rounded-4 shadow-sm border-0" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Annonce</th>
                            <th>Statut</th>
                            <th>Prix</th>
                            <th>Date</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for annonce in annonces %}
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        {% if annonce.annonceImages|length > 0 %}
                                            <img src="{{ asset('uploads/annonces/' ~ annonce.annonceImages[0].imadeName) }}" 
                                                 class="rounded-3 me-3 border" style="width: 60px; height: 60px; object-fit: cover;" alt="">
                                        {% else %}
                                            <div class="bg-light rounded-3 me-3 d-flex align-items-center justify-content-center border" style="width: 60px; height: 60px;">
                                                <i class="bi bi-image text-muted"></i>
                                            </div>
                                        {% endif %}
                                        <div>
                                            <div class="fw-bold text-dark">{{ annonce.title|u.truncate(40, '...') }}</div>
                                            <span class="text-muted small">{{ annonce.category.name }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    {% if annonce.status == 'approved' %}
                                        <span class="badge rounded-pill bg-success-subtle text-success px-3 border border-success-subtle">En ligne</span>
                                    {% elseif annonce.status == 'pending' %}
                                        <span class="badge rounded-pill bg-warning-subtle text-warning px-3 border border-warning-subtle">En révision</span>
                                    {% else %}
                                        <span class="badge rounded-pill bg-danger-subtle text-danger px-3 border border-danger-subtle">Refusée</span>
                                    {% endif %}
                                </td>
                                <td class="fw-bold" style="color: #2d3436;">{{ annonce.price }} MAD</td>
                                <td class="text-muted small">{{ annonce.createdAt|date('d/m/Y') }}</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a href="{{ path('app_annonce_show', {id: annonce.id}) }}" class="btn btn-sm btn-outline-secondary btn-icon-action" title="Voir" aria-label="Voir">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>
                                        <a href="{{ path('app_annonce_edit', {id: annonce.id}) }}" class="btn btn-sm btn-outline-cyan btn-icon-action" title="Modifier" aria-label="Modifier">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                        </a>
                                        <form method="post" action="{{ path('app_annonce_delete', {id: annonce.id}) }}"
                                              onsubmit="return confirm('Voulez-vous vraiment supprimer cette annonce ?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ annonce.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger btn-icon-action" title="Supprimer" aria-label="Supprimer">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted italic">
                                    <i class="bi bi-inbox d-block display-4 mb-2 opacity-25"></i>
                                    Vous n'avez pas encore publié d'annonces.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# Pagination #}
        <div class="d-flex justify-content-center mt-4 mb-5">
            {{ knp_pagination_render(annonces) }}
        </div>
    </div>

    <style>
        /* --- Nouveaux Styles de Couleur --- */
        .btn-custom-cyan {
            background-color: #42B1CE;
            border-color: #42B1CE;
            color: white;
            transition: all 0.3s ease;
        }

        .btn-custom-cyan:hover {
            background-color: #369ab3;
            border-color: #369ab3;
            color: white;
            transform: translateY(-2px);
        }

        .btn-outline-cyan {
            color: #42B1CE;
            border-color: #42B1CE;
        }

        .btn-outline-cyan:hover {
            background-color: #42B1CE;
            border-color: #42B1CE;
            color: white;
        }

        /* --- Amélioration Table --- */
        .table thead th {
            color: #636e72;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.7rem;
            letter-spacing: 1px;
            padding: 1.2rem 1rem;
            border-bottom: 2px solid #f1f2f6;
        }

        .btn-action {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px !important;
            margin: 0 2px;
        }

        .bg-success-subtle { background-color: #e6f4ea !important; }
        .bg-warning-subtle { background-color: #fff9e6 !important; }
        .bg-danger-subtle { background-color: #fdeaea !important; }

        /* Style pour la pagination (KNP) */
        .pagination .page-item.active .page-link {
            background-color: #42B1CE;
            border-color: #42B1CE;
        }
        .pagination .page-link {
            color: #42B1CE;
            border-radius: 8px;
            margin: 0 3px;
        }
    </style>
{% endblock %}