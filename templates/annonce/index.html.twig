{% extends 'base.html.twig' %}

{% block title %}
    {% if category is defined %}
        Annonces {{ category.name }} | {{ site ? site.siteName : 'SoukExpat' }}
    {% else %}
        Toutes les annonces | {{ site ? site.siteName : 'SoukExpat' }}
    {% endif %}
{% endblock %}

{% block body %}
    {% set sf = search_filters %}
    {% set reset_url = category is defined ? path('app_annonce_category', { slug: category.slug }) : path('app_annonce_index') %}
    {% set has_filters = sf.q or sf.categoryId or sf.cityId %}

    {{ include('layouts/navBar.html.twig') }}

    <main class="page-annonces">
        <div class="container page-annonces__container">
            {% set actions %}
                <a href="{{ path('app_annonce_new') }}" class="btn btn-custom-cyan rounded-pill px-3 px-md-4 shadow-sm">
                    <i class="bi bi-plus-circle me-1 me-md-2" aria-hidden="true"></i>
                    <span class="d-md-none">Publier</span>
                    <span class="d-none d-md-inline">Déposer une annonce</span>
                </a>
            {% endset %}

            {% if category is defined %}
                {{ include('layouts/_page_header.html.twig', {
                    eyebrow: 'Catégorie',
                    title: category.name,
                    lead: 'Annonces publiées dans cette catégorie · ' ~ (annonces.getTotalItemCount|cap999) ~ ' résultat' ~ (annonces.getTotalItemCount > 1 ? 's' : ''),
                    breadcrumbs: [
                        { label: 'Accueil', url: path('app_home') },
                        { label: 'Annonces', url: path('app_annonce_index') },
                        { label: category.name }
                    ],
                    actions: actions
                }) }}
            {% else %}
                {{ include('layouts/_page_header.html.twig', {
                    eyebrow: has_filters ? 'Recherche' : 'Catalogue',
                    title_html: has_filters
                        ? 'Résultats <span class="text-brand">de recherche</span>'
                        : 'Toutes les <span class="text-brand">annonces</span>',
                    lead: 'Parcourez les annonces validées · ' ~ (annonces.getTotalItemCount|cap999) ~ ' annonce' ~ (annonces.getTotalItemCount > 1 ? 's' : ''),
                    breadcrumbs: [
                        { label: 'Accueil', url: path('app_home') },
                        { label: 'Annonces' }
                    ],
                    actions: actions
                }) }}
            {% endif %}

            {{ include('layouts/_filter_chips.html.twig', {
                sf: sf,
                search_categories: search_categories,
                cities: cities,
                reset_url: reset_url
            }) }}

            <section class="annonce-search-panel mb-3 mb-md-4">
                <div class="annonce-search-panel__inner">
                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                        <div class="min-w-0">
                            <h2 class="h6 mb-1 fw-bold text-dark d-flex align-items-center gap-2 flex-wrap">
                                <i class="bi bi-sliders text-brand-annonces" aria-hidden="true"></i>
                                <span class="d-none d-md-inline">Affiner votre recherche</span>
                                <span class="d-md-none">Filtres</span>
                            </h2>
                            <div class="d-flex align-items-center gap-2 flex-wrap mt-1">
                                <span class="annonce-page-stat">
                                    <i class="bi bi-layout-grid" aria-hidden="true"></i>
                                    <strong>{{ annonces.getTotalItemCount|cap999 }}</strong>
                                    annonce{{ annonces.getTotalItemCount > 1 ? 's' : '' }}
                                </span>
                                <p class="small text-muted mb-0 d-none d-md-block">
                                    {% if category is defined %}
                                        Filtrez par mots-clés ou par ville.
                                    {% else %}
                                        Combinez mots-clés, catégorie et ville.
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            {% if has_filters %}
                                <a href="{{ reset_url }}" class="btn btn-sm btn-outline-secondary rounded-pill">
                                    <i class="bi bi-x-lg me-1" aria-hidden="true"></i>
                                    <span class="d-none d-sm-inline">Réinitialiser</span>
                                    <span class="d-sm-none">Effacer</span>
                                </a>
                            {% endif %}
                            <button class="page-annonces__filter-toggle d-md-none"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#annonceFiltersCollapse"
                                    aria-expanded="{{ has_filters ? 'true' : 'false' }}"
                                    aria-controls="annonceFiltersCollapse">
                                <i class="bi bi-sliders" aria-hidden="true"></i>
                                {% if has_filters %}
                                    <span class="page-annonces__filter-dot" aria-hidden="true"></span>
                                {% endif %}
                            </button>
                        </div>
                    </div>

                    <div id="annonceFiltersCollapse" class="collapse d-md-block {{ has_filters ? 'show' : '' }}">
                        <form method="get" action="{% if category is defined %}{{ path('app_annonce_category', { slug: category.slug }) }}{% else %}{{ path('app_annonce_index') }}{% endif %}" class="row g-2 g-md-3 align-items-end">
                            <div class="col-12 {{ category is defined ? 'col-md-5' : 'col-md-4' }}">
                                <label class="form-label small text-muted mb-1" for="annonce-q">Mots-clés</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 annonce-search-input-icon"><i class="bi bi-search" aria-hidden="true"></i></span>
                                    <input id="annonce-q" type="search" name="q" class="form-control border-start-0 bg-white" placeholder="Titre, description…" value="{{ sf.q|default('') }}" autocomplete="off">
                                </div>
                            </div>
                            {% if category is not defined %}
                                <div class="col-12 col-sm-6 col-md-3">
                                    <label class="form-label small text-muted mb-1" for="annonce-cat">Catégorie</label>
                                    <select id="annonce-cat" name="category" class="form-select bg-white border js-searchable-select" data-placeholder="Rechercher une catégorie…">
                                        <option value="">Toutes les catégories</option>
                                        {% for cat in search_categories %}
                                            <option value="{{ cat.id }}" {{ sf.categoryId == cat.id ? 'selected' }}>{{ cat.name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endif %}
                            <div class="col-12 {{ category is defined ? 'col-sm-6 col-md-4' : 'col-sm-6 col-md-3' }}">
                                <label class="form-label small text-muted mb-1" for="annonce-city">Ville</label>
                                <select id="annonce-city" name="city" class="form-select bg-white border js-searchable-select" data-placeholder="Rechercher une ville…">
                                    <option value="">Toutes les villes</option>
                                    {% for city in cities %}
                                        <option value="{{ city.id }}" {{ sf.cityId == city.id ? 'selected' }}>{{ city.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-12 {{ category is defined ? 'col-md-3' : 'col-md-2' }}">
                                <button type="submit" class="btn btn-annonces-brand w-100 rounded-pill py-2 fw-bold shadow-sm">
                                    <i class="bi bi-search me-1" aria-hidden="true"></i>Rechercher
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </section>

            <div class="row g-2 g-sm-3 g-lg-4 page-annonces__grid">
                {% for annonce in annonces %}
                    <div class="col-6 col-md-4 col-xl-3">
                        {{ include('annonce/_card.html.twig', {
                            annonce: annonce,
                            show_category: category is not defined,
                            eager: loop.index <= 4
                        }) }}
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="annonce-empty-state text-center py-5 px-3 px-md-4">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white shadow-sm mb-3" style="width: 4.5rem; height: 4.5rem;">
                                <i class="bi bi-inboxes fs-2 text-brand-annonces opacity-75" aria-hidden="true"></i>
                            </div>
                            <h2 class="h4 fw-bold mb-2">
                                {% if has_filters %}Aucun résultat{% else %}Aucune annonce pour le moment{% endif %}
                            </h2>
                            <p class="text-muted mx-auto mb-4" style="max-width: 26rem;">
                                {% if has_filters %}
                                    Essayez d’élargir la recherche ou <a href="{{ reset_url }}" class="text-brand-annonces fw-semibold text-decoration-none">réinitialisez les filtres</a>.
                                {% elseif category is defined %}
                                    Soyez le premier à publier dans cette catégorie.
                                {% else %}
                                    Soyez le premier à publier une annonce sur SoukExpat.
                                {% endif %}
                            </p>
                            <a href="{{ path('app_annonce_new') }}" class="btn btn-custom-cyan rounded-pill px-4 shadow-sm">
                                <i class="bi bi-plus-circle me-2" aria-hidden="true"></i>Publier une annonce
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% if annonces|length > 0 %}
                <nav class="page-annonces__pagination" aria-label="Pagination des annonces">
                    <div class="pagination-wrapper">
                        {{ knp_pagination_render(annonces) }}
                    </div>
                </nav>
            {% endif %}
        </div>
    </main>

    {{ include('layouts/footer.html.twig') }}
{% endblock %}
