{# Carte annonce partagée — options: show_category, show_seller, eager #}
{% set show_category = show_category|default(true) %}
{% set show_seller = show_seller|default(true) %}
{% set eager = eager|default(false) %}
<article class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative annonce-card annonce-listing-card d-flex flex-column">
    <div class="annonce-listing-card__media">
        {% if annonce.annonceImages|length > 0 %}
            <img src="{{ annonce_image_url(annonce.annonceImages[0]) }}"
                 class="annonce-listing-card__img"
                 alt="{{ annonce.title }}"
                 {% if not eager %}loading="lazy"{% endif %}
                 decoding="async">
        {% else %}
            <div class="annonce-listing-card__placeholder" role="img" aria-label="Pas d’image">
                <i class="bi bi-image" aria-hidden="true"></i>
            </div>
        {% endif %}

        {% if show_category and annonce.category %}
            <span class="annonce-listing-card__chip-cat">{{ annonce.category.name }}</span>
        {% endif %}

        <div class="annonce-listing-card__overlay">
            <span class="annonce-listing-card__price">{{ annonce.price|number_format(0, ',', ' ') }} <small>MAD</small></span>
        </div>
    </div>

    <div class="card-body p-3 d-flex flex-column flex-grow-1">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
            <span class="badge rounded-pill bg-light text-dark border fw-semibold py-1 px-2 small text-truncate" style="max-width: 58%;">
                <i class="bi bi-geo-alt-fill me-1 text-brand" aria-hidden="true"></i>{{ annonce.city.name }}
            </span>
            <time class="text-muted small text-nowrap" datetime="{{ annonce.createdAt|date('c') }}">{{ annonce.createdAt|date('d/m/Y') }}</time>
        </div>

        <h2 class="card-title fw-bold h6 mb-2 lh-sm">
            <a href="{{ path('app_annonce_show', { id: annonce.id }) }}" class="text-dark text-decoration-none stretched-link">
                {{ annonce.title|u.truncate(48, '…') }}
            </a>
        </h2>

        <p class="card-text text-muted small mb-3 flex-grow-1 annonce-listing-card__desc">
            {{ annonce.description|striptags|u.truncate(100, '…') }}
        </p>

        {% if show_seller and annonce.user %}
            {% set card_wa = annonce.phone|default('') %}
            {% if card_wa is empty and annonce.user.whatsappPhone %}
                {% set card_wa = annonce.user.whatsappPhone %}
            {% endif %}
            {% set card_wa_href = card_wa ? (card_wa|whatsapp_url('Bonjour, je suis intéressé(e) par « ' ~ annonce.title ~ ' » sur SoukExpat.')) : '#' %}
            <div class="annonce-listing-card__seller">
                <a href="{{ path('app_seller_show', { id: annonce.user.id }) }}"
                   class="d-flex align-items-center gap-2 text-decoration-none seller-card-link min-w-0"
                   title="Voir le profil de {{ annonce.user.firstName }}">
                    <div class="annonce-listing-card__avatar flex-shrink-0 overflow-hidden">
                        {% if annonce.user.avatar %}
                            <img src="{{ asset('uploads/avatars/' ~ annonce.user.avatar) }}"
                                 alt=""
                                 width="32" height="32"
                                 loading="lazy"
                                 decoding="async">
                        {% else %}
                            <i class="bi bi-person-fill text-brand small" aria-hidden="true"></i>
                        {% endif %}
                    </div>
                    <span class="small text-truncate">
                        <span class="text-muted">Publié par</span>
                        <span class="fw-semibold">{{ annonce.user.firstName }}</span>
                    </span>
                </a>
                {% if card_wa and card_wa_href != '#' and (not app.user or app.user.id != annonce.user.id) %}
                    <a href="{{ card_wa_href }}"
                       class="annonce-listing-card__wa d-inline-flex align-items-center gap-1 text-decoration-none"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="WhatsApp"
                       aria-label="Contacter {{ annonce.user.firstName }} sur WhatsApp"
                       data-require-safety-ack="1"
                       data-safety-context="annonce">
                        <i class="bi bi-whatsapp" aria-hidden="true"></i>
                        <span class="d-none d-md-inline small text-success">WhatsApp</span>
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>
</article>
