{% extends 'base.html.twig' %}

{% block title %}Modifier mon annonce | Souk Expat{% endblock %}

{% block body %}
{{ include('layouts/navBar.html.twig') }}

<main class="container pt-4 pt-md-5 mt-2 pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            {{ include('layouts/_page_header.html.twig', {
                eyebrow: 'Modification',
                title_html: 'Modifier l’<span class="text-brand">annonce</span>',
                lead: 'Mettez à jour vos informations en quelques clics.',
                breadcrumbs: [
                    { label: 'Accueil', url: path('app_home') },
                    { label: 'Mes annonces', url: path('app_mes_annonces') },
                    { label: 'Modifier' }
                ],
                actions: '<a href="' ~ path('app_mes_annonces') ~ '" class="btn btn-outline-secondary rounded-pill px-3"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i> Retour</a>'
            }) }}

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    {{ include('annonce/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
                </div>

                <div class="card-footer bg-light-subtle p-4 border-top">
                    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
                        <div class="text-center text-md-start">
                            <h6 class="fw-bold text-danger mb-1">Zone de danger</h6>
                            <p class="text-muted small mb-0">La suppression est définitive et retirera l'annonce du Souk.</p>
                        </div>
                        <div class="ms-md-auto">
                            {{ include('annonce/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    .btn-custom-cyan {
        background-color: #42B1CE !important;
        border: none !important;
        padding: 12px 35px !important;
    }
    .bg-light-subtle { background-color: #fefefe; }
    .card-footer form button {
        border-radius: 50px !important;
        padding: 8px 20px !important;
        font-weight: 600;
        font-size: 0.85rem;
    }
</style>

{{ include('layouts/footer.html.twig') }}
{% endblock %}
