{% extends 'admin/base_admin.html.twig' %}

{% block title %}Utilisateurs | SoukExpat{% endblock %}
{% block admin_mobile_title %}Utilisateurs{% endblock %}

{% block admin_main %}
    {{ include('admin/_page_header.html.twig', {
        eyebrow: 'Gestion',
        title: 'Utilisateurs',
        lead: 'Comptes enregistrés sur la plateforme.',
        actions: '<span class="admin-badge">' ~ (userCount|cap999) ~ ' compte' ~ (userCount > 1 ? 's' : '') ~ '</span>'
    }) }}

    <div class="admin-panel">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-3 py-3 border-0">Utilisateur</th>
                        <th class="py-3 border-0 d-none d-md-table-cell">Email</th>
                        <th class="py-3 border-0 d-none d-lg-table-cell">Rôles</th>
                        <th class="pe-3 py-3 border-0 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                        <tr>
                            <td class="ps-3">
                                <div class="fw-bold text-dark">{{ u.firstName }} {{ u.lastName }}</div>
                                <div class="text-muted small">#{{ u.id }}</div>
                                <div class="text-muted small d-md-none text-truncate" style="max-width: 220px;">{{ u.email }}</div>
                            </td>
                            <td class="text-muted d-none d-md-table-cell">{{ u.email }}</td>
                            <td class="d-none d-lg-table-cell">
                                {% for role in u.roles %}
                                    <span class="badge rounded-pill fw-normal px-2 py-1 {{ role == 'ROLE_ADMIN' ? 'bg-danger-subtle text-danger' : (role == 'ROLE_EDITOR' ? 'bg-info-subtle text-info' : 'bg-secondary-subtle text-secondary') }}" style="font-size: 0.7rem;">
                                        {{ role|replace({'ROLE_': ''}) }}
                                    </span>
                                {% endfor %}
                            </td>
                            <td class="pe-3 text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light border btn-icon-action" type="button" data-bs-toggle="dropdown" data-bs-display="static" title="Actions" aria-label="Actions">
                                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
                                        {{ include('admin/_user_dropdown_actions.html.twig', { user: u }) }}
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-center text-muted py-5">Aucun utilisateur.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
