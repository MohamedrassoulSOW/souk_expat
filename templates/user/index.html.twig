{% extends 'base.html.twig' %}

{% block title %}Utilisateurs | Administration{% endblock %}

{% block body %}
<div class="container-fluid py-4 px-3 px-md-4 bg-light min-vh-100">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Utilisateurs</h1>
            <p class="text-muted small mb-0">{{ userCount }} compte(s) enregistré(s)</p>
        </div>
        <a href="{{ path('app_dashboard') }}" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-speedometer2 me-2"></i>Tableau de bord
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-4 py-3">Utilisateur</th>
                        <th class="py-3 d-none d-md-table-cell">Email</th>
                        <th class="py-3 d-none d-lg-table-cell">Rôles</th>
                        <th class="text-end pe-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-dark">{{ u.firstName }} {{ u.lastName }}</div>
                            <div class="text-muted small">#{{ u.id }}</div>
                            <div class="text-muted small d-md-none text-truncate" style="max-width: 220px;">{{ u.email }}</div>
                        </td>
                        <td class="text-muted d-none d-md-table-cell">{{ u.email }}</td>
                        <td class="d-none d-lg-table-cell">
                            {% for role in u.roles %}
                                <span class="badge rounded-pill text-secondary" style="font-size: 0.7rem;{{ role == 'ROLE_ADMIN' ? ' background: #f8d7da; color: #721c24;' : (role == 'ROLE_EDITOR' ? ' background: #cff4fc; color: #055160; border: 1px solid #0d948850;' : ' background: #e2e3e5; color: #383d41;') }}">
                                    {{ role|replace({'ROLE_': ''}) }}
                                </span>
                            {% endfor %}
                        </td>
                        <td class="text-end pe-4">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-display="static" aria-label="Actions">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
                                    <li>
                                        <a class="dropdown-item rounded-2" href="{{ path('admin_user_toggle', {id: u.id}) }}">
                                            {% if u.isBlocked %}
                                                <i class="bi bi-unlock me-2 text-success"></i>Débloquer
                                            {% else %}
                                                <i class="bi bi-slash-circle me-2 text-danger"></i>Bloquer
                                            {% endif %}
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider opacity-50"></li>
                                    <li>
                                        <a class="dropdown-item rounded-2" href="{{ path('admin_user_editor', {id: u.id}) }}">
                                            {% if 'ROLE_ADMIN' in u.roles %}
                                                <i class="bi bi-person-x me-2"></i>Retirer admin
                                            {% else %}
                                                <i class="bi bi-person-check me-2"></i>Nommer admin
                                            {% endif %}
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider opacity-50"></li>
                                    <li>
                                        <a class="dropdown-item rounded-2" href="{{ path('admin_user_toggle_editor', {id: u.id}) }}">
                                            {% if 'ROLE_EDITOR' in u.roles %}
                                                <i class="bi bi-journal-minus me-2 text-warning"></i> Retirer le rôle éditeur
                                            {% else %}
                                                <i class="bi bi-journal-check me-2" style="color: #0d9488;"></i> Donner le rôle éditeur
                                            {% endif %}
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider opacity-50"></li>
                                    <li>
                                        <a class="dropdown-item text-danger rounded-2" href="{{ path('admin_user_delete', {id: u.id}) }}" onclick="return confirm('Supprimer cet utilisateur ?');">
                                            <i class="bi bi-trash me-2"></i>Supprimer
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">Aucun utilisateur.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
