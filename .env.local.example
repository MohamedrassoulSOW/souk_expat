### LOCAL (développement) — copier vers .env.local
# DEFAULT_URI=http://127.0.0.1:8001
# En APP_ENV=dev, les e-mails sont écrits dans var/mail/ (pas de SMTP requis).
# Voir le dernier : php bin/console app:mailer:show-inbox
# Test : php bin/console app:mailer:smoke-test votre@email.com

### PRODUCTION — copier vers .env.local sur le serveur (ne pas committer .env.local rempli)

APP_ENV=prod
APP_DEBUG=0

# Générer : php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# MySQL / MariaDB Hostinger (souvent 127.0.0.1)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/NOM_BASE?serverVersion=10.11.0-MariaDB&charset=utf8mb4"

# Sans slash final
DEFAULT_URI=https://soukexpat.com

# SMTP Hostinger — compte contact@soukexpat.com (From forcé dans le code)
# MAILER_DSN="smtp://contact%40soukexpat.com:MOT_DE_PASSE@smtp.hostinger.com:465?encryption=ssl&auth_mode=login"
MAILER_DSN=

# Clé JWT distincte de APP_SECRET
JWT_SECRET=
JWT_TTL=2592000
JWT_ISSUER=soukexpat-api

# Origines CORS supplémentaires (apps web). Vide = DEFAULT_URI + même hôte uniquement.
# CORS_ALLOW_ORIGINS=

# Mercure (optionnel sur mutualisé)
MERCURE_URL=https://soukexpat.com/.well-known/mercure
MERCURE_PUBLIC_URL=https://soukexpat.com/.well-known/mercure
MERCURE_JWT_SECRET=

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
APP_SHARE_DIR=var/share

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Si cookies / HTTPS incorrects derrière proxy :
# TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
# TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-port,x-forwarded-proto,x-forwarded-prefix

# Cron (à configurer sur Hostinger) :
# 15 3 * * * cd /chemin/vers/projet && php bin/console app:messages:purge-expired --env=prod
