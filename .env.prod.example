### PRODUCTION — copier vers .env.local sur le serveur
### NE PAS committer ce fichier rempli avec de vrais secrets

APP_ENV=prod
APP_DEBUG=0

# Obligatoire — générer sur le serveur :
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# Base MySQL / MariaDB Hostinger (souvent localhost)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/NOM_BASE?serverVersion=10.11.0-MariaDB&charset=utf8mb4"

# URL publique (sans slash final)
DEFAULT_URI=https://soukexpat.com

# SMTP Hostinger — compte contact@soukexpat.com (From forcé dans le code)
# MAILER_DSN="smtp://contact%40soukexpat.com:MOT_DE_PASSE@smtp.hostinger.com:465?encryption=ssl&auth_mode=login"
MAILER_DSN=

# JWT API mobile (obligatoire en prod : clé distincte de APP_SECRET)
JWT_SECRET=
JWT_TTL=2592000
JWT_ISSUER=soukexpat-api

# Origines CORS supplémentaires (séparées par des virgules). Vide = uniquement DEFAULT_URI + même hôte.
# CORS_ALLOW_ORIGINS=https://app.soukexpat.com

# Mercure (chat live). Sans hub : valeurs factices stables OK
MERCURE_URL=https://soukexpat.com/.well-known/mercure
MERCURE_PUBLIC_URL=https://soukexpat.com/.well-known/mercure
MERCURE_JWT_SECRET=ChangeMeMercureProductionSecretKey32chars

# E-mails synchrones (pas de worker Messenger)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

APP_SHARE_DIR=var/share

# Hostinger / Cloudflare (si cookies / HTTPS incorrects, décommenter) :
# TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
# TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-port,x-forwarded-proto,x-forwarded-prefix
