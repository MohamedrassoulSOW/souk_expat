# =============================================================================
# PRODUCTION — copier vers .env.local sur le serveur (NE PAS committer les secrets)
# ou définir ces variables dans le panneau d’hébergement.
# =============================================================================

APP_ENV=prod
APP_DEBUG=0

# Obligatoire : secret unique
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# Base MySQL/MariaDB de production
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/NOM_BASE?serverVersion=8.0.32&charset=utf8mb4"

# URL publique (sans slash final) — e-mails, liens absolus, API
DEFAULT_URI=https://soukexpat.com

# SMTP réel (pas Mailtrap)
# MAILER_DSN="smtp://user:pass@smtp.votre-hebergeur.com:465?encryption=ssl&auth_mode=login"
# MAILER_DSN="smtp://user:pass@smtp.votre-hebergeur.com:587?encryption=tls&auth_mode=login"
MAILER_DSN=

# JWT API mobile (recommandé : clé distincte de APP_SECRET)
# JWT_SECRET=
JWT_TTL=2592000
JWT_ISSUER=soukexpat-api

# Mercure (chat temps réel). Sans hub : laissez des valeurs factices stables.
# Le site fonctionne ; le chat live peut être indisponible.
MERCURE_URL=https://soukexpat.com/.well-known/mercure
MERCURE_PUBLIC_URL=https://soukexpat.com/.well-known/mercure
MERCURE_JWT_SECRET=ChangeMeMercureProductionSecretKey32

# Messenger (e-mails synchrones — pas de worker requis)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

APP_SHARE_DIR=var/share

# Derrière Cloudflare / nginx reverse proxy (décommenter si besoin)
# TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
# TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-port,x-forwarded-proto
