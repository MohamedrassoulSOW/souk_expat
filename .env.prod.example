# Exemple pour mise en production — copier les valeurs sur votre hébergement
# (variables d’environnement ou fichier .env.local non versionné).
#
# APP_ENV / APP_DEBUG sont souvent fixés par la plateforme ; sinon :
APP_ENV=prod
APP_DEBUG=0
#
# Obligatoire : secret unique (ex. openssl rand -hex 32)
APP_SECRET=
#
# Base de données MySQL/MariaDB de production
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/NOM_BASE?serverVersion=8.0.32&charset=utf8mb4"
#
# URL publique du site (e-mails, CLI, liens absolus) — sans slash final
DEFAULT_URI=https://soukexpat.com
#
# SMTP réel (remplacer Mailtrap). Exemples :
# MAILER_DSN="smtp://user:pass@smtp.votre-hebergeur.com:465?encryption=ssl&auth_mode=login"
# MAILER_DSN="native://default"
MAILER_DSN=
#
# Mercure : URL interne (PHP publie) et URL publique (navigateur / SSE).
# Exemples si hub sur le même domaine (adapter chemin ou sous-domaine) :
# MERCURE_URL=https://soukexpat.com/.well-known/mercure
# MERCURE_PUBLIC_URL=https://soukexpat.com/.well-known/mercure
MERCURE_URL=
MERCURE_PUBLIC_URL=
MERCURE_JWT_SECRET=
#
# Files / partage (si utilisé)
APP_SHARE_DIR=var/share
#
# Messagerie asynchrone (Doctrine OK si pas de Redis)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
#
# Derrière reverse proxy (nginx, Cloudflare) : IPs du proxy, séparées par des virgules.
# Exemple derrière nginx local : 127.0.0.1
# TRUSTED_PROXIES=127.0.0.1
