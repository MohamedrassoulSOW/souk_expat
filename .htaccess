# Hostinger / mutualisé : document root = racine du projet (pas public/).
# Idéal : dans hPanel → Domaines → Racine du document = …/public

DirectoryIndex public/index.php index.php

# Bloquer l’accès direct aux fichiers sensibles si le docroot n’est pas public/
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)^\.(env|env\..*|git|gitignore|htaccess)">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # CSS/JS publics (Bootstrap, Icons, Tom Select) — AVANT le blocage de vendor/
    # Sinon /vendor/bootstrap/... est en 403 et le site s’affiche sans style.
    RewriteRule ^vendor/(bootstrap|bootstrap-icons|tom-select)/(.*)$ public/vendor/$1/$2 [L]

    # Secrets / code source (vendor Composer, pas public/vendor)
    RewriteRule ^(config|src|var|vendor|bin|migrations|templates|composer\.(json|lock)|symfony\.lock|\.env)(/|$) - [F,L]

    # Déjà dans /public → ne pas réécrire
    RewriteRule ^public/ - [L]

    # Front controller + assets → dossier public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
