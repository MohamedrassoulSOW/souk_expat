### PRODUCTION — à installer sur le serveur (pas via upload direct de .env)
### 1. Remplir les valeurs ci-dessous
### 2. Uploader CE fichier (deploy/env.prod.template) — le nom sans point initial passe sur Hostinger
### 3. Sur le serveur : php bin/install-env-local.php
###    → crée .env.local à la racine du projet

APP_ENV=prod
APP_DEBUG=0

# Générer sur le serveur :
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=

# MySQL / MariaDB Hostinger (souvent 127.0.0.1)
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/NOM_BASE?serverVersion=10.11.0-MariaDB&charset=utf8mb4"

# Sans slash final
DEFAULT_URI=https://soukexpat.com

# SMTP Hostinger (pas Mailtrap)
# MAILER_DSN="smtp://user:pass@smtp.hostinger.com:465?encryption=ssl&auth_mode=login"
MAILER_DSN=

# Clé JWT distincte de APP_SECRET
JWT_SECRET=
JWT_TTL=2592000
JWT_ISSUER=soukexpat-api

# Mercure (optionnel sur mutualisé)
MERCURE_URL=https://soukexpat.com/.well-known/mercure
MERCURE_PUBLIC_URL=https://soukexpat.com/.well-known/mercure
MERCURE_JWT_SECRET=ChangeMeMercureProductionSecretKey32chars

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
APP_SHARE_DIR=var/share

# Si cookies / HTTPS incorrects derrière proxy :
# TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
# TRUSTED_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-port,x-forwarded-proto,x-forwarded-prefix
